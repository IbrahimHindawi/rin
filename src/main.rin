import "std/memops.rin"
import "std/array.rin"
import "std/node.rin"
import "std/list.rin"
import "std/print.rin"

payload: struct = {
    x: f32;
    y: *u8;
}

main: proc(argc: i32, argv: *[*]char)-> i32 = {
    printf("Hello, World!\n");

    num: i32 = 0;
    printfmt("num = {}\n", num);

    // array: *[]i32 = {};

    arena: memops_arena = {};
    memops_arena_initialize(arena&);

    p: payload = {};
    name: [*]const char = payload<>.name;
    printfmt("name {}\n", name);
    for (i: i32 = 0; i < payload<>.count; i += 1) {
        printfmt("field[{}] = {}\n", i, payload<>.variant.fields[i].name);
    }

    len: u64 = 16;
    temp: memops_arena_temp = memops_arena_temp_begin(arena&);
    payloads: array<payload> = array<payload>reserve(temp.arena, 128);
    for (i: i32 = 0; i < 128; i += 1) {
        payloads.data[i] = { .x = i };
    }
    memops_arena_temp_end(temp);

    numbers: array<i32> = array<i32>reserve(arena&, len);
    for (i: u64 = 0; i < len; i += 1) { 
        numbers.data[i] = cast(i, i32); 
    }
    for (i: u64 = 0; i < len; i += 1 ) {
        printfmt("i = {}, ", numbers.data[i]); 
    }

    numberchain: *list<payload> = list<payload>create(arena&);
    list<payload>append(arena&, numberchain, { .x = 3.16 });
    list<payload>append(arena&, numberchain, { .x = 8.6 });
    list<payload>append(arena&, numberchain, {});

    node: *node<payload> = numberchain[0].head;
    for (i: u64 = 0; i < numberchain[0].length; i += 1) {
        printf("%f", node[0].data.x);
        node = node[0].next;
    }

    return 0;
}
