import "string8.rin"

/* Operations on NUL-terminated byte strings, written in rin.

   These exist so a project can drop `string.h` without first converting every
   `*c8` it holds into a string8slice. The conversion is the better end state --
   see docs/strings-and-slices.md -- but it touches every signature, and this
   lets the C library go first.

   Two differences from the functions they replace, both deliberate:

     * `cstr_copy` always terminates. `strncpy` does not when the source fills
       the buffer exactly, which is its most-reported defect.
     * The comparisons return a b32 saying "equal", not an ordering. Every call
       site in njinn tested `strcmp(...) == 0`; the ordering was never used, and
       returning it invites `if (cstr_cmp(a, b))` meaning the opposite of what
       it reads like. `cstr_order` is there for the rare real sort.

   What safe code can reach here is checked: it reads a string through cstr_view,
   in slicecore.rin, which is the one place a C string is measured. */

cstr_length: proc(s: ^const c8) -> u64 = {
    return cstr_view(s).length;
}

/* A char array as a C string, for safe code to hand to C. The terminator is
   looked for inside the array, so the callee cannot read past it; no terminator
   is a checked stop, as an index out of bounds is. The result is a borrow of
   the array. */
cstr_of: proc(chars: []const c8) -> ^const c8 = {
    for (i: u64 = 0; i < chars.length; i += 1) {
        if (chars[i] == 0) {
            unsafe { return chars.data; }
        }
    }
    unsafe {
        printf("rin runtime: a C string with no terminator in its %llu chars\n", cast(chars.length, u64));
        exit(1);
    }
    return null;
}

cstr_is_empty: proc(s: ^const c8) -> b32 = {
    return cstr_view(s).length == 0;
}

/* The char at i, and past the end the terminator a C string has there. */
cstr_at_: proc[static](s: []const c8, i: u64) -> c8 = {
    if (i < s.length) {
        return s[i];
    }
    return 0;
}

cstr_equals: proc(a: ^const c8, b: ^const c8) -> b32 = {
    if (a == null || b == null) {
        return a == b;
    }
    x: []const c8 = cstr_view(a);
    y: []const c8 = cstr_view(b);
    if (x.length != y.length) {
        return 0;
    }
    for (i: u64 = 0; i < x.length; i += 1) {
        if (x[i] != y[i]) {
            return 0;
        }
    }
    return 1;
}

cstr_equals_n: proc(a: ^const c8, b: ^const c8, count: u64) -> b32 = {
    if (a == null || b == null) {
        return a == b;
    }
    x: []const c8 = cstr_view(a);
    y: []const c8 = cstr_view(b);
    for (i: u64 = 0; i < count; i += 1) {
        c: c8 = cstr_at_(x, i);
        if (c != cstr_at_(y, i)) {
            return 0;
        }
        if (c == 0) {
            return 1;
        }
    }
    return 1;
}

/* Negative, zero or positive like strcmp, for the cases that genuinely order. */
cstr_order: proc(a: ^const c8, b: ^const c8) -> i32 = {
    if (a == null || b == null) {
        if (a == b) { return 0; }
        if (a == null) { return -1; }
        return 1;
    }
    x: []const c8 = cstr_view(a);
    y: []const c8 = cstr_view(b);
    i: u64 = 0;
    while (cstr_at_(x, i) != 0 && cstr_at_(x, i) == cstr_at_(y, i)) {
        i += 1;
    }
    return cast(cast(cstr_at_(x, i), u8), i32) - cast(cast(cstr_at_(y, i), u8), i32);
}

/* Copies at most dst.length-1 bytes and always terminates. Returns the length
   written, so a caller can tell truncation happened by comparing it against
   cstr_length(src). */
cstr_copy: proc(dst: []c8, src: ^const c8) -> u64 = {
    if (dst.data == null || dst.length == 0) {
        return 0;
    }
    from: []const c8 = cstr_view(src);
    n: u64 = 0;
    while (n < from.length && n + 1 < dst.length) {
        dst[n] = from[n];
        n += 1;
    }
    dst[n] = 0;
    return n;
}

cstr_append: proc(dst: []c8, src: ^const c8) -> u64 = {
    if (dst.data == null || dst.length == 0) {
        return 0;
    }
    // Not cstr_length: nothing says this array is terminated.
    used: u64 = 0;
    while (used < dst.length && dst[used] != 0) { used += 1; }
    if (used + 1 >= dst.length) {
        return used;
    }
    return used + cstr_copy(dst[used..dst.length], src);
}

/* Index of the first occurrence, or -1. strchr/strstr returned pointers, which
   forced null checks that read as "found"; an index says what it means. */
cstr_find_char: proc(s: ^const c8, c: c8) -> i64 = {
    if (s == null) {
        return -1;
    }
    text: []const c8 = cstr_view(s);
    for (i: u64 = 0; i < text.length; i += 1) {
        if (text[i] == c) {
            return cast(i, i64);
        }
    }
    if (c == 0) {
        return cast(text.length, i64);
    }
    return -1;
}

cstr_find: proc(haystack: ^const c8, needle: ^const c8) -> i64 = {
    if (haystack == null || needle == null) {
        return -1;
    }
    hay: []const c8 = cstr_view(haystack);
    want: []const c8 = cstr_view(needle);
    if (want.length == 0) {
        return 0;
    }
    if (want.length > hay.length) {
        return -1;
    }
    last: u64 = hay.length - want.length;
    for (i: u64 = 0; i <= last; i += 1) {
        j: u64 = 0;
        while (j < want.length && hay[i + j] == want[j]) {
            j += 1;
        }
        if (j == want.length) {
            return cast(i, i64);
        }
    }
    return -1;
}

cstr_starts_with: proc(s: ^const c8, prefix: ^const c8) -> b32 = {
    return cstr_equals_n(s, prefix, cstr_length(prefix));
}

cstr_ends_with: proc(s: ^const c8, suffix: ^const c8) -> b32 = {
    if (s == null || suffix == null) {
        return 0;
    }
    text: []const c8 = cstr_view(s);
    tail: []const c8 = cstr_view(suffix);
    if (tail.length > text.length) {
        return 0;
    }
    from: u64 = text.length - tail.length;
    for (i: u64 = 0; i < tail.length; i += 1) {
        if (text[from + i] != tail[i]) {
            return 0;
        }
    }
    return 1;
}

cstr_slice: proc[unsafe](s: ^const c8) -> string8slice = {
    out: string8slice = {};
    if (s == null) {
        return out;
    }
    out.data = cast(s, *u8);
    out.length = cstr_length(s);
    return out;
}

/* Parsing, replacing the sscanf calls. Each reports success separately rather
   than folding failure into a sentinel value, because 0 is a legitimate
   result and sscanf's return count was being ignored at every call site. */
cstr_parse_i64: proc(s: ^const c8, out: *i64) -> b32 = {
    if (s == null || out == null) {
        return 0;
    }
    text: []const c8 = cstr_view(s);
    i: u64 = 0;
    while (cstr_at_(text, i) == cast(32, c8) || cstr_at_(text, i) == cast(9, c8)) {
        i += 1;
    }
    negative: b32 = 0;
    if (cstr_at_(text, i) == cast(45, c8)) {
        negative = 1;
        i += 1;
    } else if (cstr_at_(text, i) == cast(43, c8)) {
        i += 1;
    }
    digits: u64 = 0;
    value: u64 = 0;
    /* The most an i64 can hold, one more when negative. Past it the number has no answer. */
    limit: u64 = 9223372036854775807;
    if (negative != 0) {
        limit += 1;
    }
    while (cstr_at_(text, i) >= cast(48, c8) && cstr_at_(text, i) <= cast(57, c8)) {
        digit: u64 = cast(cast(cstr_at_(text, i), u8) - 48, u64);
        if (value > (limit - digit) / 10) {
            return 0;
        }
        value = value * 10 + digit;
        digits += 1;
        i += 1;
    }
    if (digits == 0) {
        return 0;
    }
    if (negative != 0) {
        out* = cast(cast(0, u64) - value, i64);
    } else {
        out* = cast(value, i64);
    }
    return 1;
}

cstr_parse_f64: proc(s: ^const c8, out: *f64) -> b32 = {
    if (s == null || out == null) {
        return 0;
    }
    text: []const c8 = cstr_view(s);
    i: u64 = 0;
    while (cstr_at_(text, i) == cast(32, c8) || cstr_at_(text, i) == cast(9, c8)) {
        i += 1;
    }
    negative: b32 = 0;
    if (cstr_at_(text, i) == cast(45, c8)) {
        negative = 1;
        i += 1;
    } else if (cstr_at_(text, i) == cast(43, c8)) {
        i += 1;
    }
    digits: u64 = 0;
    whole: f64 = 0.0;
    while (cstr_at_(text, i) >= cast(48, c8) && cstr_at_(text, i) <= cast(57, c8)) {
        whole = whole * 10.0 + cast(cast(cast(cstr_at_(text, i), u8) - 48, u64), f64);
        digits += 1;
        i += 1;
    }
    if (cstr_at_(text, i) == cast(46, c8)) {
        i += 1;
        place: f64 = 0.1;
        while (cstr_at_(text, i) >= cast(48, c8) && cstr_at_(text, i) <= cast(57, c8)) {
            whole += place * cast(cast(cast(cstr_at_(text, i), u8) - 48, u64), f64);
            place *= 0.1;
            digits += 1;
            i += 1;
        }
    }
    if (digits == 0) {
        return 0;
    }
    if (negative != 0) {
        whole = -whole;
    }
    out* = whole;
    return 1;
}

/* strtok without the static state.

   strtok remembers its position in a hidden global, so two interleaved token
   runs corrupt each other and it can never be called from two threads. This
   takes the cursor as a parameter instead: the caller owns it, and two runs
   over different buffers are independent.

   Like strtok it writes a terminator into the buffer, so the input must be
   mutable. An empty `delims` returns the whole remainder, which is how the
   callers get "the rest of the line". */
cstr_token: proc[unsafe](s: ^c8, cursor: *u64, delims: ^const c8) -> ^c8 = {
    if (s == null || cursor == null) {
        return null;
    }
    i: u64 = cursor*;
    if (delims == null || delims[0] == 0) {
        if (s[i] == 0) {
            return null;
        }
        cursor* = i + cstr_length(s[i]&);
        return s[i]&;
    }
    /* Skip leading delimiters. */
    while (s[i] != 0 && cstr_find_char(delims, s[i]) >= 0) {
        i += 1;
    }
    if (s[i] == 0) {
        cursor* = i;
        return null;
    }
    start: u64 = i;
    while (s[i] != 0 && cstr_find_char(delims, s[i]) < 0) {
        i += 1;
    }
    if (s[i] != 0) {
        s[i] = 0;
        i += 1;
    }
    cursor* = i;
    return s[start]&;
}
