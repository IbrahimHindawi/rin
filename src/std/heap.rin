import "memops.rin"
import "cstd.rin"
import "order.rin"

/* A binary heap: a priority queue whose top is the element that is less than
   every other one under its comparator. `less_i64` makes a min-heap,
   `greater_i64` a max-heap:

       h: heap<i64> = heap<i64>make(greater_i64);
       heap<i64>push(arena, h&, 5);
       largest: i64 = heap<i64>pop(h&); */

heap: struct<T> = {
    data: ^T;
    length: u64;
    border: u64;
    less: *proc(a: T, b: T) -> b32;
}

heap<T>make: proc<T>(less: *proc(a: T, b: T) -> b32) -> heap<T> = {
    h: heap<T> = {};
    h.less = less;
    return h;
}

heap<T>push: proc<T>(arena: *memops_arena, h: *heap<T>, x: T) -> void = {
    if (h*.length == h*.border) {
        old_border: u64 = h*.border;
        h*.border = old_border == 0 ? 16 : old_border * 2;
        h*.data = cast(memops_arena_realloc_(arena, sizeof(T) * h*.border, h*.data, sizeof(T) * old_border, alignof(T)), ^T);
        if (h*.data == null) {
            printf("rin runtime: heap allocation failure\n");
            exit(1);
        }
    }
    i: u64 = h*.length;
    h*.length += 1;
    while (i > 0) {
        parent: u64 = (i - 1) / 2;
        if (!h*.less(x, h*.data[parent])) {
            break;
        }
        h*.data[i] = h*.data[parent];
        i = parent;
    }
    h*.data[i] = x;
}

heap<T>top: proc<T>(h: *heap<T>) -> T = {
    if (h*.length == 0) {
        printf("rin runtime: heap top on an empty heap\n");
        exit(1);
    }
    return h*.data[0];
}

heap<T>pop: proc<T>(h: *heap<T>) -> T = {
    top: T = heap<T>top(h);
    h*.length -= 1;
    n: u64 = h*.length;
    if (n == 0) {
        return top;
    }
    x: T = h*.data[n];
    i: u64 = 0;
    while (1) {
        child: u64 = 2 * i + 1;
        if (child >= n) {
            break;
        }
        if (child + 1 < n && h*.less(h*.data[child + 1], h*.data[child])) {
            child += 1;
        }
        if (!h*.less(h*.data[child], x)) {
            break;
        }
        h*.data[i] = h*.data[child];
        i = child;
    }
    h*.data[i] = x;
    return top;
}

heap<T>is_empty: proc<T>(h: *heap<T>) -> b32 = {
    return h*.length == 0;
}

heap<T>clear: proc<T>(h: *heap<T>) -> void = {
    h*.length = 0;
}
