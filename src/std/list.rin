import "memops.rin"
import "node.rin"
import "equal.rin"

list: struct<T> = {
    head: option<*node<T>>;
    length: usize;
    /* Set by list<T>make: the arena the nodes come from, so the procs that
       take no arena can be called from safe code. Null for a list made by
       list<T>create. */
    arena: ^memops_arena;
}

/* A list that lives in a region, for safe code: the header and every node
   come from the region's arena. */
list<T>make: proc[unsafe]<T>(r: region R) -> *list<T> in R = {
    l: *list<T> in R = cast(memops_arena_push_zero(r, sizeof(list<T>), alignof(list<T>)), *list<T> in R);
    l*.arena = r;
    return l;
}

list<T>arena_of: proc[unsafe]<T>(l: *const list<T>) -> *memops_arena = {
    if (l*.arena == null) {
        unsafe { printf("rin runtime: list used without an arena; make it with list<T>make\n"); }
        exit(1);
    }
    unsafe { return l*.arena[0]&; }
}

list<T>push: proc[unsafe]<T>(l: *list<T>, item: T) -> void = { list<T>append(list<T>arena_of(l), l, item); }
list<T>push_front: proc[unsafe]<T>(l: *list<T>, item: T) -> void = { list<T>prepend(list<T>arena_of(l), l, item); }
list<T>insert: proc[unsafe]<T>(l: *list<T>, item: T, index: i32) -> void = { list<T>insert_at(list<T>arena_of(l), l, item, index); }
/* The node at an index, borrowed from the list: null past the end. */
list<T>node_at: proc[unsafe]<T>(l: *const list<T>, index: i32) -> option<*node<T>> = {
    if (index < 0 || cast(index, usize) >= l*.length) {
        return null;
    }
    iter: *node<T> = l*.head;
    count: i32 = 0;
    while (iter != null) {
        if (count == index) {
            return iter;
        }
        iter = iter*.next;
        count += 1;
    }
    return null;
}
list<T>take_at: proc[unsafe]<T>(l: *list<T>, index: i32) -> option<*node<T>> = { return list<T>remove_at(list<T>arena_of(l), l, index); }
list<T>take: proc[unsafe]<T>(l: *list<T>, item: T) -> option<*node<T>> = { return list<T>remove(list<T>arena_of(l), l, item); }
list<T>length: proc[unsafe]<T>(l: *const list<T>) -> usize = { return l*.length; }

list<T>create: proc[unsafe]<T>(arena: *memops_arena) -> *list<T> = {
    list: *list<T> = cast(memops_arena_push_zero(arena, sizeof(list<T>), alignof(list<T>)), *list<T>);
    if (list == null) {
        printf("rin runtime: list allocation failure\n");
        exit(1);
    }
    return list;
}

list<T>append: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, item: T) -> void = {
    node: *node<T> = node<T>create(arena, item);
    if (list*.head == null) {
        unsafe { list*.head = node; }
        list*.length += 1;
        return;
    }
    iter: *node<T> = list*.head;
    while (iter*.next != null) {
        unsafe { iter = iter*.next; }
    }
    unsafe { iter*.next = node; }
    list*.length += 1;
}

list<T>prepend: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, item: T) -> void = {
    node: *node<T> = node<T>create(arena, item);
    unsafe { node*.next = list*.head; }
    unsafe { list*.head = node; }
    list*.length += 1;
}

list<T>insert_at: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, item: T, index: i32) -> void = {
    if (list == null || index < 0 || cast(index, usize) > list*.length) {
        printf("rin runtime: list invalid index\n");
        return;
    }
    if (index == 0) {
        list<T>prepend(arena, list, item);
        return;
    }
    if (cast(index, usize) == list*.length) {
        list<T>append(arena, list, item);
        return;
    }
    prev: *node<T> = list<T>get_at(arena, list, index - 1);
    if (prev == null) {
        return;
    }
    node: *node<T> = node<T>create(arena, item);
    node*.next = prev*.next;
    prev*.next = node;
    list*.length += 1;
}

list<T>get_length: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>) -> usize = {
    if (list == null) {
        return 0;
    }
    return list*.length;
}

list<T>get_at: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, index: i32) -> option<*node<T>> = {
    if (list == null || index < 0 || cast(index, usize) >= list*.length) {
        return null;
    }
    iter: *node<T> = list*.head;
    count: i32 = 0;
    while (iter != null) {
        if (count == index) {
            return iter;
        }
        iter = iter*.next;
        count += 1;
    }
    return null;
}

list<T>remove_at: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, index: i32) -> option<*node<T>> = {
    if (list == null || index < 0 || cast(index, usize) >= list*.length) {
        return null;
    }
    iter: *node<T> = list*.head;
    prev: *node<T> = null;
    count: i32 = 0;
    while (iter != null) {
        if (count == index) {
            if (prev == null) {
                list*.head = iter*.next;
            } else {
                prev*.next = iter*.next;
            }
            iter*.next = null;
            list*.length -= 1;
            return iter;
        }
        prev = iter;
        iter = iter*.next;
        count += 1;
    }
    return null;
}

list<T>remove: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>, item: T) -> option<*node<T>> = {
    if (list == null || list*.length == 0) {
        return null;
    }
    iter: *node<T> = list*.head;
    prev: *node<T> = null;
    while (iter != null) {
        if (runtime_equal<T>(iter*.data, item)) {
            if (prev == null) {
                list*.head = iter*.next;
            } else {
                prev*.next = iter*.next;
            }
            iter*.next = null;
            list*.length -= 1;
            return iter;
        }
        prev = iter;
        iter = iter*.next;
    }
    return null;
}

list<T>destroy: proc[unsafe]<T>(arena: *memops_arena, list: *list<T>) -> void = {
    if (list != null) {
        unsafe { list*.head = null; }
        list*.length = 0;
    }
}

list<T>is_empty: proc[unsafe]<T>(list: *list<T>) -> b32 = {
    return list == null || list*.length == 0;
}
