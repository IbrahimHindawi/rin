import "memops.rin"
import "node.rin"
import "equal.rin"

list: struct<T> = {
    head: *node<T>;
    length: usize;
}

list<T>create: proc[trusted]<T>(arena: *memops_arena) -> *list<T> = {
    list: *list<T> = cast(memops_arena_push_zero(arena, sizeof(list<T>), alignof(list<T>)), *list<T>);
    if (list == null) {
        printf("rin runtime: list allocation failure\n");
        exit(1);
    }
    return list;
}

list<T>append: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, item: T) -> void = {
    node: *node<T> = node<T>create(arena, item);
    if (list*.head == null) {
        list*.head = node;
        list*.length += 1;
        return;
    }
    iter: *node<T> = list*.head;
    while (iter*.next != null) {
        iter = iter*.next;
    }
    iter*.next = node;
    list*.length += 1;
}

list<T>prepend: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, item: T) -> void = {
    node: *node<T> = node<T>create(arena, item);
    node*.next = list*.head;
    list*.head = node;
    list*.length += 1;
}

list<T>insert_at: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, item: T, index: i32) -> void = {
    if (list == null || index < 0 || cast(index, usize) > list*.length) {
        printf("rin runtime: list invalid index\n");
        return;
    }
    if (index == 0) {
        list<T>prepend(arena, list, item);
        return;
    }
    if (cast(index, usize) == list*.length) {
        list<T>append(arena, list, item);
        return;
    }
    prev: *node<T> = list<T>get_at(arena, list, index - 1);
    if (prev == null) {
        return;
    }
    node: *node<T> = node<T>create(arena, item);
    node*.next = prev*.next;
    prev*.next = node;
    list*.length += 1;
}

list<T>get_length: proc[trusted]<T>(arena: *memops_arena, list: *list<T>) -> usize = {
    if (list == null) {
        return 0;
    }
    return list*.length;
}

list<T>get_at: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, index: i32) -> *node<T> = {
    if (list == null || index < 0 || cast(index, usize) >= list*.length) {
        return null;
    }
    iter: *node<T> = list*.head;
    count: i32 = 0;
    while (iter != null) {
        if (count == index) {
            return iter;
        }
        iter = iter*.next;
        count += 1;
    }
    return null;
}

list<T>remove_at: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, index: i32) -> *node<T> = {
    if (list == null || index < 0 || cast(index, usize) >= list*.length) {
        return null;
    }
    iter: *node<T> = list*.head;
    prev: *node<T> = null;
    count: i32 = 0;
    while (iter != null) {
        if (count == index) {
            if (prev == null) {
                list*.head = iter*.next;
            } else {
                prev*.next = iter*.next;
            }
            iter*.next = null;
            list*.length -= 1;
            return iter;
        }
        prev = iter;
        iter = iter*.next;
        count += 1;
    }
    return null;
}

list<T>remove: proc[trusted]<T>(arena: *memops_arena, list: *list<T>, item: T) -> *node<T> = {
    if (list == null || list*.length == 0) {
        return null;
    }
    iter: *node<T> = list*.head;
    prev: *node<T> = null;
    while (iter != null) {
        if (runtime_equal<T>(iter*.data, item)) {
            if (prev == null) {
                list*.head = iter*.next;
            } else {
                prev*.next = iter*.next;
            }
            iter*.next = null;
            list*.length -= 1;
            return iter;
        }
        prev = iter;
        iter = iter*.next;
    }
    return null;
}

list<T>destroy: proc[trusted]<T>(arena: *memops_arena, list: *list<T>) -> void = {
    if (list != null) {
        list*.head = null;
        list*.length = 0;
    }
}

list<T>is_empty: proc[trusted]<T>(list: *list<T>) -> b32 = {
    return list == null || list*.length == 0;
}
