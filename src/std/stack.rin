import "memops.rin"
import "node.rin"

stack: struct<T> = {
    head: ?*node<T>;
    length: usize;
    /* Set by stack<T>make; see list.rin. */
    arena: ^memops_arena;
}

stack<T>make: proc<T>(r: region R) -> *stack<T> in R = { unsafe {
    s: *stack<T> in R = cast(memops_arena_push_zero(r, sizeof(stack<T>), alignof(stack<T>)), *stack<T> in R);
    s*.arena = r;
    return s;
} }

stack<T>arena_of: proc<T>(s: *const stack<T>) -> *memops_arena = { unsafe {
    if (s*.arena == null) {
        printf("rin runtime: stack used without an arena; make it with stack<T>make\n");
        exit(1);
    }
    return s*.arena[0]&;
} }

stack<T>put: proc<T>(s: *stack<T>, data: T) -> void = { unsafe { stack<T>push(stack<T>arena_of(s), s, data); } }
stack<T>take: proc<T>(s: *stack<T>) -> ?*node<T> = { unsafe { return stack<T>pop(stack<T>arena_of(s), s); } }
stack<T>top: proc<T>(s: *const stack<T>) -> ?*node<T> = { unsafe { return s*.head; } }
stack<T>length: proc<T>(s: *const stack<T>) -> usize = { unsafe { return s*.length; } }

stack<T>create: proc<T>(arena: *memops_arena) -> *stack<T> = { unsafe {
    stack: *stack<T> = cast(memops_arena_push_zero(arena, sizeof(stack<T>), alignof(stack<T>)), *stack<T>);
    if (stack == null) {
        printf("rin runtime: stack allocation failure\n");
        exit(1);
    }
    return stack;
} }

stack<T>push: proc<T>(arena: *memops_arena, stack: *stack<T>, data: T) -> void = { unsafe {
    node: *node<T> = node<T>create(arena, data);
    node*.next = stack*.head;
    stack*.head = node;
    stack*.length += 1;
} }

stack<T>pop: proc<T>(arena: *memops_arena, stack: *stack<T>) -> ?*node<T> = { unsafe {
    if (stack == null || stack*.head == null) {
        return null;
    }
    node: *node<T> = stack*.head;
    stack*.head = node*.next;
    node*.next = null;
    stack*.length -= 1;
    return node;
} }

stack<T>peek: proc<T>(arena: *memops_arena, stack: *stack<T>) -> ?*node<T> = { unsafe {
    if (stack == null) {
        return null;
    }
    return stack*.head;
} }

stack<T>destroy: proc<T>(arena: *memops_arena, stack: *stack<T>) -> void = { unsafe {
    if (stack != null) {
        stack*.head = null;
        stack*.length = 0;
    }
} }

stack<T>is_empty: proc<T>(stack: *stack<T>) -> b32 = { unsafe {
    return stack == null || stack*.length == 0;
} }
