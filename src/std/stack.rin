import "memops.rin"
import "node.rin"

stack: struct<T> = {
    head: option<*node<T>>;
    length: usize;
    /* Set by stack<T>make; see list.rin. */
    arena: ^memops_arena;
}

stack<T>make: proc[unsafe]<T>(r: region R) -> *stack<T> in R = {
    s: *stack<T> in R = cast(memops_arena_push_zero(r, sizeof(stack<T>), alignof(stack<T>)), *stack<T> in R);
    s*.arena = r;
    return s;
}

stack<T>arena_of: proc[unsafe]<T>(s: *const stack<T>) -> *memops_arena = {
    if (s*.arena == null) {
        unsafe { printf("rin runtime: stack used without an arena; make it with stack<T>make\n"); }
        exit(1);
    }
    unsafe { return s*.arena[0]&; }
}

stack<T>put: proc[unsafe]<T>(s: *stack<T>, data: T) -> void = { stack<T>push(stack<T>arena_of(s), s, data); }
stack<T>take: proc[unsafe]<T>(s: *stack<T>) -> option<*node<T>> = { return stack<T>pop(stack<T>arena_of(s), s); }
stack<T>top: proc[unsafe]<T>(s: *const stack<T>) -> option<*node<T>> = { return s*.head; }
stack<T>length: proc[unsafe]<T>(s: *const stack<T>) -> usize = { return s*.length; }

stack<T>create: proc[unsafe]<T>(arena: *memops_arena) -> *stack<T> = {
    stack: *stack<T> = cast(memops_arena_push_zero(arena, sizeof(stack<T>), alignof(stack<T>)), *stack<T>);
    if (stack == null) {
        printf("rin runtime: stack allocation failure\n");
        exit(1);
    }
    return stack;
}

stack<T>push: proc[unsafe]<T>(arena: *memops_arena, stack: *stack<T>, data: T) -> void = {
    node: *node<T> = node<T>create(arena, data);
    unsafe { node*.next = stack*.head; }
    unsafe { stack*.head = node; }
    stack*.length += 1;
}

stack<T>pop: proc[unsafe]<T>(arena: *memops_arena, stack: *stack<T>) -> option<*node<T>> = {
    if (stack == null || stack*.head == null) {
        return null;
    }
    node: *node<T> = stack*.head;
    unsafe { stack*.head = node*.next; }
    unsafe { node*.next = null; }
    stack*.length -= 1;
    unsafe { return node; }
}

stack<T>peek: proc[unsafe]<T>(arena: *memops_arena, stack: *stack<T>) -> option<*node<T>> = {
    if (stack == null) {
        return null;
    }
    unsafe { return stack*.head; }
}

stack<T>destroy: proc[unsafe]<T>(arena: *memops_arena, stack: *stack<T>) -> void = {
    if (stack != null) {
        unsafe { stack*.head = null; }
        stack*.length = 0;
    }
}

stack<T>is_empty: proc[unsafe]<T>(stack: *stack<T>) -> b32 = {
    return stack == null || stack*.length == 0;
}
