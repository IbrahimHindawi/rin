import "memops.rin"
import "cstd.rin"
import "hash.rin"

/* A hash map over any key type that has `hash` and `equal` (see hash.rin).

   Open addressing with linear probing, a power-of-two capacity, and the table
   grown before it is three quarters full. A zeroed hashmap is empty and ready:

       seen: hashmap<i64, u64> = {};
       hashmap<i64, u64>put(arena, seen&, x, i);
       at: *u64 = hashmap<i64, u64>get(seen&, target - x);   // null when absent

   Counting is `hashmap<K, V>slot(arena, m&, key)* += 1`, which inserts a
   zero the first time. Iterate with first/next over the slot indexes:

       for (i: u64 = hashmap<K, V>first(m&); i < m.capacity; i = hashmap<K, V>next(m&, i)) {
           use(m.keys[i], m.values[i]);
       }

   `put` and `slot` may grow the table, which moves every value: a pointer from
   `get` or `slot` is good until the next insert. Removed slots are marked rather
   than emptied so later keys in the same probe run stay reachable. */

hashmap: struct<K, V> = {
    keys: ^K;
    values: ^V;
    states: ^u8;
    length: u64;
    removed: u64;
    capacity: u64;
    /* Set by hashmap<K, V>make: the arena the map grows into, so set needs
       none handed to it. Null for a map made the old way, by value. */
    arena: ^memops_arena;
}

/* A map that lives in a region, for safe code: the header and everything it
   grows into come from the region's arena. */
hashmap<K, V>make: proc[trusted]<K, V>(r: region R) -> *hashmap<K, V> in R = {
    m: *hashmap<K, V> in R = cast(memops_arena_push_zero(r, sizeof(hashmap<K, V>), alignof(hashmap<K, V>)), *hashmap<K, V> in R);
    m*.arena = r;
    return m;
}

/* put, for a map made by hashmap<K, V>make. The pointer returned is borrowed;
   it is stale after the next set. */
hashmap<K, V>set: proc[trusted]<K, V>(m: *hashmap<K, V>, key: K, value: V) -> *V = {
    if (m*.arena == null) {
        printf("rin runtime: hashmap set on a map not made by hashmap<K, V>make\n");
        exit(1);
    }
    return hashmap<K, V>put(m*.arena[0]&, m, key, value);
}

hashmap<K, V>find: proc[trusted]<K, V>(m: *const hashmap<K, V>, key: K) -> u64 = {
    if (m*.capacity == 0) {
        return 0;
    }
    mask: u64 = m*.capacity - 1;
    i: u64 = hash<K>(key) & mask;
    while (m*.states[i] != 0) {
        if (m*.states[i] == 1 && equal<K>(m*.keys[i], key)) {
            return i;
        }
        i = (i + 1) & mask;
    }
    return m*.capacity;
}

hashmap<K, V>grow: proc[trusted]<K, V>(arena: *memops_arena, m: *hashmap<K, V>) -> void = {
    old_keys: ^K = m*.keys;
    old_values: ^V = m*.values;
    old_states: ^u8 = m*.states;
    old_capacity: u64 = m*.capacity;
    capacity: u64 = 16;
    while (capacity * 3 <= (m*.length + 1) * 8) {
        capacity *= 2;
    }
    m*.keys = cast(memops_arena_push(arena, sizeof(K) * capacity, alignof(K)), ^K);
    m*.values = cast(memops_arena_push(arena, sizeof(V) * capacity, alignof(V)), ^V);
    m*.states = cast(memops_arena_push_zero(arena, capacity, 1), ^u8);
    if (m*.keys == null || m*.values == null || m*.states == null) {
        printf("rin runtime: hashmap allocation failure\n");
        exit(1);
    }
    m*.capacity = capacity;
    m*.removed = 0;
    mask: u64 = capacity - 1;
    for (j: u64 = 0; j < old_capacity; j += 1) {
        if (old_states[j] != 1) {
            continue;
        }
        i: u64 = hash<K>(old_keys[j]) & mask;
        while (m*.states[i] != 0) {
            i = (i + 1) & mask;
        }
        m*.keys[i] = old_keys[j];
        m*.values[i] = old_values[j];
        m*.states[i] = 1;
    }
}

// The value slot for key, inserting a zeroed value when it is not there yet.
hashmap<K, V>slot: proc[trusted]<K, V>(arena: *memops_arena, m: *hashmap<K, V>, key: K) -> *V = {
    found: u64 = hashmap<K, V>find(m, key);
    if (found < m*.capacity) {
        return m*.values[found]&;
    }
    if ((m*.length + m*.removed + 1) * 4 > m*.capacity * 3) {
        hashmap<K, V>grow(arena, m);
    }
    mask: u64 = m*.capacity - 1;
    i: u64 = hash<K>(key) & mask;
    while (m*.states[i] == 1) {
        i = (i + 1) & mask;
    }
    if (m*.states[i] == 2) {
        m*.removed -= 1;
    }
    m*.keys[i] = key;
    memset(m*.values[i]&, 0, sizeof(V));
    m*.states[i] = 1;
    m*.length += 1;
    return m*.values[i]&;
}

hashmap<K, V>put: proc[trusted]<K, V>(arena: *memops_arena, m: *hashmap<K, V>, key: K, value: V) -> *V = {
    slot: *V = hashmap<K, V>slot(arena, m, key);
    slot* = value;
    return slot;
}

hashmap<K, V>get: proc[trusted]<K, V>(m: *const hashmap<K, V>, key: K) -> ?*V = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return null;
    }
    return m*.values[i]&;
}

hashmap<K, V>get_or: proc[trusted]<K, V>(m: *const hashmap<K, V>, key: K, fallback: V) -> V = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return fallback;
    }
    return m*.values[i];
}

hashmap<K, V>has: proc[trusted]<K, V>(m: *const hashmap<K, V>, key: K) -> b32 = {
    return hashmap<K, V>find(m, key) < m*.capacity;
}

hashmap<K, V>remove: proc[trusted]<K, V>(m: *hashmap<K, V>, key: K) -> b32 = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return 0;
    }
    m*.states[i] = 2;
    m*.length -= 1;
    m*.removed += 1;
    return 1;
}

hashmap<K, V>clear: proc[trusted]<K, V>(m: *hashmap<K, V>) -> void = {
    if (m*.capacity > 0) {
        memset(m*.states, 0, m*.capacity);
    }
    m*.length = 0;
    m*.removed = 0;
}

// The first occupied slot at or after i, or capacity when there is none.
hashmap<K, V>scan: proc[trusted]<K, V>(m: *const hashmap<K, V>, i: u64) -> u64 = {
    while (i < m*.capacity && m*.states[i] != 1) {
        i += 1;
    }
    return i;
}

/* The key and value in a live slot, for walking a map from safe code:

       for (i: u64 = hashmap<K, V>first(m); i < m*.capacity; i = hashmap<K, V>next(m, i)) {
           use(hashmap<K, V>key_at(m, i)*, hashmap<K, V>value_at(m, i)*);
       }

   Both are borrowed from the map: good until the next set or remove. */
hashmap<K, V>key_at: proc[trusted]<K, V>(m: *const hashmap<K, V>, i: u64) -> *const K = {
    if (i >= m*.capacity || m*.states[i] != 1) {
        printf("rin runtime: hashmap slot is not in use\n");
        exit(1);
    }
    return m*.keys[i]&;
}
hashmap<K, V>value_at: proc[trusted]<K, V>(m: *const hashmap<K, V>, i: u64) -> *V = {
    if (i >= m*.capacity || m*.states[i] != 1) {
        printf("rin runtime: hashmap slot is not in use\n");
        exit(1);
    }
    return m*.values[i]&;
}

hashmap<K, V>first: proc[trusted]<K, V>(m: *const hashmap<K, V>) -> u64 = {
    return hashmap<K, V>scan(m, 0);
}

hashmap<K, V>next: proc[trusted]<K, V>(m: *const hashmap<K, V>, i: u64) -> u64 = {
    return hashmap<K, V>scan(m, i + 1);
}
