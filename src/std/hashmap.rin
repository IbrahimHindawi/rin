import "memops.rin"
import "cstd.rin"
import "hash.rin"

/* A hash map over any key type that has `hash` and `equal` (see hash.rin).

   Open addressing with linear probing, a power-of-two capacity, and the table
   grown before it is three quarters full. A zeroed hashmap is empty and ready:

       seen: hashmap<i64, u64> = {};
       hashmap<i64, u64>put(arena, seen&, x, i);
       at: *u64 = hashmap<i64, u64>get(seen&, target - x);   // null when absent

   Counting is `hashmap<K, V>slot(arena, m&, key)* += 1`, which inserts a
   zero the first time. Iterate with first/next over the slot indexes:

       for (i: u64 = hashmap<K, V>first(m&); i < m.capacity; i = hashmap<K, V>next(m&, i)) {
           use(m.keys[i], m.values[i]);
       }

   `put` and `slot` may grow the table, which moves every value: a pointer from
   `get` or `slot` is good until the next insert. Removed slots are marked rather
   than emptied so later keys in the same probe run stay reachable. */

hashmap: struct<K, V> = {
    keys: ^K;
    values: ^V;
    states: ^u8;
    length: u64;
    removed: u64;
    capacity: u64;
    /* Set by hashmap<K, V>make: the arena the map grows into, so set needs
       none handed to it. Null for a map made the old way, by value. */
    arena: ^memops_arena;
}

/* A map that lives in a region, for safe code: the header and everything it
   grows into come from the region's arena. */
hashmap<K, V>make: proc<K, V>(r: region R) -> *hashmap<K, V> in R = {
    unsafe {
        m: *hashmap<K, V> in R = cast(memops_arena_push_zero(r, sizeof(hashmap<K, V>), alignof(hashmap<K, V>)), *hashmap<K, V> in R);
        m*.arena = r;
        return m;
    }
}

/* put, for a map made by hashmap<K, V>make. The pointer returned is borrowed;
   it is stale after the next set. */
hashmap<K, V>set: proc<K, V>(m: *hashmap<K, V>, key: K, value: V) -> *V = {
    if (m*.arena == null) {
        unsafe { printf("rin runtime: hashmap set on a map not made by hashmap<K, V>make\n"); }
        exit(1);
    }
    unsafe { return hashmap<K, V>put(m*.arena[0]&, m, key, value); }
}

/* The three arrays as slices of the capacity. These lines, and the allocation in hashmap<K, V>storage_, are the
   map's whole trust: only this file sets the fields, so the capacity is the arrays'. Everything else is indexed.
   They are static because of what else they can reach: a slot that is not in use holds bytes nothing wrote, and
   only the procs here know which those are. */
hashmap<K, V>keys_: proc[static, no_move]<K, V>(m: *const hashmap<K, V>) -> []K = {
    out: []K = {};
    if (m*.capacity > 0) {
        unsafe { return m*.keys[0..m*.capacity]; }
    }
    return out;
}

hashmap<K, V>values_: proc[static, no_move]<K, V>(m: *const hashmap<K, V>) -> []V = {
    out: []V = {};
    if (m*.capacity > 0) {
        unsafe { return m*.values[0..m*.capacity]; }
    }
    return out;
}

hashmap<K, V>states_: proc[static, no_move]<K, V>(m: *const hashmap<K, V>) -> []u8 = {
    out: []u8 = {};
    if (m*.capacity > 0) {
        unsafe { return m*.states[0..m*.capacity]; }
    }
    return out;
}

hashmap<K, V>find: proc<K, V>(m: *const hashmap<K, V>, key: K) -> u64 = {
    if (m*.capacity == 0) {
        return 0;
    }
    keys: []K = hashmap<K, V>keys_(m);
    states: []u8 = hashmap<K, V>states_(m);
    mask: u64 = m*.capacity - 1;
    i: u64 = hash<K>(key) & mask;
    while (states[i] != 0) {
        if (states[i] == 1) {
            held: K = keys[i];
            if (equal<K>(held, key)) {
                return i;
            }
        }
        i = (i + 1) & mask;
    }
    return m*.capacity;
}

hashmap<K, V>storage_: proc[unsafe]<K, V>(arena: *memops_arena, m: *hashmap<K, V>, capacity: u64) -> void = {
    m*.keys = cast(memops_arena_push(arena, memops_bytes(sizeof(K), capacity), alignof(K)), ^K);
    m*.values = cast(memops_arena_push(arena, memops_bytes(sizeof(V), capacity), alignof(V)), ^V);
    m*.states = cast(memops_arena_push_zero(arena, capacity, 1), ^u8);
    if (m*.keys == null || m*.values == null || m*.states == null) {
        printf("rin runtime: hashmap allocation failure\n");
        exit(1);
    }
    m*.capacity = capacity;
    m*.removed = 0;
}

/* The live entries of the old arrays into the map's new, empty ones. */
hashmap<K, V>rehash_: proc[static]<K, V>(m: *hashmap<K, V>, old_keys: []K, old_values: []V, old_states: []u8) -> void = {
    keys: []K = hashmap<K, V>keys_(m);
    values: []V = hashmap<K, V>values_(m);
    states: []u8 = hashmap<K, V>states_(m);
    mask: u64 = m*.capacity - 1;
    for (j: u64 = 0; j < old_states.length; j += 1) {
        if (old_states[j] != 1) {
            continue;
        }
        i: u64 = hash<K>(old_keys[j]) & mask;
        while (states[i] != 0) {
            i = (i + 1) & mask;
        }
        keys[i] = old_keys[j];
        values[i] = old_values[j];
        states[i] = 1;
    }
}

hashmap<K, V>grow: proc[unsafe]<K, V>(arena: *memops_arena, m: *hashmap<K, V>) -> void = {
    old_keys: []K = hashmap<K, V>keys_(m);
    old_values: []V = hashmap<K, V>values_(m);
    old_states: []u8 = hashmap<K, V>states_(m);
    capacity: u64 = 16;
    while (capacity * 3 <= (m*.length + 1) * 8) {
        capacity *= 2;
    }
    hashmap<K, V>storage_(arena, m, capacity);
    hashmap<K, V>rehash_(m, old_keys, old_values, old_states);
}

/* Takes a slot for a key that is not in the map, which has room: its index. */
hashmap<K, V>claim_: proc[static]<K, V>(m: *hashmap<K, V>, key: K) -> u64 = {
    keys: []K = hashmap<K, V>keys_(m);
    states: []u8 = hashmap<K, V>states_(m);
    mask: u64 = m*.capacity - 1;
    i: u64 = hash<K>(key) & mask;
    while (states[i] == 1) {
        i = (i + 1) & mask;
    }
    if (states[i] == 2) {
        m*.removed -= 1;
    }
    keys[i] = key;
    states[i] = 1;
    m*.length += 1;
    return i;
}

// The value slot for key, inserting a zeroed value when it is not there yet.
hashmap<K, V>slot: proc[unsafe]<K, V>(arena: *memops_arena, m: *hashmap<K, V>, key: K) -> *V = {
    found: u64 = hashmap<K, V>find(m, key);
    if (found < m*.capacity) {
        return m*.values[found]&;
    }
    if ((m*.length + m*.removed + 1) * 4 > m*.capacity * 3) {
        hashmap<K, V>grow(arena, m);
    }
    i: u64 = hashmap<K, V>claim_(m, key);
    memset(m*.values[i]&, 0, sizeof(V));
    return m*.values[i]&;
}

hashmap<K, V>put: proc[unsafe]<K, V>(arena: *memops_arena, m: *hashmap<K, V>, key: K, value: V) -> *V = {
    slot: *V = hashmap<K, V>slot(arena, m, key);
    slot* = value;
    return slot;
}

hashmap<K, V>get: proc<K, V>(m: *const hashmap<K, V>, key: K) -> option<*V> = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return null;
    }
    values: []V = hashmap<K, V>values_(m);
    return values[i]&;
}

hashmap<K, V>get_or: proc<K, V>(m: *const hashmap<K, V>, key: K, fallback: V) -> V = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return fallback;
    }
    values: []V = hashmap<K, V>values_(m);
    return values[i];
}

hashmap<K, V>has: proc<K, V>(m: *const hashmap<K, V>, key: K) -> b32 = {
    return hashmap<K, V>find(m, key) < m*.capacity;
}

hashmap<K, V>remove: proc<K, V>(m: *hashmap<K, V>, key: K) -> b32 = {
    i: u64 = hashmap<K, V>find(m, key);
    if (i >= m*.capacity) {
        return 0;
    }
    states: []u8 = hashmap<K, V>states_(m);
    states[i] = 2;
    m*.length -= 1;
    m*.removed += 1;
    return 1;
}

hashmap<K, V>clear: proc<K, V>(m: *hashmap<K, V>) -> void = {
    if (m*.capacity > 0) {
        unsafe { memset(m*.states, 0, m*.capacity); }
    }
    m*.length = 0;
    m*.removed = 0;
}

// The first occupied slot at or after i, or capacity when there is none.
hashmap<K, V>scan: proc<K, V>(m: *const hashmap<K, V>, i: u64) -> u64 = {
    states: []u8 = hashmap<K, V>states_(m);
    while (i < states.length && states[i] != 1) {
        i += 1;
    }
    return i;
}

/* The key and value in a live slot, for walking a map from safe code:

       for (i: u64 = hashmap<K, V>first(m); i < m*.capacity; i = hashmap<K, V>next(m, i)) {
           use(hashmap<K, V>key_at(m, i)*, hashmap<K, V>value_at(m, i)*);
       }

   Both are borrowed from the map: good until the next set or remove. */
hashmap<K, V>key_at: proc<K, V>(m: *const hashmap<K, V>, i: u64) -> *const K = {
    states: []u8 = hashmap<K, V>states_(m);
    if (i >= states.length || states[i] != 1) {
        unsafe { printf("rin runtime: hashmap slot is not in use\n"); }
        exit(1);
    }
    keys: []K = hashmap<K, V>keys_(m);
    return keys[i]&;
}
hashmap<K, V>value_at: proc<K, V>(m: *const hashmap<K, V>, i: u64) -> *V = {
    states: []u8 = hashmap<K, V>states_(m);
    if (i >= states.length || states[i] != 1) {
        unsafe { printf("rin runtime: hashmap slot is not in use\n"); }
        exit(1);
    }
    values: []V = hashmap<K, V>values_(m);
    return values[i]&;
}

hashmap<K, V>first: proc<K, V>(m: *const hashmap<K, V>) -> u64 = {
    return hashmap<K, V>scan(m, 0);
}

hashmap<K, V>next: proc<K, V>(m: *const hashmap<K, V>, i: u64) -> u64 = {
    return hashmap<K, V>scan(m, i + 1);
}
