cinclude "stdio.h"
import "cstd.rin"
import "memops.rin"

/* A file safe code can hold. A `file` is an index and a generation, plain data
   with nothing to dangle, so it goes anywhere: a local, a field, a global, a
   copy of a copy. Closing one moves its slot's generation on, so every copy
   stops working at once, and using one is a checked run-time stop, the way an
   index out of bounds is, never a read of a freed FILE. This is what a Drop
   would buy, without one: a file left open is a leak, not a memory error. */
file: struct = {
    slot: u32;
    generation: u32;
}

file_table_stream: static [256]^FILE = {};
file_table_generation: static [256]u32 = {};
/* What was done last to each stream: C wants a seek or a flush between a read and a write. */
file_table_last: static [256]u8 = {};

file_about_to_read: proc(f: file) -> void = {
    if (f.slot < 256 && file_table_last[f.slot] == 2) { unsafe { fflush(cast(file_stream(f), *FILE)); } }
    if (f.slot < 256) { file_table_last[f.slot] = 1; }
}

file_about_to_write: proc(f: file) -> void = {
    if (f.slot < 256 && file_table_last[f.slot] == 1) { unsafe { fseek(cast(file_stream(f), *FILE), 0, 1); } }
    if (f.slot < 256) { file_table_last[f.slot] = 2; }
}

/* Whether a file opened: file_open's result is tested with this. */
file_is_open: proc(f: file) -> b32 = {
    return f.generation != 0 && f.slot < 256 && file_table_generation[f.slot] == f.generation &&
           file_table_stream[f.slot] != null;
}

/* The FILE behind a file, for fprintfmt and the procs below. */
file_stream: proc[unsafe](f: file) -> ^FILE = {
    if (!file_is_open(f)) {
        printf("rin runtime: file used after it closed, or that never opened\n");
        exit(1);
    }
    return file_table_stream[f.slot];
}

/* The zero `file` when it did not open, which is never open. */
file_open: proc(path: ^const char, mode: ^const char) -> file = { unsafe {
    result: file = {};
    if (path == null || mode == null) { return result; }
    for (i: u32 = 0; i < 256; i += 1) {
        if (file_table_stream[i] == null) {
            stream: ^FILE = cast(fopen(path, mode), ^FILE);
            if (stream == null) { return result; }
            file_table_last[i] = 0;
            file_table_stream[i] = stream;
            file_table_generation[i] += 1;
            result.slot = i;
            result.generation = file_table_generation[i];
            return result;
        }
    }
    printf("rin runtime: more than 256 files open\n");
    exit(1);
    return result;
} }

/* Closing what is already closed does nothing. */
file_close: proc(f: file) -> void = {
    if (!file_is_open(f)) { return; }
    unsafe { fclose(cast(file_table_stream[f.slot], *FILE)); }
    file_table_stream[f.slot] = null;
    file_table_generation[f.slot] += 1;
}

file_end_: proc[unsafe](arg: ^void) -> void = {
    file_close(cast(arg, ^file)[0]);
}

/* A file that closes when the region ends, whichever way it ends. */
file_open_in: proc(r: region R, path: ^const char, mode: ^const char) -> file = { unsafe {
    f: file = file_open(path, mode);
    if (file_is_open(f)) {
        kept: ^file = cast(memops_arena_push_zero(r, sizeof(file), alignof(file)), ^file);
        kept[0] = f;
        memops_arena_on_end(r, file_end_, kept);
    }
    return f;
} }

/* How many bytes were read, up to out's length. */
file_read: proc(f: file, out: []u8) -> u64 = {
    if (out.length == 0) { return 0; }
    file_about_to_read(f);
    unsafe { return cast(fread(out.data, 1, cast(out.length, usize), cast(file_stream(f), *FILE)), u64); }
}

/* How many bytes were written. */
file_write: proc(f: file, bytes: []const u8) -> u64 = {
    if (bytes.length == 0) { return 0; }
    file_about_to_write(f);
    unsafe { return cast(fwrite(bytes.data, 1, cast(bytes.length, usize), cast(file_stream(f), *FILE)), u64); }
}

file_write_text: proc(f: file, text: ^const char) -> void = {
    if (text == null) { return; }
    file_about_to_write(f);
    unsafe { fputs(text, cast(file_stream(f), *FILE)); }
}

/* -1 at the end of the file. */
file_read_byte: proc(f: file) -> i32 = {
    file_about_to_read(f);
    unsafe { return fgetc(cast(file_stream(f), *FILE)); }
}

file_flush: proc(f: file) -> void = {
    /* Only an output stream may be flushed. */
    if (f.slot < 256 && file_table_last[f.slot] != 2) { return; }
    unsafe { fflush(cast(file_stream(f), *FILE)); }
}

file_size: proc(f: file) -> i64 = { unsafe {
    stream: *FILE = cast(file_stream(f), *FILE);
    at: long = ftell(stream);
    fseek(stream, 0, 2);
    size: long = ftell(stream);
    fseek(stream, at, 0);
    return cast(size, i64);
} }

file_seek: proc(f: file, offset: i64) -> b32 = {
    /* C's long may be narrower, and a truncated offset would land somewhere else. */
    if (cast(cast(offset, long), i64) != offset) { return 0; }
    if (f.slot < 256) { file_table_last[f.slot] = 0; }
    unsafe { return fseek(cast(file_stream(f), *FILE), cast(offset, long), 0) == 0; }
}
