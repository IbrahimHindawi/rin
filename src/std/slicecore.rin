/* The struct behind `[]T`. The compiler imports this file by itself wherever a
   program writes `[]T` or a subrange, so it imports nothing: writing a slice
   should not pull in stdio. The procs that work on slices are in slice.rin.

   `[]T` and `slice<T>` are one type, and so are `[]const T` and
   `slice<const T>`. Indexing a slice, `s[i]`, is bounds checked unless RIN_NO_BOUNDS_CHECKS
   is defined; `s.data[i]` is the raw, unchecked access. */
slice: struct<T> = {
    data: ^T;
    length: u64;
}

/* The chars of a C string as a slice, without its terminator. Null is the empty slice. This is the one place
   a C string is measured: a raw string safe code holds is terminated, being a literal, a `str`, or what cstr_of
   looked inside its array for, so every read of one past here can be checked. */
cstr_view: proc(s: ^const c8) -> slice<const c8> = {
    out: slice<const c8> = {};
    if (s == null) { return out; }
    unsafe {
        n: u64 = 0;
        while (s[n] != 0) { n += 1; }
        out.data = s;
        out.length = n;
    }
    return out;
}
