import "memops.rin"
import "binode.rin"
import "equal.rin"

dlist: struct<T> = {
    head: option<*binode<T>>;
    tail: option<*binode<T>>;
    length: usize;
}

dlist<T>create: proc[unsafe]<T>(arena: *memops_arena) -> *dlist<T> = {
    list: *dlist<T> = cast(memops_arena_push_zero(arena, sizeof(dlist<T>), alignof(dlist<T>)), *dlist<T>);
    if (list == null) {
        printf("rin runtime: dlist allocation failure\n");
        exit(1);
    }
    return list;
}

dlist<T>append: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, item: T) -> void = {
    node: *binode<T> = binode<T>create(arena, item);
    if (list*.head == null) {
        unsafe { list*.head = node; }
        unsafe { list*.tail = node; }
        list*.length = 1;
        return;
    }
    unsafe { node*.prev = list*.tail; }
    unsafe { list*.tail*.next = node; }
    unsafe { list*.tail = node; }
    list*.length += 1;
}

dlist<T>prepend: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, item: T) -> void = {
    node: *binode<T> = binode<T>create(arena, item);
    if (list*.head == null) {
        unsafe { list*.head = node; }
        unsafe { list*.tail = node; }
        list*.length = 1;
        return;
    }
    unsafe { node*.next = list*.head; }
    unsafe { list*.head*.prev = node; }
    unsafe { list*.head = node; }
    list*.length += 1;
}

dlist<T>insert_at: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, item: T, index: i32) -> void = {
    if (list == null || index < 0 || cast(index, usize) > list*.length) {
        printf("rin runtime: dlist invalid index\n");
        return;
    }
    if (index == 0) {
        dlist<T>prepend(arena, list, item);
        return;
    }
    if (cast(index, usize) == list*.length) {
        dlist<T>append(arena, list, item);
        return;
    }
    iter: *binode<T> = dlist<T>get_at(arena, list, index);
    if (iter == null) {
        return;
    }
    node: *binode<T> = binode<T>create(arena, item);
    node*.next = iter;
    node*.prev = iter*.prev;
    if (iter*.prev != null) {
        iter*.prev*.next = node;
    }
    iter*.prev = node;
    list*.length += 1;
}

dlist<T>get_length: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>) -> usize = {
    if (list == null) {
        return 0;
    }
    return list*.length;
}

dlist<T>get_at: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, index: i32) -> option<*binode<T>> = {
    if (list == null || index < 0 || cast(index, usize) >= list*.length) {
        return null;
    }
    iter: *binode<T> = list*.head;
    for (i: i32 = 0; iter != null && i < index; i += 1) {
        iter = iter*.next;
    }
    return iter;
}

dlist<T>remove_node: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, node: *binode<T>) -> option<*binode<T>> = {
    if (list == null || node == null || list*.length == 0) {
        return null;
    }
    if (node*.prev != null) {
        unsafe { node*.prev*.next = node*.next; }
    }
    if (node*.next != null) {
        unsafe { node*.next*.prev = node*.prev; }
    }
    if (node == list*.head) {
        unsafe { list*.head = node*.next; }
    }
    if (node == list*.tail) {
        unsafe { list*.tail = node*.prev; }
    }
    unsafe { node*.prev = null; }
    unsafe { node*.next = null; }
    list*.length -= 1;
    return node;
}

dlist<T>remove_at: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, index: i32) -> *binode<T> = {
    node: *binode<T> = dlist<T>get_at(arena, list, index);
    return dlist<T>remove_node(arena, list, node);
}

dlist<T>remove: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>, item: T) -> option<*binode<T>> = {
    if (list == null || list*.length == 0) {
        return null;
    }
    iter: *binode<T> = list*.head;
    while (iter != null) {
        if (runtime_equal<T>(iter*.data, item)) {
            return dlist<T>remove_node(arena, list, iter);
        }
        iter = iter*.next;
    }
    return null;
}

dlist<T>destroy: proc[unsafe]<T>(arena: *memops_arena, list: *dlist<T>) -> void = {
    if (list != null) {
        unsafe { list*.head = null; }
        unsafe { list*.tail = null; }
        list*.length = 0;
    }
}

dlist<T>is_empty: proc[unsafe]<T>(list: *dlist<T>) -> b32 = {
    return list == null || list*.length == 0;
}
