import "memops.rin"
import "option.rin"

array: struct<T> = {
    data: ^T;
    length: u64;
}

array<T>reserve: proc[unsafe]<T>(arena: *memops_arena, length: u64) -> array<T> = {
    arr: array<T> = {};
    if (length == 0) {
        return arr;
    }
    arr.data = cast(memops_arena_push_zero(arena, memops_bytes(sizeof(T), length), alignof(T)), *T);
    if (arr.data == null) {
        printf("rin runtime: array reserve allocation failure\n");
        exit(1);
        return arr;
    }
    arr.length = length;
    return arr;
}

array<T>destroy: proc[unsafe]<T>(arena: *memops_arena, array: *array<T>) -> void = {
    array*.data = null;
    array*.length = 0;
}

array<T>at: proc[unsafe]<T>(array: *const array<T>, index: u64) -> *T = {
    if (array == null || index >= array*.length) {
        unsafe { printf("rin runtime: array index out of bounds\n"); }
        exit(1);
    }
    unsafe { return array*.data[index]&; }
}

array<T>get: proc[unsafe]<T>(array: *const array<T>, index: u64) -> option<T> = {
    if (array == null || index >= array*.length) {
        return option<T>none();
    }
    unsafe { return option<T>some(array*.data[index]); }
}

array<T>is_empty: proc[unsafe]<T>(array: *const array<T>) -> b32 = {
    return array == null || array*.length == 0;
}
