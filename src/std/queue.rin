import "memops.rin"
import "node.rin"

queue: struct<T> = {
    head: ?*node<T>;
    tail: ?*node<T>;
    length: usize;
    /* Set by queue<T>make; see list.rin. */
    arena: ^memops_arena;
}

queue<T>make: proc<T>(r: region R) -> *queue<T> in R = { unsafe {
    q: *queue<T> in R = cast(memops_arena_push_zero(r, sizeof(queue<T>), alignof(queue<T>)), *queue<T> in R);
    q*.arena = r;
    return q;
} }

queue<T>arena_of: proc<T>(q: *const queue<T>) -> *memops_arena = {
    if (q*.arena == null) {
        unsafe { printf("rin runtime: queue used without an arena; make it with queue<T>make\n"); }
        exit(1);
    }
    unsafe { return q*.arena[0]&; }
}

queue<T>push: proc<T>(q: *queue<T>, data: T) -> void = { unsafe { queue<T>enqueue(queue<T>arena_of(q), q, data); } }
queue<T>pop: proc<T>(q: *queue<T>) -> ?*node<T> = { unsafe { return queue<T>dequeue(queue<T>arena_of(q), q); } }
queue<T>front: proc<T>(q: *const queue<T>) -> ?*node<T> = { unsafe { return q*.head; } }
queue<T>length: proc<T>(q: *const queue<T>) -> usize = { unsafe { return q*.length; } }

queue<T>create: proc<T>(arena: *memops_arena) -> *queue<T> = { unsafe {
    queue: *queue<T> = cast(memops_arena_push_zero(arena, sizeof(queue<T>), alignof(queue<T>)), *queue<T>);
    if (queue == null) {
        printf("rin runtime: queue allocation failure\n");
        exit(1);
    }
    return queue;
} }

queue<T>enqueue: proc<T>(arena: *memops_arena, queue: *queue<T>, data: T) -> void = {
    node: *node<T> = node<T>create(arena, data);
    if (queue*.head == null) {
        unsafe { queue*.head = node; }
        unsafe { queue*.tail = node; }
        queue*.length = 1;
        return;
    }
    unsafe { queue*.tail*.next = node; }
    unsafe { queue*.tail = node; }
    queue*.length += 1;
}

queue<T>dequeue: proc<T>(arena: *memops_arena, queue: *queue<T>) -> ?*node<T> = {
    if (queue == null || queue*.head == null) {
        return null;
    }
    node: *node<T> = queue*.head;
    unsafe { queue*.head = node*.next; }
    unsafe { node*.next = null; }
    queue*.length -= 1;
    if (queue*.length == 0) {
        unsafe { queue*.tail = null; }
    }
    unsafe { return node; }
}

queue<T>peek: proc<T>(arena: *memops_arena, queue: *queue<T>) -> ?*node<T> = {
    if (queue == null) {
        return null;
    }
    unsafe { return queue*.head; }
}

queue<T>destroy: proc<T>(arena: *memops_arena, queue: *queue<T>) -> void = {
    if (queue != null) {
        unsafe { queue*.head = null; }
        unsafe { queue*.tail = null; }
        queue*.length = 0;
    }
}

queue<T>is_empty: proc<T>(queue: *queue<T>) -> b32 = {
    return queue == null || queue*.length == 0;
}
