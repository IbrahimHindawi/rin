import "memops.rin"
import "node.rin"

queue: struct<T> = {
    head: *node<T>;
    tail: *node<T>;
    length: usize;
}

queue<T>create: proc[trusted]<T>(arena: *memops_arena) -> *queue<T> = {
    queue: *queue<T> = cast(memops_arena_push_zero(arena, sizeof(queue<T>), alignof(queue<T>)), *queue<T>);
    if (queue == null) {
        printf("rin runtime: queue allocation failure\n");
        exit(1);
    }
    return queue;
}

queue<T>enqueue: proc[trusted]<T>(arena: *memops_arena, queue: *queue<T>, data: T) -> void = {
    node: *node<T> = node<T>create(arena, data);
    if (queue*.head == null) {
        queue*.head = node;
        queue*.tail = node;
        queue*.length = 1;
        return;
    }
    queue*.tail*.next = node;
    queue*.tail = node;
    queue*.length += 1;
}

queue<T>dequeue: proc[trusted]<T>(arena: *memops_arena, queue: *queue<T>) -> *node<T> = {
    if (queue == null || queue*.head == null) {
        return null;
    }
    node: *node<T> = queue*.head;
    queue*.head = node*.next;
    node*.next = null;
    queue*.length -= 1;
    if (queue*.length == 0) {
        queue*.tail = null;
    }
    return node;
}

queue<T>peek: proc[trusted]<T>(arena: *memops_arena, queue: *queue<T>) -> *node<T> = {
    if (queue == null) {
        return null;
    }
    return queue*.head;
}

queue<T>destroy: proc[trusted]<T>(arena: *memops_arena, queue: *queue<T>) -> void = {
    if (queue != null) {
        queue*.head = null;
        queue*.tail = null;
        queue*.length = 0;
    }
}

queue<T>is_empty: proc[trusted]<T>(queue: *queue<T>) -> b32 = {
    return queue == null || queue*.length == 0;
}
