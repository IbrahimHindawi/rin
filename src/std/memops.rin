#define max_alloc_size 0x10000000000

cinclude "std/memops_os.h"
cinclude "stdlib.h"
cinclude "stdio.h"
cinclude "string.h"
import "cstd.rin"

memops_os_page_size: proc[external]() -> u64 = {}
memops_os_reserve: proc[external](size: u64) -> *u8 = {}
memops_os_commit: proc[external](ptr: ^void, size: u64) -> ^void = {}
memops_os_debug_break: proc[external]() -> void = {}
memops_os_poison: proc[external](ptr: ^void, size: u64) -> void = {}
memops_os_unpoison: proc[external](ptr: ^void, size: u64) -> void = {}
memops_os_redzone: proc[external]() -> u64 = {}

memops_arena: struct = {
    base: ^u8;
    cursor: ^u8;
    previous: ^u8;
    used: u64;
    pagesize: u64;
    npages: u64;
    reserved: u64; // address space held for the arena; it never grows past this
}

memops_arena_temp: struct = {
    arena: *memops_arena;
    used: u64;
}

/* What n elements of a size come to. A wrapped product would be a small allocation
   with a huge count beside it, so it stops the program, as running out of the
   arena does. */
memops_bytes: proc(size: u64, count: u64) -> u64 = {
    if (size != 0 && count > 0xFFFFFFFFFFFFFFFF / size) {
        unsafe { printf("rin runtime: allocation size overflows\n"); }
        exit(1);
    }
    return size * count;
}

memops_bytes_plus_one: proc(count: u64) -> u64 = {
    if (count == 0xFFFFFFFFFFFFFFFF) {
        unsafe { printf("rin runtime: allocation size overflows\n"); }
        exit(1);
    }
    return count + 1;
}

memops_is_power_of_two: proc(x: usize) -> b32 = {
    return (x & (x - 1)) == 0;
}

memops_align_forward: proc(ptr: usize, align: usize) -> usize = {
    p: usize = ptr;
    a: usize = align;
    modulo: usize = p & (a - 1);
    if (modulo != 0) {
        p += a - modulo;
    }
    return p;
}

/* Reserves address space only; pages are committed as the arena grows. A
   judge that caps address space refuses a reservation that size even though
   none of it is used, so a refusal halves the request until one fits, down to
   a megabyte. `reserved` says what was granted. */
memops_arena_initialize: proc(arena: *memops_arena, reserve: u64 = max_alloc_size) -> void = {
    arena*.pagesize = memops_os_page_size();
    size: u64 = memops_align_forward(cast(reserve, usize), cast(arena*.pagesize, usize));
    unsafe { arena*.base = memops_os_reserve(size); }
    while (arena*.base == null && size > 0x100000) {
        size = memops_align_forward(cast(size / 2, usize), cast(arena*.pagesize, usize));
        unsafe { arena*.base = memops_os_reserve(size); }
    }
    if (arena*.base == null) {
        unsafe { printf("memops_arena could not reserve "); }
        rin_print_u64(reserve);
        unsafe { printf(" bytes!\n"); }
        exit(1);
    }
    arena*.reserved = size;
    arena*.cursor = arena*.base;
    arena*.previous = arena*.base;
    arena*.used = 0;
    arena*.npages = 0;
}

/* `gap` bytes are left poisoned in front of the allocation. */
memops_arena_carve_: proc[unsafe](arena: *memops_arena, alloc_size: u64, align: u64, gap: u64) -> ^void = {
    base_addr: usize = cast(arena*.base, usize);
    curr_addr: usize = base_addr + cast(arena*.used, usize);
    aligned_addr: usize = memops_align_forward(curr_addr + cast(gap, usize), cast(align, usize));
    diff: u64 = cast(aligned_addr - curr_addr, u64);
    committed: u64 = arena*.pagesize * arena*.npages;

    /* Before committing: past the reservation, the commit would be asking for
       pages the arena does not own. Subtracted, not added: a huge size added to
       `used` wraps to a small number and passes. */
    room: u64 = arena*.reserved - arena*.used;
    if (diff > room || alloc_size > room - diff) {
        printf("memops_arena maximum size exceeded!\n");
        exit(1);
    }
    needed: u64 = arena*.used + alloc_size + diff;

    if (needed > committed) {
        missing_bytes: u64 = needed - committed;
        pages_to_commit: u64 = (missing_bytes + arena*.pagesize - 1) / arena*.pagesize;
        commit_addr: usize = base_addr + cast(committed, usize);
        r: ^void = memops_os_commit(cast(commit_addr, ^void), pages_to_commit * arena*.pagesize);
        if (r == null) {
            printf("memops_arena commit failed at %p!\n", cast(commit_addr, ^void));
            memops_os_debug_break();
            exit(1);
        }
        arena*.npages += pages_to_commit;
        memops_os_poison(cast(commit_addr, ^void), pages_to_commit * arena*.pagesize);
    }

    arena*.used += alloc_size + diff;
    arena*.previous = arena*.cursor;
    arena*.cursor = cast(aligned_addr, *u8);
    oldpos: ^void = arena*.cursor;
    arena*.cursor += alloc_size;
    memops_os_unpoison(oldpos, alloc_size);
    return oldpos;
}

memops_arena_push: proc[unsafe](arena: *memops_arena, alloc_size: u64, align: u64) -> ^void = {
    return memops_arena_carve_(arena, alloc_size, align, memops_os_redzone());
}

/* Grows the newest allocation in place: the bytes come straight after it, for a
   builder that wants its pieces contiguous. */
memops_arena_extend: proc[unsafe](arena: *memops_arena, alloc_size: u64) -> ^void = {
    return memops_arena_carve_(arena, alloc_size, 1, 0);
}

/* Everything from `used` to the old head goes back. */
memops_arena_take_back_: proc[unsafe](arena: *memops_arena, old_used: u64) -> void = {
    if (old_used > arena*.used) {
        memops_os_poison(arena*.base + arena*.used, old_used - arena*.used);
    }
}

memops_arena_push_zero: proc[unsafe](arena: *memops_arena, alloc_size: u64, align: u64) -> ^void = {
    p: ^void = memops_arena_push(arena, alloc_size, align);
    memset(p, 0, alloc_size);
    return p;
}

memops_arena_get_pos: proc(arena: *memops_arena) -> ^void = {
    unsafe { return arena*.base + arena*.used; }
}

memops_arena_set_pos: proc[unsafe](arena: *memops_arena, pos: ^void) -> ^void = {
    old_used: u64 = arena*.used;
    arena*.cursor = cast(pos, *u8);
    arena*.used = cast(arena*.cursor - arena*.base, u64);
    memops_arena_take_back_(arena, old_used);
    return arena*.cursor;
}

memops_arena_pop: proc[unsafe](arena: *memops_arena, alloc_size: u64) -> ^void = {
    old_used: u64 = arena*.used;
    arena*.cursor -= alloc_size;
    arena*.used -= alloc_size;
    memops_arena_take_back_(arena, old_used);
    return arena*.cursor;
}

memops_arena_realloc_: proc[unsafe](arena: *memops_arena, new_alloc_size: u64, old_ptr: ^void, old_alloc_size: u64, align: u64) -> ^void = {
    new_ptr: ^void = memops_arena_push(arena, new_alloc_size, align);
    memcpy(new_ptr, old_ptr, old_alloc_size);
    return new_ptr;
}

memops_arena_clear: proc[unsafe](arena: *memops_arena) -> void = {
    old_used: u64 = arena*.used;
    arena*.cursor = arena*.base;
    arena*.used = 0;
    memops_arena_take_back_(arena, old_used);
}

memops_arena_temp_begin: proc[unsafe](arena: *memops_arena) -> memops_arena_temp = {
    t: memops_arena_temp = {};
    t.arena = arena;
    t.used = arena*.used;
    return t;
}

memops_arena_temp_end: proc[unsafe](temp: memops_arena_temp) -> void = {
    old_used: u64 = temp.arena*.used;
    temp.arena*.used = temp.used;
    temp.arena*.cursor = temp.arena*.base + temp.used;
    memops_arena_take_back_(temp.arena, old_used);
}
