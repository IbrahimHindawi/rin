cinclude "stdio.h"
import "cstd.rin"
import "reflect.rin"

print_cstr: proc[trusted](text: ^const char) -> void = {
    if (text == null) {
        printf("(null)");
        return;
    }
    printf("%s", text);
}

print: proc[trusted]<i8>(x: i8) -> void = {
    printf("%d", x);
}

print: proc[trusted]<i16>(x: i16) -> void = {
    printf("%d", x);
}

print: proc[trusted]<i32>(x: i32) -> void = {
    printf("%d", x);
}

print: proc[trusted]<i64>(x: i64) -> void = {
    rin_print_i64(x);
}

print: proc[trusted]<u8>(x: u8) -> void = {
    printf("%u", x);
}

print: proc[trusted]<u16>(x: u16) -> void = {
    printf("%u", x);
}

print: proc[trusted]<u32>(x: u32) -> void = {
    printf("%u", x);
}

print: proc[trusted]<u64>(x: u64) -> void = {
    rin_print_u64(x);
}

print: proc[trusted]<usize>(x: usize) -> void = {
    printf("%zu", x);
}

print: proc[trusted]<f32>(x: f32) -> void = {
    printf("%f", cast(x, f64));
}

print: proc[trusted]<f64>(x: f64) -> void = {
    printf("%f", x);
}

print: proc[trusted]<char>(x: char) -> void = {
    printf("%c", x);
}

print: proc[trusted]<b32>(x: b32) -> void = {
    if (x) {
        print_cstr("true");
    } else {
        print_cstr("false");
    }
}

print: proc[trusted]<^char>(x: ^char) -> void = {
    print_cstr(x);
}

print: proc[trusted]<^const char>(x: ^const char) -> void = {
    print_cstr(x);
}

// What printfmt prints for an enum with no print<E> of its own: the member's
// name, or `type(value)` when the value is not a member -- one read from a
// file or a cast, say -- so a miss still says which enum and what it held.
print_enum: proc[trusted](type: *const reflect, value: i32) -> void = {
    name: ^const char = reflect_name_from_value(type, value);
    if (name != null) {
        printf("%s", name);
        return;
    }
    printf("%s(%d)", type*.name, value);
}
