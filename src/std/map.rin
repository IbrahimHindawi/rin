import "memops.rin"

#define I_RUNTIME_FNV_OFFSET 14695981039346656037ULL
#define I_RUNTIME_FNV_PRIME 1099511628211ULL
#define I_RUNTIME_MAP_INITIAL_CAPACITY 512

map_entry: struct<T> = {
    key: ^const char;
    val: T;
}

map: struct<T> = {
    entries: ^map_entry<T>;
    length: usize;
    border: usize;
    /* Set by map<T>make; see list.rin. */
    arena: ^memops_arena;
}

map_iterator: struct<T> = {
    key: ^const char;
    val: T;
    _hashmap: *map<T>;
    _index: usize;
}

runtime_cstr_copy: proc[trusted](arena: *memops_arena, key: ^const char) -> ^const char = {
    if (key == null) {
        return null;
    }
    byte_count: usize = strlen(key) + 1;
    copy: ^char = cast(memops_arena_push(arena, byte_count, alignof(char)), ^char);
    if (copy == null) {
        printf("rin runtime: cstring allocation failure\n");
        exit(1);
    }
    memcpy(copy, key, byte_count);
    return copy;
}

map_hash_key: proc[trusted](key: ^const char) -> u64 = {
    hash: u64 = I_RUNTIME_FNV_OFFSET;
    p: ^const char = key;
    if (p == null) {
        return 0;
    }
    while (p[0] != 0) {
        hash = hash ^ cast(cast(p[0], u8), u64);
        hash *= I_RUNTIME_FNV_PRIME;
        p += 1;
    }
    return hash;
}

map<T>set_entry: proc[trusted]<T>(arena: *memops_arena, entries: ^map_entry<T>, border: usize, key: ^const char, val: T, plength: *usize) -> ^const char = {
    hash: u64 = map_hash_key(key);
    index: usize = cast(hash & cast(border - 1, u64), usize);
    while (entries[index].key != null) {
        if (strcmp(key, entries[index].key) == 0) {
            entries[index].val = val;
            return entries[index].key;
        }
        index += 1;
        if (index >= border) {
            index = 0;
        }
    }
    stored_key: ^const char = key;
    if (plength != null) {
        stored_key = runtime_cstr_copy(arena, key);
        if (stored_key == null) {
            return null;
        }
        plength* += 1;
    }
    entries[index].key = stored_key;
    entries[index].val = val;
    return stored_key;
}

map<T>expand: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>) -> b32 = {
    new_capacity: usize = hashmap*.border * 2;
    if (new_capacity < hashmap*.border) {
        return 0;
    }
    new_entries: *map_entry<T> = cast(memops_arena_push_zero(arena, sizeof(map_entry<T>) * new_capacity, alignof(map_entry<T>)), *map_entry<T>);
    if (new_entries == null) {
        return 0;
    }
    for (i: usize = 0; i < hashmap*.border; i += 1) {
        entry: map_entry<T> = hashmap*.entries[i];
        if (entry.key != null) {
            map<T>set_entry(arena, new_entries, new_capacity, entry.key, entry.val, null);
        }
    }
    hashmap*.entries = new_entries;
    hashmap*.border = new_capacity;
    return 1;
}

map<T>create: proc[trusted]<T>(arena: *memops_arena) -> *map<T> = {
    hashmap: *map<T> = cast(memops_arena_push_zero(arena, sizeof(map<T>), alignof(map<T>)), *map<T>);
    if (hashmap == null) {
        printf("rin runtime: map allocation failure\n");
        exit(1);
    }
    hashmap*.length = 0;
    hashmap*.border = I_RUNTIME_MAP_INITIAL_CAPACITY;
    hashmap*.entries = cast(memops_arena_push_zero(arena, sizeof(map_entry<T>) * hashmap*.border, alignof(map_entry<T>)), *map_entry<T>);
    if (hashmap*.entries == null) {
        printf("rin runtime: map entries allocation failure\n");
        exit(1);
    }
    return hashmap;
}

map<T>make: proc[trusted]<T>(r: region R) -> *map<T> in R = {
    m: *map<T> in R = cast(memops_arena_push_zero(r, sizeof(map<T>), alignof(map<T>)), *map<T> in R);
    m*.arena = r;
    m*.border = I_RUNTIME_MAP_INITIAL_CAPACITY;
    m*.entries = cast(memops_arena_push_zero(r, sizeof(map_entry<T>) * m*.border, alignof(map_entry<T>)), *map_entry<T>);
    if (m*.entries == null) {
        printf("rin runtime: map entries allocation failure\n");
        exit(1);
    }
    return m;
}

map<T>arena_of: proc[trusted]<T>(m: *const map<T>) -> *memops_arena = {
    if (m*.arena == null) {
        printf("rin runtime: map used without an arena; make it with map<T>make\n");
        exit(1);
    }
    return m*.arena[0]&;
}

/* put, find and count: the arena-free forms for a map made by map<T>make. */
map<T>put: proc[trusted]<T>(m: *map<T>, key: ^const char, val: T) -> void = { _ = map<T>set(map<T>arena_of(m), m, key, val); }
map<T>find: proc[trusted]<T>(m: *const map<T>, key: ^const char) -> ?*T = {
    if (m*.entries == null || m*.border == 0) {
        return null;
    }
    hash: u64 = map_hash_key(key);
    index: usize = cast(hash & cast(m*.border - 1, u64), usize);
    while (m*.entries[index].key != null) {
        if (strcmp(key, m*.entries[index].key) == 0) {
            return m*.entries[index].val&;
        }
        index += 1;
        if (index >= m*.border) {
            index = 0;
        }
    }
    return null;
}
map<T>count: proc[trusted]<T>(m: *const map<T>) -> usize = { return m*.length; }

map<T>destroy: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>) -> void = {
    if (hashmap != null) {
        hashmap*.entries = null;
        hashmap*.length = 0;
        hashmap*.border = 0;
    }
}

map<T>get: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>, key: ^const char) -> ?*T = {
    if (hashmap == null || hashmap*.entries == null || hashmap*.border == 0) {
        return null;
    }
    hash: u64 = map_hash_key(key);
    index: usize = cast(hash & cast(hashmap*.border - 1, u64), usize);
    while (hashmap*.entries[index].key != null) {
        if (strcmp(key, hashmap*.entries[index].key) == 0) {
            return hashmap*.entries[index].val&;
        }
        index += 1;
        if (index >= hashmap*.border) {
            index = 0;
        }
    }
    return null;
}

map<T>set: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>, key: ^const char, val: T) -> ^const char = {
    if (hashmap*.length >= hashmap*.border / 2) {
        if (!map<T>expand(arena, hashmap)) {
            return null;
        }
    }
    return map<T>set_entry(arena, hashmap*.entries, hashmap*.border, key, val, hashmap*.length&);
}

map<T>try_emplace: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>, key: ^const char, val: T) -> *T = {
    result: *T = map<T>get(arena, hashmap, key);
    if (result == null) {
        map<T>set(arena, hashmap, key, val);
        result = map<T>get(arena, hashmap, key);
    }
    return result;
}

map<T>length: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>) -> usize = {
    if (hashmap == null) {
        return 0;
    }
    return hashmap*.length;
}

map_iterator<T>create: proc[trusted]<T>(arena: *memops_arena, hashmap: *map<T>) -> map_iterator<T> = {
    it: map_iterator<T> = {};
    it._hashmap = hashmap;
    it._index = 0;
    return it;
}

map_iterator<T>next: proc[trusted]<T>(arena: *memops_arena, it: *map_iterator<T>) -> b32 = {
    hashmap: *map<T> = it*._hashmap;
    if (hashmap == null) {
        return 0;
    }
    while (it*._index < hashmap*.border) {
        i: usize = it*._index;
        it*._index += 1;
        if (hashmap*.entries[i].key != null) {
            entry: map_entry<T> = hashmap*.entries[i];
            it*.key = entry.key;
            it*.val = entry.val;
            return 1;
        }
    }
    return 0;
}
