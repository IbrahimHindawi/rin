import "memops.rin"
import "cstd.rin"

/* A double-ended queue in a ring buffer: push and pop at either end in O(1),
   and index from the front. A zeroed deque is empty. Unlike `queue`, which
   allocates a node per element, this is one growing block, so it suits BFS
   frontiers and sliding windows. */

deque: struct<T> = {
    data: ^T;
    head: u64;
    length: u64;
    border: u64;
}

deque<T>grow: proc[trusted]<T>(arena: *memops_arena, d: *deque<T>) -> void = {
    border: u64 = d*.border == 0 ? 16 : d*.border * 2;
    data: ^T = cast(memops_arena_push(arena, sizeof(T) * border, alignof(T)), ^T);
    if (data == null) {
        printf("rin runtime: deque allocation failure\n");
        exit(1);
    }
    for (i: u64 = 0; i < d*.length; i += 1) {
        data[i] = d*.data[(d*.head + i) % d*.border];
    }
    d*.data = data;
    d*.head = 0;
    d*.border = border;
}

deque<T>push_back: proc[trusted]<T>(arena: *memops_arena, d: *deque<T>, x: T) -> void = {
    if (d*.length == d*.border) {
        deque<T>grow(arena, d);
    }
    d*.data[(d*.head + d*.length) % d*.border] = x;
    d*.length += 1;
}

deque<T>push_front: proc[trusted]<T>(arena: *memops_arena, d: *deque<T>, x: T) -> void = {
    if (d*.length == d*.border) {
        deque<T>grow(arena, d);
    }
    d*.head = (d*.head + d*.border - 1) % d*.border;
    d*.data[d*.head] = x;
    d*.length += 1;
}

deque<T>at: proc[trusted]<T>(d: *deque<T>, index: u64) -> *T = {
    if (index >= d*.length) {
        printf("rin runtime: deque index out of bounds\n");
        exit(1);
    }
    return d*.data[(d*.head + index) % d*.border]&;
}

deque<T>front: proc[trusted]<T>(d: *deque<T>) -> T = {
    return deque<T>at(d, 0)*;
}

deque<T>back: proc[trusted]<T>(d: *deque<T>) -> T = {
    if (d*.length == 0) {
        printf("rin runtime: deque back on an empty deque\n");
        exit(1);
    }
    return deque<T>at(d, d*.length - 1)*;
}

deque<T>pop_front: proc[trusted]<T>(d: *deque<T>) -> T = {
    x: T = deque<T>front(d);
    d*.head = (d*.head + 1) % d*.border;
    d*.length -= 1;
    return x;
}

deque<T>pop_back: proc[trusted]<T>(d: *deque<T>) -> T = {
    x: T = deque<T>back(d);
    d*.length -= 1;
    return x;
}

deque<T>is_empty: proc[trusted]<T>(d: *deque<T>) -> b32 = {
    return d*.length == 0;
}

deque<T>clear: proc[trusted]<T>(d: *deque<T>) -> void = {
    d*.head = 0;
    d*.length = 0;
}
