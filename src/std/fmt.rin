import "memops.rin"
import "string8.rin"
import "cstr.rin"

/* A bounded writer over a buffer the caller owns.

   This exists to replace snprintf into a fixed `[N]char`, which is what almost
   all of it is used for. The shape is deliberately not a format string: there
   is no varargs, no parsing at runtime, and every value is written by a proc
   that knows its type. Truncation follows snprintf -- writing stops at the
   capacity and the result is always NUL-terminated -- and `truncated` records
   whether anything was lost, which snprintf only tells you by comparing its
   return against the size you passed.

   `fmt_to` takes the buffer as a slice, so its size travels with it: an array
   converts with its length from its type, `fmt_to(line)`, and part of one is a
   subrange, `fmt_to(out[0..4])`. `capacity` counts the terminator. */
fmt: struct = {
    data: ^c8;
    capacity: u64;
    length: u64;
    truncated: b32;
}

fmt_to: proc[unsafe](buf: []c8) -> fmt = {
    f: fmt = {};
    f.data = buf.data;
    f.capacity = buf.length;
    f.length = 0;
    f.truncated = 0;
    if (buf.data != null && buf.length > 0) {
        buf[0] = 0;
    }
    return f;
}

/* A formatter that lives in a region, for safe code: its buffer comes from
   the region's arena, and the text is always NUL-terminated. */
fmt_make: proc(r: region R, capacity: u64) -> *fmt in R = { unsafe {
    f: *fmt in R = cast(memops_arena_push_zero(r, sizeof(fmt), alignof(fmt)), *fmt in R);
    if (capacity == 0) { capacity = 1; }
    f*.data = cast(memops_arena_push_zero(r, capacity, 1), ^c8);
    f*.capacity = capacity;
    return f;
} }

/* Back to empty, keeping the buffer. */
fmt_reset: proc(f: *fmt) -> void = {
    f*.length = 0;
    f*.truncated = 0;
    if (f*.data != null && f*.capacity > 0) {
        unsafe { f*.data[0] = 0; }
    }
}

/* The text so far, NUL-terminated; good until the next write. */
fmt_text: proc(f: *const fmt) -> ^const c8 = {
    return f*.data;
}

fmt_remaining: proc(f: *const fmt) -> u64 = {
    if (f*.data == null || f*.capacity == 0) {
        return 0;
    }
    /* One byte is always held back for the terminator. */
    if (f*.length + 1 >= f*.capacity) {
        return 0;
    }
    return f*.capacity - f*.length - 1;
}

fmt_char: proc(f: *fmt, c: c8) -> void = {
    if (fmt_remaining(f) == 0) {
        f*.truncated = 1;
        return;
    }
    unsafe { f*.data[f*.length] = c; }
    f*.length += 1;
    unsafe { f*.data[f*.length] = 0; }
}

fmt_bytes: proc[unsafe](f: *fmt, src: ^const c8, count: u64) -> void = {
    if (src == null || count == 0) {
        return;
    }
    room: u64 = fmt_remaining(f);
    n: u64 = count;
    if (n > room) {
        n = room;
        f*.truncated = 1;
    }
    /* room is 0 for a null buffer and for a zero capacity, and in both cases
       there is nowhere to put the terminator either -- writing it anyway
       dereferenced null. */
    if (n == 0) {
        return;
    }
    for (i: u64 = 0; i < n; i += 1) {
        f*.data[f*.length + i] = src[i];
    }
    f*.length += n;
    f*.data[f*.length] = 0;
}

fmt_cstr: proc(f: *fmt, s: ^const c8) -> void = {
    chars: []const c8 = cstr_view(s);
    for (i: u64 = 0; i < chars.length; i += 1) {
        fmt_char(f, chars[i]);
    }
}

fmt_slice: proc[unsafe](f: *fmt, s: string8slice) -> void = {
    unsafe { fmt_bytes(f, cast(s.data, ^const c8), s.length); }
}

/* Left-justified in a field of `width`, like %-24s. Longer input is written in
   full rather than truncated, which is what printf does too. */
fmt_cstr_pad: proc(f: *fmt, s: ^const c8, width: u64) -> void = {
    n: u64 = cstr_view(s).length;
    fmt_cstr(f, s);
    while (n < width) {
        fmt_char(f, cast(32, c8));
        n += 1;
    }
}

/* A number's decimal digits, least significant first, and how many. */
fmt_digits_: proc[static](digits: []c8, value: u64) -> u64 = {
    n: u64 = 0;
    v: u64 = value;
    if (v == 0) {
        digits[0] = cast(48, c8);
        n = 1;
    }
    while (v > 0) {
        digits[n] = cast(48 + cast(v % 10, i32), c8);
        v /= 10;
        n += 1;
    }
    return n;
}

/* Digits come out backwards, so they are staged and then written from the most
   significant -- a truncated number keeps its most significant digits. */
fmt_u64: proc(f: *fmt, value: u64) -> void = {
    digits: [24]c8 = {};
    n: u64 = fmt_digits_(digits, value);
    for (i: u64 = n; i > 0; i -= 1) {
        fmt_char(f, digits[i - 1]);
    }
}

fmt_i64: proc(f: *fmt, value: i64) -> void = {
    if (value < 0) {
        fmt_char(f, cast(45, c8));
        /* Negating the most negative value overflows, so widen first. */
        fmt_u64(f, cast(0, u64) - cast(value, u64));
        return;
    }
    fmt_u64(f, cast(value, u64));
}

fmt_hex: proc(f: *fmt, value: u64, min_digits: u64, upper: b32) -> void = {
    digits: [24]c8 = {};
    n: u64 = 0;
    v: u64 = value;
    if (v == 0) {
        digits[0] = cast(48, c8);
        n = 1;
    }
    while (v > 0) {
        d: u64 = v % 16;
        if (d < 10) {
            digits[n] = cast(48 + cast(d, i32), c8);
        } else if (upper != 0) {
            digits[n] = cast(55 + cast(d, i32), c8);
        } else {
            digits[n] = cast(87 + cast(d, i32), c8);
        }
        v /= 16;
        n += 1;
    }
    while (n < min_digits && n < 24) {
        digits[n] = cast(48, c8);
        n += 1;
    }
    for (i: u64 = n; i > 0; i -= 1) {
        fmt_char(f, digits[i - 1]);
    }
}

/* A whole number too big for a u64, every digit of it. Dividing a float by 2^32 is
   exact, and so is taking the whole part back off, so nothing here rounds. */
fmt_f64_big: proc(f: *fmt, value: f64) -> void = {
    limit: f64 = 4294967296.0;
    limbs: [34]u32 = {};
    count: u64 = 0;
    v: f64 = value;
    while (v >= 1.0 && count < 34) {
        whole: f64 = v / limit;
        if (whole < 9007199254740992.0) {
            whole = cast(cast(whole, u64), f64);
        }
        limbs[count] = cast(v - whole * limit, u32);
        count += 1;
        v = whole;
    }
    /* Then to base 10^9, least significant first. */
    chunks: [36]u32 = {};
    chunk_count: u64 = 0;
    while (count > 0 && chunk_count < 36) {
        rest: u64 = 0;
        for (i: u64 = count; i > 0; i -= 1) {
            current: u64 = (rest shl 32) + cast(limbs[i - 1], u64);
            limbs[i - 1] = cast(current / 1000000000, u32);
            rest = current % 1000000000;
        }
        chunks[chunk_count] = cast(rest, u32);
        chunk_count += 1;
        while (count > 0 && limbs[count - 1] == 0) {
            count -= 1;
        }
    }
    fmt_u64(f, cast(chunks[chunk_count - 1], u64));
    for (i: u64 = chunk_count - 1; i > 0; i -= 1) {
        place: u64 = 100000000;
        chunk: u64 = cast(chunks[i - 1], u64);
        while (place > 0) {
            fmt_char(f, cast(48 + cast((chunk / place) % 10, i32), c8));
            place /= 10;
        }
    }
}

/* Fixed-point, which is all the call sites need -- %.2f and friends. Not a
   general float formatter: there is no exponent form, and past 18 decimals
   the rest are zeros. */
fmt_f64: proc(f: *fmt, value: f64, decimals: u64) -> void = {
    v: f64 = value;
    if (v != v) {
        fmt_char(f, cast(110, c8));
        fmt_char(f, cast(97, c8));
        fmt_char(f, cast(110, c8));
        return;
    }
    if (v < 0.0) {
        fmt_char(f, cast(45, c8));
        v = -v;
    }
    if (v > 1.7976931348623157e308) {
        fmt_char(f, cast(105, c8));
        fmt_char(f, cast(110, c8));
        fmt_char(f, cast(102, c8));
        return;
    }
    if (v >= 18446744073709551616.0) {
        fmt_f64_big(f, v);
        if (decimals > 0) {
            fmt_char(f, cast(46, c8));
            for (i: u64 = 0; i < decimals; i += 1) {
                fmt_char(f, cast(48, c8));
            }
        }
        return;
    }
    /* 10^18 is the last power of ten that leaves room to round in a u64. */
    exact: u64 = decimals;
    if (exact > 18) {
        exact = 18;
    }
    scale: u64 = 1;
    for (i: u64 = 0; i < exact; i += 1) {
        scale *= 10;
    }
    whole: u64 = cast(v, u64);
    frac: f64 = v - cast(whole, f64);
    scaled: u64 = cast(frac * cast(scale, f64) + 0.5, u64);
    if (scaled >= scale) {
        whole += 1;
        scaled -= scale;
    }
    fmt_u64(f, whole);
    if (decimals == 0) {
        return;
    }
    fmt_char(f, cast(46, c8));
    /* Leading zeros of the fraction are significant. */
    place: u64 = scale / 10;
    while (place > 0) {
        fmt_char(f, cast(48 + cast((scaled / place) % 10, i32), c8));
        place /= 10;
    }
    for (i: u64 = exact; i < decimals; i += 1) {
        fmt_char(f, cast(48, c8));
    }
}

/* Length written, not counting the terminator. */
fmt_done: proc(f: *const fmt) -> u64 = {
    return f*.length;
}

fmt_truncated: proc(f: *const fmt) -> b32 = {
    return f*.truncated;
}

/* One char into dst at `at`, terminated, holding one byte back for the terminator as a fmt does. */
fmt_put_: proc[static](dst: []c8, at: u64, c: c8) -> u64 = {
    if (at + 1 >= dst.length) {
        return at;
    }
    dst[at] = c;
    dst[at + 1] = 0;
    return at + 1;
}

/* Expands a format string held in data, which is the one case a call site
   cannot be rewritten into explicit calls: the format arrives from a table.
   Only "%d" is recognised, because that is the only conversion those tables
   use; anything else is copied through verbatim so a stray "%s" shows up in
   the output rather than reading a stack slot that was never passed. */
fmt_expand_i64: proc(dst: []c8, format: ^const c8, value: i64) -> u64 = {
    if (dst.length > 0) {
        dst[0] = 0;
    }
    text: []const c8 = cstr_view(format);
    n: u64 = 0;
    i: u64 = 0;
    while (i < text.length) {
        if (text[i] == cast(37, c8) && i + 1 < text.length && text[i + 1] == cast(100, c8)) {
            /* Negating the most negative value overflows, so widen first. */
            whole: u64 = cast(value, u64);
            if (value < 0) {
                n = fmt_put_(dst, n, cast(45, c8));
                whole = cast(0, u64) - whole;
            }
            digits: [24]c8 = {};
            count: u64 = fmt_digits_(digits, whole);
            for (k: u64 = count; k > 0; k -= 1) {
                n = fmt_put_(dst, n, digits[k - 1]);
            }
            i += 2;
        } else {
            n = fmt_put_(dst, n, text[i]);
            i += 1;
        }
    }
    return n;
}

/* The dominant snprintf shape by a wide margin is literal fragments joined with
   strings -- "res/fx/%s.json", "%s/%s", "res/%s/mesh/%s.gltf". These cover it
   without a builder at the call site. Each returns the length written. */
fmt_cat_more_: proc[static](dst: []c8, at: u64, s: ^const c8) -> u64 = {
    return at + cstr_copy(dst[at..dst.length], s);
}

fmt_cat1: proc(dst: []c8, a: ^const c8) -> u64 = {
    return fmt_cat_more_(dst, 0, a);
}

fmt_cat2: proc(dst: []c8, a: ^const c8, b: ^const c8) -> u64 = {
    return fmt_cat_more_(dst, fmt_cat1(dst, a), b);
}

fmt_cat3: proc(dst: []c8, a: ^const c8, b: ^const c8, c: ^const c8) -> u64 = {
    return fmt_cat_more_(dst, fmt_cat2(dst, a, b), c);
}

fmt_cat4: proc(dst: []c8, a: ^const c8, b: ^const c8, c: ^const c8, d: ^const c8) -> u64 = {
    return fmt_cat_more_(dst, fmt_cat3(dst, a, b, c), d);
}

fmt_cat5: proc(dst: []c8, a: ^const c8, b: ^const c8, c: ^const c8, d: ^const c8, e: ^const c8) -> u64 = {
    return fmt_cat_more_(dst, fmt_cat4(dst, a, b, c, d), e);
}
