import "memops.rin"
import "option.rin"

vec: struct<T> = {
    data: ^T;
    length: u64;
    border: u64;
    /* Set by vec<T>make: the arena the vec grows into, so vec<T>push needs
       none handed to it. Null for a vec made the old way, by value. */
    arena: ^memops_arena;
}

vec<T>reserve: proc[unsafe]<T>(arena: *memops_arena, length: u64) -> vec<T> = {
    arr: vec<T> = {};
    if (length == 0) {
        return arr;
    }
    arr.data = cast(memops_arena_push_zero(arena, memops_bytes(sizeof(T), length), alignof(T)), *T);
    if (arr.data == null) {
        printf("rin runtime: vec reserve allocation failure\n");
        exit(1);
        return arr;
    }
    arr.border = length;
    return arr;
}

/* A vec that lives in a region, for safe code: the header and its storage both
   come from the region's arena, so a `*vec<T> in R` points into R and nothing
   in it outlives R. Grows into the same arena. */
vec<T>make: proc<T>(r: region R, reserve: u64) -> *vec<T> in R = { unsafe {
    v: *vec<T> in R = cast(memops_arena_push_zero(r, sizeof(vec<T>), alignof(vec<T>)), *vec<T> in R);
    v*.arena = r;
    if (reserve > 0) {
        v*.data = cast(memops_arena_push_zero(r, memops_bytes(sizeof(T), reserve), alignof(T)), *T);
        v*.border = reserve;
    }
    return v;
} }
/* Push onto a vec made by vec<T>make: it grows into the arena it was made
   from. The pointer returned is borrowed; it is stale after the next push. */
vec<T>push: proc<T>(array: *vec<T>, elem: T) -> *T = {
    if (array*.arena == null) {
        unsafe { printf("rin runtime: vec push on a vec not made by vec<T>make\n"); }
        exit(1);
    }
    unsafe { return vec<T>append(array*.arena[0]&, array, elem); }
}
vec<T>destroy: proc[unsafe]<T>(arena: *memops_arena, array: *vec<T>) -> void = {
    array*.data = null;
    array*.length = 0;
    array*.border = 0;
}

vec<T>resize: proc[unsafe]<T>(arena: *memops_arena, array: *vec<T>) -> ^T = {
    old_border: u64 = array*.border;
    if (array*.border == 0) {
        array*.border = 1;
    } else {
        array*.border *= 2;
    }
    unsafe { array*.data = cast(memops_arena_realloc_(arena, memops_bytes(sizeof(T), array*.border), array*.data, sizeof(T) * old_border, alignof(T)), *T); }
    if (array*.data == null) {
        unsafe { printf("rin runtime: vec resize allocation failure\n"); }
        exit(1);
    }
    if (array*.border > old_border) {
        unsafe { memset(cast(array*.data, ^u8) + sizeof(T) * old_border, 0, sizeof(T) * (array*.border - old_border)); }
    }
    return array*.data;
}

vec<T>append: proc[unsafe]<T>(arena: *memops_arena, array: *vec<T>, elem: T) -> *T = {
    if (array*.data == null) {
        array*.border = 1;
        array*.data = cast(memops_arena_push(arena, memops_bytes(sizeof(T), array*.border), alignof(T)), *T);
    }
    if (array*.length >= array*.border) {
        vec<T>resize(arena, array);
    }
    array*.data[array*.length] = elem;
    result: *T = array*.data[array*.length]&;
    array*.length += 1;
    return result;
}

vec<T>at: proc[no_move]<T>(array: *vec<T>, index: u64) -> *T = {
    if (array == null || index >= array*.length) {
        unsafe { printf("rin runtime: vec index out of bounds\n"); }
        exit(1);
    }
    unsafe { return array*.data[index]&; }
}

vec<T>at_const: proc<T>(array: *const vec<T>, index: u64) -> *const T = {
    if (array == null || index >= array*.length) {
        unsafe { printf("rin runtime: vec index out of bounds\n"); }
        exit(1);
    }
    unsafe { return array*.data[index]&; }
}

vec<T>get: proc<T>(array: *const vec<T>, index: u64) -> option<T> = {
    if (array == null || index >= array*.length) {
        return option<T>none();
    }
    unsafe { return option<T>some(array*.data[index]); }
}

vec<T>last: proc[no_move]<T>(array: *vec<T>) -> *T = {
    if (array == null || array*.length == 0) {
        unsafe { printf("rin runtime: vec last on an empty vec\n"); }
        exit(1);
    }
    unsafe { return array*.data[array*.length - 1]&; }
}

vec<T>last_const: proc<T>(array: *const vec<T>) -> *const T = {
    if (array == null || array*.length == 0) {
        unsafe { printf("rin runtime: vec last on an empty vec\n"); }
        exit(1);
    }
    unsafe { return array*.data[array*.length - 1]&; }
}

vec<T>pop: proc<T>(array: *vec<T>) -> T = {
    x: T = vec<T>last(array)*;
    array*.length -= 1;
    return x;
}

// The elements as a slice, valid until the next append moves them.
vec<T>items: proc[no_move]<T>(array: *vec<T>) -> []T = {
    if (array*.data == null) {
        empty: []T = {};
        return empty;
    }
    unsafe { return array*.data[0..array*.length]; }
}

vec<T>items_const: proc<T>(array: *const vec<T>) -> []const T = {
    if (array*.data == null) {
        empty: []const T = {};
        return empty;
    }
    unsafe { return array*.data[0..array*.length]; }
}

vec<T>clear: proc<T>(array: *vec<T>) -> void = {
    if (array != null) {
        array*.length = 0;
    }
}

vec<T>is_empty: proc<T>(array: *const vec<T>) -> b32 = {
    return array == null || array*.length == 0;
}
