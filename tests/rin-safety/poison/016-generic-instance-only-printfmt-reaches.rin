// expect: index
import "std/print.rin"
box: struct<T> = { x: T; }
print: proc<box<T>>(b: box<T>) -> void = {
    a: [4]i32 = {};
    i: u64 = cast(b.x, u64);
    a[i] = 1234;
    print<i32>(a[i]);
}
main: proc() -> i32 = {
    b: box<i32> = { .x = 100000 };
    printfmt("{}\n", b);
    return 0;
}
