// expect: out of bounds
import "std/print.rin"

/* The check itself; the runner also builds this one the way a Release build does. */
level: region;
main: proc() -> i32 = {
    n: u64 = 2000;
    level: region = {
        xs: []i32 in level = new_slice<i32>(level, 3);
        xs[n] = 5;
        printfmt("{}\n", xs[n]);
    }
    return 0;
}
