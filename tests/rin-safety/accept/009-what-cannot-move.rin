import "std/print.rin"

/* A handle from a raw name is no borrow of the name. */
H: struct = { x: i32; }
g_h: H = {};
open: proc(path: ^const char) -> *H = { unsafe { return g_h&; } }
wr: proc(f: *H) -> void = { unsafe { f*.x += 1; } }
save: proc(path: ^const char) -> i32 = {
    f: *H = open(path);
    wr(f);
    wr(f);
    return f*.x;
}

/* A proc handed plain data can overwrite it and can move nothing. */
T: struct = { a: i32; b: [2]f32; }
g_arr: [4]T = {};
set_a: proc(out: *i32) -> void = { unsafe { out* = 5; } }
hit: proc(t: *T) -> void = { unsafe { t*.a += 1; } }
fill: proc(xs: []i32) -> void = { unsafe { xs[0] = 3; } }
elements: proc() -> i32 = {
    x: *T = g_arr[0]&;
    y: *T = g_arr[1]&;
    set_a(y*.a&);
    hit(x);
    return x*.a + y*.a;
}
slices: proc() -> i32 = {
    xs: [3]i32 = { 0, 0, 0 };
    head: []i32 = xs[0..2];
    fill(xs);
    return head[0];
}

main: proc() -> i32 = {
    printfmt("{}\n", save("a"));
    printfmt("{}\n", elements());
    printfmt("{}\n", slices());
    return 0;
}
