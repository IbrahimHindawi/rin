import "std/print.rin"

/* Plain data, no globals, callees that do the same: safe to call, because the
   parameters are the only way in and the check on entry compares them. */
scale: proc(x: f32, k: f32) -> f32 = { return x * k; }
sqrtf: proc[external](x: f32) -> f32 = {}
move: proc(ps: noalias []f32, vs: []const f32, dt: f32) -> void = {
    for (i: u64 = 0; i < ps.length; i += 1) { ps[i] += scale(vs[i], dt) + sqrtf(0.0); }
}
add: proc(a: noalias *i32, b: *const i32) -> i32 = { a* += b*; return a*; }

/* A const global reaches nothing anyone writes. */
factor: const i32 = 3;
times: proc(a: noalias *i32) -> i32 = { a* *= factor; return a*; }

/* Not vouched for, but the promise can be made by hand. */
g: i32 = 0;
via_global: proc(a: noalias *i32) -> i32 = { a* = 1; g = 2; return a*; }

level: region;
main: proc() -> i32 = {
    level: region = {
        ps: []f32 in level = new_slice<f32>(level, 4);
        vs: []f32 in level = new_slice<f32>(level, 4);
        vs[3] = 2.0;
        move(ps, vs, 0.5);
        printfmt("{}\n", ps[3]);
    }
    x: i32 = 2;
    y: i32 = 5;
    printfmt("{}\n", add(x&, y&));
    printfmt("{}\n", times(x&));
    r: i32 = 0;
    unsafe { r = via_global(y&); }
    printfmt("{} {}\n", r, g);
    return 0;
}
