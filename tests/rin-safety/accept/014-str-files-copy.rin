import "std/print.rin"
import "std/file.rin"
import "std/slice.rin"

/* A str is kept anywhere: a global, a field held by value, an array. */
kind: struct = { name: str; hits: i32; }
g_kinds: [2]kind = { { .name = "imp", .hits = 1 }, { .name = "ogre", .hits = 2 } };
g_names: [2]str = { "a", "b" };
pick: proc(i: i32) -> str = { return i == 0 ? "zero" : "other"; }

files: proc() -> void = {
    path: str = "build/rin_safety/014.tmp";
    w: file = file_open(path, "wb");
    if (!file_is_open(w)) { printfmt("no file\n"); return; }
    fprintfmt(w, "{} {:.2} {}\n", 7, 1.5, "text");
    file_write_text(w, "more\n");
    copy_of_w: file = w;
    file_close(w);
    printfmt("{}\n", file_is_open(copy_of_w));
    file_close(copy_of_w);

    r: file = file_open(path, "rb");
    bytes: [32]u8 = {};
    got: u64 = file_read(r, bytes);
    file_close(r);
    printfmt("{}\n", got);
}

copies: proc() -> void = {
    a: [4]i32 = { 1, 2, 3, 4 };
    b: [4]i32 = {};
    slice<i32>copy(b, a);
    printfmt("{}\n", b[3]);
    c: [4]i32 = {};
    c = a;
    printfmt("{}\n", c[2]);
    slice<i32>zero(c);
    printfmt("{}\n", c[2]);
}

main: proc() -> i32 = {
    g_kinds[1].hits += 1;
    printfmt("{} {} {}\n", g_kinds[1].name, g_kinds[1].hits, g_names[1]);
    printfmt("{}\n", pick(0));
    local: kind = { .name = pick(1), .hits = 0 };
    printfmt("{}\n", local.name);
    files();
    copies();
    return 0;
}
