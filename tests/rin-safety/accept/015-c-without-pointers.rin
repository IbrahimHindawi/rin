import "std/print.rin"

/* A C proc that touches no pointers is called like any other. */
abs: proc[external](v: i32) -> i32 = {}

/* A handle never stales what was taken from anything: there is nothing inside
   it to take. */
touch: proc(h: *FILE) -> void = {}
T: struct = { a: i32; h: ?*FILE in permanent; }
g: T = {};
use: proc() -> i32 = {
    p: *i32 = g.a&;
    if (g.h) { touch(g.h); }
    return p*;
}

main: proc() -> i32 = {
    printfmt("{} {}\n", abs(-4), use());
    return 0;
}
