import "std/print.rin"

/* A game's level: global state that holds a level's memory, and one place that ends it. `reset`
   frees the region and empties every global that held its memory, so nothing is left to go stale. */
level: region;

enemy: struct = { hp: i32; }

game: struct = {
    level_id: i32;
    enemies: []enemy in level;
    boss: ?*enemy in level;
}

g: game = {};
slots: [2]game = {};

load: proc(r: region level, id: i32, n: u64) -> void = {
    reset r;
    g.level_id = id;
    g.enemies = new_slice<enemy>(r, n);
    g.enemies[0].hp = id * 10;
    g.boss = g.enemies[0]&;
    slots[1].enemies = g.enemies;
}

damage: proc() -> i32 = {
    if (g.enemies.length == 0) { return -1; }
    g.enemies[0].hp -= 1;
    return g.enemies[0].hp;
}

main: proc() -> i32 = {
    printfmt("{}\n", damage());
    level: region = {
        load(level, 1, 4);
        printfmt("{} {} {}\n", g.level_id, g.enemies.length, damage());
        load(level, 2, 8);
        printfmt("{} {} {}\n", g.level_id, slots[1].enemies.length, damage());
        reset level;
        printfmt("{} {}\n", g.enemies.length, g.boss == null);
        load(level, 3, 2);
    }
    printfmt("{} {} {}\n", g.level_id, g.enemies.length, slots[1].enemies.length);
    printfmt("{}\n", damage());
    return 0;
}
