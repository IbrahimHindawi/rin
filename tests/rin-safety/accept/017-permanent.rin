import "std/print.rin"
import "std/slice.rin"

/* No block opens permanent: it is there from the first use. */
S: struct = { xs: []i32 in permanent; one: ?*i32 in permanent; }
g: S = {};
fill: proc() -> void = {
    g.xs = new_slice<i32>(permanent, 4);
    g.xs[3] = 9;
    g.one = new<i32>(permanent, 5);
}
give: proc(r: region R) -> *i32 in R = { return new<i32>(r, 6); }
main: proc() -> i32 = {
    fill();
    printfmt("{} {}\n", g.xs[3], must(g.one)*);
    printfmt("{}\n", give(permanent)*);
    return 0;
}
