// expect: may be stale
H: struct = { v: *H in permanent; }
first: proc(ctx: *H) -> *H = {
    unsafe {
        return ctx;
    }
}
touch: proc(ctx: *H) -> void = {
    unsafe {
        ctx*.v = ctx*.v;
    }
}
use: proc(ctx: *H) -> i32 = {
    f: *H = first(ctx);
    touch(ctx);
    f = f*.v;
    return 0;
}
main: proc() -> i32 = { return 0; }
