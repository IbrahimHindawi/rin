// expect: different things about a pointer
import "std/slice.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        d: []option<*i32 in level> = new_slice<option<*i32 in level>>(level, 1);
        frame: region = {
            s: []option<*i32 in frame> = new_slice<option<*i32 in frame>>(frame, 1);
            slice<option<*i32>>copy(d, s);
        }
    }
    return 0;
}
