// expect: 'p' may point into region 'frame', which ends with this bloc
import "std/print.rin"
import "std/fmt.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        p: ^const c8 = "start";
        frame: region = {
            f: *fmt in frame = fmt_make(frame, 16);
            fmt_cstr(f, "hello");
            p = fmt_text(f);
        }
        print_cstr(p);
    }
    return 0;
}
