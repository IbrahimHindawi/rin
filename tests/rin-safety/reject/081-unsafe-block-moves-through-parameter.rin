// expect: may be stale
import "std/vec.rin"
level: region;
grow: proc(v: *vec<i32>) -> void = { unsafe { _ = vec<i32>push(v, 2); } }
main: proc() -> i32 = {
    level: region = { v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        first: *i32 = vec<i32>at(v, 0);
        grow(v);
        return first*; }
    return 0; }
