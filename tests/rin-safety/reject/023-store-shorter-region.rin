// expect: this value may point into region
level: region;
frame: region in level;
holder: struct = { p: option<*i32 in level>; }
main: proc() -> i32 = {
    level: region = { h: *holder in level = new<holder>(level);
        frame: region = { x: *i32 in frame = new<i32>(frame); h*.p = x; } }
    return 0; }
