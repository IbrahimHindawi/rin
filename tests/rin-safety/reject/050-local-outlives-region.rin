// expect: is not open here
import "std/print.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        q: ?*i32 in frame = null;
        frame: region = { q = new<i32>(frame); if (q) { q* = 7; } }
        frame: region = { z: *i32 in frame = new<i32>(frame); z* = 99; }
        if (q) { printfmt("{}\n", q*); }
    }
    return 0;
}
