// expect: cannot be one region
level: region;
frame: region in level;
assign: proc(a: *option<*i32 in A>, b: *option<*i32 in A>) -> void = { a* = b*; }
main: proc() -> i32 = {
    level: region = {
        o: option<*i32 in level> = null;
        frame: region = {
            y: option<*i32 in frame> = new<i32>(frame, 42);
            assign(o&, y&);
        }
        return unwrap(o)*;
    }
    return 0;
}
