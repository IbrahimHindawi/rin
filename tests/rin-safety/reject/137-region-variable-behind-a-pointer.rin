// expect: cannot be one region
level: region;
frame: region in level;
assign: proc(a: *?*i32 in A, b: *?*i32 in A) -> void = { a* = b*; }
main: proc() -> i32 = {
    level: region = {
        o: ?*i32 in level = null;
        frame: region = {
            y: ?*i32 in frame = new<i32>(frame, 42);
            assign(o&, y&);
        }
        return must(o)*;
    }
    return 0;
}
