// expect: 'p' may point into region 'level', which is reset here, and
level: region global;
frame: region in level;
enemy: struct = { hp: i32; }
ents: []enemy in level = {};
load: proc() -> void = { reset level; ents = new_slice<enemy>(level, 4); }
main: proc() -> i32 = { load(); p: *enemy in level = ents[0]&; load(); return p*.hp; }
