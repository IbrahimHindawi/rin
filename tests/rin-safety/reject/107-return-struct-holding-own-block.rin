// expect: region 'frame' is not open here, so a local that points into
level: region;
frame: region in level;
h: struct = { p: option<*i32 in frame>; }
use: proc() -> h = {
    frame: region = { x: h = {}; x.p = new<i32>(frame, 1); return x; }
    y: h = {};
    return y;
}
main: proc() -> i32 = { return 0; }
