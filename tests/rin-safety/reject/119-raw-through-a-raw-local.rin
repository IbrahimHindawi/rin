// expect: 'p' may point into region 'frame', which ends with this bloc
import "std/print.rin"
import "std/fmt.rin"
level: region;
frame: region in level;
same: proc(s: ^const c8) -> ^const c8 = { unsafe { return s; } }
main: proc() -> i32 = {
    level: region = {
        p: ^const c8 = "start";
        frame: region = {
            f: *fmt in frame = fmt_make(frame, 16);
            q: ^const c8 = fmt_text(f);
            p = same(q);
        }
        print_cstr(p);
    }
    return 0;
}
