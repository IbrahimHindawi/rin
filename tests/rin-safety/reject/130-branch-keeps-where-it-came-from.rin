// expect: 'q' may point into region 'level', which ends with this bloc
level: region;
main: proc(argc: i32, argv: ^^char) -> i32 = {
    q: option<*i32> = null;
    level: region = {
        if (argc > 0) { q = new<i32>(level, 42); } else { q = null; }
    }
    if (q) { return q*; }
    return 0;
}
