// expect: the result names no region, and may point into the block at line 2
f: proc(a: *i32, n: i32) -> *i32 = {
    x: i32 = 0;
    y: i32 = 0;
    q: *i32 = a;
    for (i: i32 = 0; i < n; q = x&) {
        i += 1;
        if (i > n) { q = a; }
    }
    return q;
}
