// expect: the result may point into the block at line 4, and the place it goes to lasts as long as region
level: region global;
pick: proc(a: *i32) -> *i32 = { return a; }
keep: proc(r: region level, c: b32) -> *i32 in level = {
    n: *i32 in level = new<i32>(r);
    x: i32 = 0;
    return c ? pick(n) : x&;
}
main: proc() -> i32 = { return 0; }
