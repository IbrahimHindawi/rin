// expect: 's' may point into region 'level', which is reset here, and
level: region;
frame: region in level;
enemy: struct = { hp: i32; }
game: struct = { enemies: []enemy in level; }
g: game = {};
load: proc(r: region level) -> void = { reset r; g.enemies = new_slice<enemy>(r, 4); }
main: proc() -> i32 = { level: region = { load(level); s: []enemy in level = g.enemies; load(level); return s[0].hp; } return 0; }
