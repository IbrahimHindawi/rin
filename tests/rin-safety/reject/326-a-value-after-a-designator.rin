// expect: a value with no designator after one with a designator
// C continues from the designator, so the checker and C would fill different fields.
S: struct = { x: i32; }
H: struct = { p: *S in permanent; q: *S in permanent; }
main: proc() -> i32 = { n: *S in permanent = new<S>(permanent, { .x = 1 }); h: H = { .q = n, n }; return h.p*.x; }
