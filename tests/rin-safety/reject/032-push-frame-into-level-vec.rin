// expect: a pointer into region 'frame' cannot be kept where region 'level' is promised
import "std/vec.rin"
level: region;
frame: region in level;
e: struct = { hp: i32; }
main: proc() -> i32 = {
    level: region = { v: *vec<*e in level> in level = vec<*e in level>make(level, 2);
        frame: region = { x: *e in frame = new<e>(frame); _ = vec<*e in level>push(v, x); } }
    return 0; }
