// expect: a pointer into region 'frame' cannot be kept where region 'level' is promised
import "std/vec.rin"
region level > frame;
e: struct = { hp: i32; }
main: proc() -> i32 = {
    region level { v: *vec<*e in level> in level = vec<*e in level>make(level, 2);
        region frame { x: *e in frame = new<e>(frame); _ = vec<*e in level>push(v, x); } }
    return 0; }
