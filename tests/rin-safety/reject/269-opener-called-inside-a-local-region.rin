// expect: local region is open
level: region global;
frame: region in level;
enemy: struct = { hp: i32; }
game: struct = { es: []enemy in level; }
g: game = {};
wipe: proc() -> i32 = { reset level; g.es = new_slice<enemy>(level, 4); return 0; }
opens: proc() -> void = { frame: region = { } }
main: proc() -> i32 = { scratch { opens(); } return 0; }
