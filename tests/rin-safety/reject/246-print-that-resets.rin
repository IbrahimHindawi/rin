// expect: not open a region or reset
level: region;
frame: region in level;
enemy: struct = { hp: i32; }
game: struct = { enemies: []enemy in level; }
g: game = {};
load: proc(r: region level) -> void = { reset r; g.enemies = new_slice<enemy>(r, 4); }
import "std/print.rin"
K: struct = { x: i32; }
print: proc<K>(k: K) -> void = { helper(); }
helper: proc() -> void = { level: region = { } }
main: proc() -> i32 = { return 0; }
