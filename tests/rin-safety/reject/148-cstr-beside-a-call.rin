// expect: could overwrite the terminator
import "std/cstr.rin"
level: region;
clobber: proc(s: []c8) -> u64 = { s[1] = 98; s[2] = 98; s[3] = 98; return 0; }
main: proc() -> i32 = {
    r: b32 = 0;
    level: region = {
        b: []c8 in level = new_slice<c8>(level, 4);
        b[0] = 97;
        r = cstr_equals_n(cstr_of(b), "a", clobber(b));
    }
    return cast(r, i32);
}
