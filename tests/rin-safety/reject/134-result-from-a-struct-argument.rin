// expect: the result names no region, and may point into region
level: region;
S: struct = { p: *i32 in level; }
pick: proc(s: S) -> *i32 = { return s.p; }
main: proc() -> i32 = {
    a: i32 = 1;
    q: *i32 = a&;
    level: region = {
        s: S = { .p = new<i32>(level, 42) };
        q = pick(s);
    }
    return q*;
}
