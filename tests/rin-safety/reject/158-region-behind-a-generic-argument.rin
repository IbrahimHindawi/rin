// expect: cannot be one region
level: region;
frame: region in level;
box: struct<T> = { v: T; }
copy: proc(a: *box<option<*i32 in R>>, b: *box<option<*i32 in R>>) -> void = { a*.v = b*.v; }
main: proc() -> i32 = {
    level: region = {
        o: box<option<*i32 in level>> = {};
        frame: region = {
            f: box<option<*i32 in frame>> = {};
            copy(o&, f&);
        }
    }
    return 0;
}
