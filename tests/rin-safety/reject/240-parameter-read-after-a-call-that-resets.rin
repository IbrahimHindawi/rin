// expect: may be dangling
level: region;
frame: region in level;
enemy: struct = { hp: i32; }
game: struct = { enemies: []enemy in level; }
g: game = {};
load: proc(r: region level) -> void = { reset r; g.enemies = new_slice<enemy>(r, 4); }
use: proc(r: region level, e: *enemy) -> i32 = { load(r); return e*.hp; }
main: proc() -> i32 = { return 0; }
