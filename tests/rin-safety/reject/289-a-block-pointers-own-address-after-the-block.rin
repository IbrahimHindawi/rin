// expect: 'r' may point into the block at line 8, which ends here, and
// borrows_leave_scope skips pointer locals because a copy of one takes nothing with it, but r holds q's own address: r** after the block is stack-use-after-scope
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    yp: *i32 = y&;
    r: **i32 = yp&;
    if (y > 0) {
        q: *i32 = y&;
        r = q&;
    }
    printfmt("{}\n", r**);
    return 0;
}
