// expect: 'c' may point into region 'level', which is reset here, and
level: region global;
frame: region in level;
enemy: struct = { hp: i32; }
game: struct = { es: []enemy in level; }
g: game = {};
wipe: proc() -> i32 = { reset level; g.es = new_slice<enemy>(level, 4); return 0; }
f: proc(c: game) -> i32 = { wipe(); return c.es[0].hp; }
main: proc() -> i32 = { return 0; }
