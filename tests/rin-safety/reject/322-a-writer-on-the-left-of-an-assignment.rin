// expect: a call beside cstr_of could overwrite the terminator
// The left side of an assignment has no order with the right either.
import "std/print.rin"
import "std/cstr.rin"
g: [8]c8 = {};
fill: proc() -> u64 = { for (i: u64 = 0; i < 8; i += 1) { g[i] = 65; } return 1; }
main: proc() -> i32 = { a: [64]u64 = {}; a[fill()] = cstr_length(cstr_of(g[0..8])); printfmt("{}\n", a[1]); return 0; }
