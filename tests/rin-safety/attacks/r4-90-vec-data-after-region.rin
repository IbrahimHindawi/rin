import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
import "std/cstr.rin"
main: proc() -> i32 = {
    p: ^const c8 = "x";
    level: region = {
        frame: region = {
            v: *vec<c8> in frame = vec<c8>make(frame, 4);
            _ = vec<c8>push(v, 97);
            _ = vec<c8>push(v, 0);
            p = v*.data;
        }
        print_cstr(p);
    }
    return 0;
}
