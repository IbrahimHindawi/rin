import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
mine: struct = { v: vec<i32>; }
main: proc() -> i32 = {
    level: region = {
        m: *mine in level = new<mine>(level);
        m*.v.length = 100000;
        printfmt("{}\n", m*.v.data[50000]);
    }
    return 0;
}
