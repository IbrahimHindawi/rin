// T = option<*S>, the nptr instance; T = proc pointer.
import "std/print.rin"
S: struct = { x: i32; }
level: region global;
print_nptr_S: proc(s: option<*S>) -> void = { reset level; }
show: proc<T>(v: T, p: *i32 in level) -> void = { printfmt("{} {}\n", v, p*); }
main: proc() -> i32 = {
    p: *i32 in level = new<i32>(level, 7);
    o: option<*S> = null;
    show<option<*S>>(o, p);
    return 0;
}
