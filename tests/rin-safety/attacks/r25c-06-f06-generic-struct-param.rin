import "std/print.rin"
import "std/cstr.rin"
g: [8]c8 = {};
box: struct<T> = { buf: T; }
use: proc(s: ^const c8, w: box<[]c8 in permanent>) -> i32 = {
    for (i: u64 = 0; i < w.buf.length; i += 1) { w.buf[i] = 65; }
    printfmt("{}\n", s);
    return 0;
}
main: proc() -> i32 = { w: box<[]c8 in permanent> = {.buf = g[0..8]}; return use(cstr_of(g[0..8]), w); }
