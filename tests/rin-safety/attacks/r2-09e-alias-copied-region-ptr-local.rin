import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>at(v, 0);
        v2: *vec<i32> in level = v;
        for (i: i32 = 0; i < 64; i += 1) { _ = vec<i32>push(v2, 42); }
        printfmt("{}\n", p*);
    }
    return 0; }
