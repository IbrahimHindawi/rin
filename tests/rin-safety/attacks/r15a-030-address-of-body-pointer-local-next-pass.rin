// as 028 with the loop body's local, read the next time round before it is declared again; nothing kills r, so the back edge has nothing to report: stack-use-after-scope at r**
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    yp: *i32 = y&;
    r: **i32 = yp&;
    for (i: i32 = 0; i < 2; i += 1) {
        printfmt("{}\n", r**);
        q: *i32 = y&;
        r = q&;
    }
    return 0;
}
