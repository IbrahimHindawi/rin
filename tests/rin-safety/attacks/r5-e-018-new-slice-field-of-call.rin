import "std/print.rin"
// new_slice's count may be a field, and a field's base may be a call: evaluated twice.
a: region;
S: struct = { n: u64; }
calls: i32 = 0;
mk: proc() -> S = {
    calls += 1;
    if (calls == 1) { return { .n = 1 }; }
    return { .n = 1000000 };
}
main: proc() -> i32 = {
    a: region = {
        s: []i32 in a = new_slice<i32>(a, mk().n);
        s[999999] = 7;
        printfmt("{}\n", s[999999]);
    }
    return 0;
}
