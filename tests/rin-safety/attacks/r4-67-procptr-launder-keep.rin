import "std/print.rin"
gk: option<*i32 in permanent> = null;
keep: proc(p: *i32 in permanent) -> void = { gk = p; }
go: proc() -> void = {
    fp: *proc(p: *i32) -> void = keep;
    x: i32 = 42;
    fp(x&);
}
smash: proc() -> void = { y: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { y[i] = 0x4141414141414141; } printfmt("{}\n", y[3] == 0); }
main: proc() -> i32 = {
    go();
    smash();
    printfmt("{}\n", unwrap(gk)*);
    return 0;
}
