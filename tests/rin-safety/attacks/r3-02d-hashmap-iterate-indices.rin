import "std/print.rin"
import "std/hashmap.rin"
level: region;

main: proc() -> i32 = {
    level: region = {
        m: *hashmap<i64, i32> in level = hashmap<i64, i32>make(level);
        for (i: i64 = 0; i < 5; i += 1) { _ = hashmap<i64, i32>set(m, i, 1); }
        n: i32 = 0;
        for (i: u64 = hashmap<i64, i32>first(m); i < m*.capacity; i = hashmap<i64, i32>next(m, i)) {
            _ = hashmap<i64, i32>remove(m, cast(i, i64));
            n += 1;
        }
        printfmt("{} {}\n", n, m*.length);
        big: u64 = 0; big -= 1;
        printfmt("{}\n", hashmap<i64, i32>next(m, big));
    }
    return 0; }
