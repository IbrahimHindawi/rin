import "std/print.rin"
import "std/vec.rin"
level: region;
grow: proc(v: *vec<i32>) -> i32 = { for (j: i32 = 0; j < 100; j += 1) { _ = vec<i32>push(v, j); } return 0; }
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>at(v, 0);
        x: i32 = v*.length > 0 ? grow(v) : 1;
        printfmt("{} {}\n", p*, x);
    }
    return 0;
}
