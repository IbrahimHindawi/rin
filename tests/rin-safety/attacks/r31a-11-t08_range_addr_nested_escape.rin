import "std/print.rin"
c: proc() -> i32 = { return 100; }
id: proc(p: *[]i32, n: i32) -> *[]i32 = { return p; }
out: proc(p: *[]i32, n: i32) -> i32 = { return p*[0] + cast(p*.length, i32) + n; }
main: proc() -> i32 = { xs: [4]i32 = { 1, 2, 3, 4 }; s: []i32 = xs; printfmt("{}\n", out(id(s[1..3]&, c()), c())); printfmt("{}\n", out(id(xs[1..3]&, c()), c())); return 0; }
