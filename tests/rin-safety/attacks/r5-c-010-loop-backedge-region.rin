// The region's end kills q, but the top of the next pass was checked with q alive.
import "std/print.rin"
level: region;
main: proc() -> i32 = {
    q: ?*i32 = null;
    for (i: i32 = 0; i < 2; i += 1) {
        if (q) { printfmt("{}\n", q*); }
        level: region = { q = new<i32>(level, 42); }
    }
    return 0;
}
