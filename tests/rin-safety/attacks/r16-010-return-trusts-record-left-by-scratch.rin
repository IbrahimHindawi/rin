// a region block never truncates g_borrows, so the scratch r's record stays; return_checks_later_assignments looks `r` up and finds it, vouching for `h = r`, and the seed has h from the last sibling r only (009): the second pass returns x's address: stack-use-after-return at q*
import "std/print.rin"
f: proc(a: *i32, n: i32) -> *i32 = {
    x: i32 = 7;
    scratch { r: *i32 = a; r* = 1; }
    h: *i32 = a;
    for (i: i32 = 0; i < n; i += 1) {
        if (i == 1) { return h; }
        if (i == 0) { r: *i32 = x&; h = r; }
        else { r: *i32 = a; h = r; }
    }
    return a;
}
main: proc() -> i32 = { y: i32 = 1; q: *i32 = f(y&, 3); printfmt("{}\n", q*); return 0; }
