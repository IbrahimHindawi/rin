level: region global;
print_cstr: proc(s: ^const char) -> void = { reset level; }
print: proc<i32>(x: i32) -> void = {}
S: struct = { x: i32; }
print: proc<S>(x: S) -> void = {}
main: proc() -> i32 = {
    p: *i32 in level = new<i32>(level, 7);
    v: S = { .x = 1 };
    printfmt("a {} b", v);
    p* = 3;
    return p*;
}
