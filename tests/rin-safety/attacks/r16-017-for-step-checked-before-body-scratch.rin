// as 014 with region memory: the step's new<i32>(scratch) is recorded before the body's retake clears it: use-after-poison at q*
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    q: *i32 = y&;
    scratch {
        for (i: i32 = 0; i < 1; q = new<i32>(scratch, 3)) { q = y&; i += 1; }
    }
    printfmt("{}\n", q*);
    return 0;
}
