// unwrap's argument is not held to the const-memory rule, and cg.a[0]& has no const in its type: q* = 5 faults on read-only memory
import "std/print.rin"
level: region global;
frame: region in level;
perm: i32 = 7;
wa: struct = { a: [4]i32; }
cg: const wa = { .a = { 1, 2, 3, 4 } };
main: proc() -> i32 = {
    q: *i32 = unwrap(cg.a[0]&);
    q* = 5;
    return 0;
}
