import "std/print.rin"
import "std/vec.rin"
level: region;
w: struct = { hp: *vec<i32> in level; }
grow: proc(ww: *const w in level) -> void = { for (i: i32 = 0; i < 64; i += 1) { _ = vec<i32>push(ww*.hp, 42); } }
main: proc() -> i32 = {
    level: region = {
        ww: *w in level = new<w>(level, { .hp = vec<i32>make(level, 1) });
        _ = vec<i32>push(ww*.hp, 1);
        p: *i32 = vec<i32>at(ww*.hp, 0);
        grow(ww);
        vec<i32>at(ww*.hp, 0)* = 42; printfmt("{} (42 if fresh)\n", p*);
    }
    return 0; }
