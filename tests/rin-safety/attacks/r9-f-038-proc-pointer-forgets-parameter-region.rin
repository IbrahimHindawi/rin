// Proc types are compared without regions: stash, which keeps its *i32 in permanent, becomes a proc(p: *i32) and is handed a local. ASan: stack-use-after-return.
keep: ?*i32 in permanent = null;
stash: proc(p: *i32 in permanent) -> void = { keep = p; }
leak: proc() -> void = { fp: proc(p: *i32) -> void = stash; x: i32 = 1; fp(x&); }
main: proc() -> i32 = { leak(); return must(keep)*; }
