// map<T>get takes a null key: its hash is 0, and with slot 0 occupied by "k367" it calls strcmp(NULL, ...): a null load.
import "std/print.rin"
import "std/map.rin"
H: struct = { struct = { a: memops_arena; } }
main: proc() -> i32 = {
    h: *H in permanent = new<H>(permanent);
    memops_arena_initialize(h*.a&, 1048576);
    m: *map<i32> in permanent = map<i32>make(permanent);
    map<i32>put(m, "k367", 1);
    q: option<*i32> = map<i32>get(h*.a&, m, null);
    printfmt("{}\n", q ? q* : 0);
    return 0;
}
