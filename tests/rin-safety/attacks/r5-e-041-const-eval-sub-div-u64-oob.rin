import "std/print.rin"
// rin const_eval (signed i64): (0-7)/5 = -1 -> <0 caught. (0-10)/5 = -2 caught.
// Use a product that is 0 in i64 by truncation but huge unsigned: (0-2)/3 = 0 (signed -2/3), C huge.
main: proc() -> i32 = {
    xs: [4]i32 = { 1, 2, 3, 4 };
    xs[(0'u64 - 2'u64) / 3] = 7;
    printfmt("{}\n", xs[0]);
    return 0;
}
