// c is copied into r and the loop breaks on the second pass; the state at the break knows only pass one's h: stack-use-after-return at q*
import "std/print.rin"
f: proc(a: *i32, n: i32) -> *i32 = {
    x: i32 = 7;
    h: *i32 = a;
    r: *i32 = a;
    for (i: i32 = 0; i < n; i += 1) {
        c: *i32 = h;
        if (i == 1) { r = c; break; }
        h = x&;
    }
    return r;
}
main: proc() -> i32 = { y: i32 = 1; q: *i32 = f(y&, 3); printfmt("{}\n", q*); return 0; }
