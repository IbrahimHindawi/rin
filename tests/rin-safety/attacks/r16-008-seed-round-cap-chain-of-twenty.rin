// borrows_seed_loop stops at 16 rounds; a20 to a1 assigned in the order that moves x one step per round leaves a1 to a3 without x, so a1 is alive after x's block; after 30 passes a1 holds x: stack-use-after-scope at a1*
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    a1: *i32 = y&; a2: *i32 = y&; a3: *i32 = y&; a4: *i32 = y&; a5: *i32 = y&; a6: *i32 = y&; a7: *i32 = y&; a8: *i32 = y&; a9: *i32 = y&; a10: *i32 = y&;
    a11: *i32 = y&; a12: *i32 = y&; a13: *i32 = y&; a14: *i32 = y&; a15: *i32 = y&; a16: *i32 = y&; a17: *i32 = y&; a18: *i32 = y&; a19: *i32 = y&; a20: *i32 = y&;
    if (y > 0) {
        x: i32 = 2;
        for (i: i32 = 0; i < 30; i += 1) {
            a1 = a2; a2 = a3; a3 = a4; a4 = a5; a5 = a6; a6 = a7; a7 = a8; a8 = a9; a9 = a10; a10 = a11;
            a11 = a12; a12 = a13; a13 = a14; a14 = a15; a15 = a16; a16 = a17; a17 = a18; a18 = a19; a19 = a20; a20 = x&;
        }
    }
    printfmt("{}\n", a1*);
    return 0;
}
