import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc(argc: i32, argv: ^^char) -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>at(v, 0);
        switch (argc) {
            case 1: { _ = vec<i32>push(v, 2); }
            case 2: { p = vec<i32>at(v, 0); }
            default: { }
        }
        for (i: i32 = 0; i < 64; i += 1) { _ = vec<i32>push(v, 42); }
        printfmt("{}\n", p*);
    }
    return 0; }
