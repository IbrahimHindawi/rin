import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>at(v, 0);
        n: i32 = 0;
        while (1) {
            n += 1;
            if (n == 1) { for (i: i32 = 0; i < 64; i += 1) { _ = vec<i32>push(v, 42); } break; }
            p = vec<i32>at(v, 0);
        }
        printfmt("{}\n", p*);
    }
    return 0; }
