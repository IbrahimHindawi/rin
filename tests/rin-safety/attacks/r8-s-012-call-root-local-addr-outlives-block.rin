// Stack: same(y&)*.x&, a user proc returning its argument; the call under the field gives no source, keep outlives the block. ASan: stack-use-after-scope.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
same: proc(p: *S) -> *S = { return p; }
main: proc() -> i32 = {
  z: S = {};
  keep: *i32 = z.x&;
  if (z.x == 0) {
    y: S = {};
    y.x = 7;
    keep = same(y&)*.x&;
  }
  printfmt("{}\n", keep*);
  return 0;
}
