// equal<key> opens level, called in hashmap's find once the key is there: level's arena is cleared mid-get, and the map is read after: use-after-poison.
import "std/print.rin"
import "std/hashmap.rin"
level: region;
key: struct = { x: i64; }
hash: proc<key>(k: key) -> u64 = { return cast(k.x, u64) * 31; }
equal: proc<key>(a: key, b: key) -> b32 = {
    level: region = { }
    return a.x == b.x;
}
main: proc() -> i32 = {
    level: region = {
        m: *hashmap<key, i32> in level = hashmap<key, i32>make(level);
        k: key = { .x = 1 };
        _ = hashmap<key, i32>set(m, k, 1);
        printfmt("{}\n", hashmap<key, i32>has(m, k));
    }
    return 0;
}
