// The same with no second argument at all: the array is a global the callee can reach.
import "std/print.rin"
import "std/cstr.rin"

line: [8]c8 = {};

bad: proc(s: ^const c8) -> u64 = {
    for (i: u64 = 0; i < 8; i += 1) { line[i] = 65; }
    return cstr_length(s);
}

main: proc() -> i32 = {
    printfmt("{}\n", bad(cstr_of(line)));
    return 0;
}
