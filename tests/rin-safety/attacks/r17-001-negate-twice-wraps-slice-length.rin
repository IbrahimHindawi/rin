// -(-x.length) on a u64 emits `--x.length`: the two minus signs glue into C's decrement. An empty slice's length wraps to 2^64-1, so x[i] passes its bounds check and writes past the array: stack-buffer-overflow.
import "std/print.rin"
main: proc() -> i32 = {
    a: [4]i32 = {};
    i: u64 = 4;
    x: []i32 = a[0..0];
    n: u64 = -(-x.length);
    x[i] = 7;
    printfmt("{} {}\n", n, x[i]);
    return 0;
}
