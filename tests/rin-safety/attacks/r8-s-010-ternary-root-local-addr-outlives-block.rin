// Stack, no vec: (c ? y& : y&)*.x& roots the path in a ternary, so no source; keep outlives the block holding y. ASan: stack-use-after-scope.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
main: proc() -> i32 = {
  z: S = {};
  keep: *i32 = z.x&;
  if (z.x == 0) {
    y: S = {};
    y.x = 7;
    keep = (z.x == 0 ? y& : y&)*.x&;
  }
  printfmt("{}\n", keep*);
  return 0;
}
