// `get: *proc() -> ... = get;` is the global proc to the checker and `(*get)(void) = get` to C: the uninitialized pointer initializes itself and is then called. spray leaves a wild value in the slot at -O0. SEGV.
import "std/print.rin"
get: proc() -> *i32 in permanent = { return new<i32>(permanent, 1); }
spray: proc(k: u64) -> u64 = {
    a: u64 = k; b: u64 = k; c: u64 = k; d: u64 = k; e: u64 = k; f: u64 = k; g: u64 = k; h: u64 = k;
    return a + b + c + d + e + f + g + h;
}
victim: proc() -> i32 = {
    get: *proc() -> *i32 in permanent = get;
    return get()*;
}
main: proc() -> i32 = {
    n: u64 = spray(0x4141414141414141);
    printfmt("{} {}\n", n, victim());
    return 0;
}
