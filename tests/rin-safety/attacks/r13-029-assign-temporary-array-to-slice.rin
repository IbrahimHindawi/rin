// as 028 with the array coerced whole: p = mk().a; stack-use-after-return in main
import "std/print.rin"
level: region global;
frame: region in level;
perm: i32 = 7;
wa: struct = { a: [4]i32; }
mk: proc() -> wa = { v: wa = {}; return v; }
mid: proc(p: []i32) -> []i32 = { p = mk().a; return p; }
main: proc() -> i32 = {
    z: [1]i32 = {};
    r: []i32 = mid(z);
    printfmt("{}\n", r[0]);
    return 0;
}
