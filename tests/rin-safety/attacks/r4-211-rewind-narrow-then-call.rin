import "std/print.rin"
import "std/file.rin"
rewind: proc[external, safe](stream: *FILE) -> void = {}
gfile: option<*FILE in permanent> = null;
clr: proc() -> i32 = { gfile = null; return 0; }
f2: proc(s: *FILE, n: i32) -> void = { rewind(s); }
main: proc() -> i32 = { if (gfile) { rewind(gfile); _ = clr(); rewind(gfile); } printfmt("back\n"); return 0; }
