import "std/print.rin"
import "std/hashmap.rin"
level: region;

main: proc() -> i32 = {
    level: region = {
        m: *hashmap<i64, i32> in level = hashmap<i64, i32>make(level);
        p: *i32 = hashmap<i64, i32>set(m, 1, 1);
        for (i: i64 = 2; i < 100; i += 1) { _ = hashmap<i64, i32>set(m, i, 1); }
        printfmt("{}\n", p*);
    }
    return 0; }
