// A proc named unwrap with two parameters: to the cstr_of rule it is a builtin, and writes nothing.
import "std/print.rin"
import "std/cstr.rin"
level: region global;
unwrap: proc(b: []c8, n: i32) -> ^const c8 = { for (i: u64 = 0; i < b.length; i += 1) { b[i] = 65; } return "x"; }
main: proc() -> i32 = {
    a: []c8 in level = new_slice<c8>(level, 8);
    printfmt("{}\n", cstr_equals(cstr_of(a), unwrap(a, 1)));
    return 0;
}
