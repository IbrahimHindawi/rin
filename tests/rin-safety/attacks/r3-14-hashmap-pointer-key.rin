import "std/print.rin"
import "std/hashmap.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        m: *hashmap<*i32 in level, i32> in level = hashmap<*i32 in level, i32>make(level);
        a: *i32 in level = new<i32>(level);
        _ = hashmap<*i32 in level, i32>set(m, a, 3);
        printfmt("{}\n", hashmap<*i32 in level, i32>get_or(m, a, -1));
    }
    return 0; }
