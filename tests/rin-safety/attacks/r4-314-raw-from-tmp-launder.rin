import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
import "std/fmt.rin"
import "std/cstr.rin"
id_raw: proc(p: ^const c8) -> ^const c8 = { return p; }
main: proc() -> i32 = {
    p: ^const c8 = "start";
    level: region = {
        tmp: region of level = {
            f: *fmt in tmp = fmt_make(tmp, 16);
            fmt_cstr(f, "hello");
            p = id_raw(fmt_text(f));
        }
        clobber(level);
        print_cstr(p);
    }
    return 0;
}
