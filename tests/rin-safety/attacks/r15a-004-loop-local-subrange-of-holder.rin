// as 001 with slices: c is a subrange of h declared in the loop, h takes a local array below the return; q[0] after the return is stack-use-after-return
import "std/print.rin"
f: proc(a: []i32, n: i32) -> []i32 = {
    x: [4]i32 = { 1, 2, 3, 4 };
    h: []i32 = a;
    for (i: i32 = 0; i < n; i += 1) {
        c: []i32 = h[0..1];
        if (i == 1) { return c; }
        h = x[0..4];
    }
    return a;
}
main: proc() -> i32 = { y: [2]i32 = {1,2}; q: []i32 = f(y[0..2], 3); printfmt("{}\n", q[0]); return 0; }
