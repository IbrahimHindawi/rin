// return_root_ok reads p's sources as they stand at the return; p = x& comes after it in the loop, so the second pass returns a local's address through a bare result: stack-use-after-return at q*
import "std/print.rin"
level: region global;
frame: region in level;
boss: option<*i32 in frame> = null;
f: proc(a: *i32 in R, n: i32) -> *i32 = {
    x: i32 = 7;
    p: *i32 = a;
    for (i: i32 = 0; i < n; i += 1) {
        if (i == 1) { return p; }
        p = x&;
    }
    return a;
}
main: proc() -> i32 = {
    a: *i32 in level = new<i32>(level, 1);
    q: *i32 = f(a, 3);
    printfmt("{}\n", q*);
    return 0;
}
