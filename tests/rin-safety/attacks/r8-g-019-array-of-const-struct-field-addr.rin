// K: [2]const S is rodata; K[0].x& is typed *i32 because expr_place_is_const only asks about the outermost name. The write faults.
import "std/print.rin"

S: struct = { x: i32; ys: [4]i32; }
K: [2]const S = { { 1 }, { 2 } };
main: proc() -> i32 = {
    q: *i32 = K[0].x&;
    q* = 2;
    printfmt("{}\n", K[0].x);
    return 0;
}
