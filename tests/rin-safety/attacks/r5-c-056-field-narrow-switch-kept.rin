// Field path narrowed, then a switch with a call in one case; after the switch the narrowing survives.
import "std/print.rin"
H: struct = { x: i32; }
S: struct = { h: ?*H in permanent; }
g: S = {};
clr: proc() -> i32 = { g.h = null; return 0; }
main: proc() -> i32 = {
    g.h = new<H>(permanent, { .x = 7 });
    n: i32 = 0;
    if (g.h) {
        switch (n) {
            case 0: { _ = clr(); break; }
            default: { break; }
        }
        printfmt("{}\n", g.h*.x);
    }
    return 0;
}
