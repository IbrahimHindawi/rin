import "std/print.rin"
import "std/cstr.rin"
id_raw: proc(p: ^const c8) -> ^const c8 = { return p; }
main: proc(argc: i32, argv: ^^char) -> i32 = {
    p: ^const c8 = "start";
    if (1) { b: [8]c8 = {}; _ = cstr_copy(b, "abc"); q: ^const c8 = cstr_of(b); p = id_raw(argc == 1 ? q : q); }
    print_cstr(p);
    return 0;
}
