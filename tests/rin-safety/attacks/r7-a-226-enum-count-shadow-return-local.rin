// The enum-name shadow, with the array as a local and the shadow a different-scope local.
import "std/print.rin"
E: enum = { n = 1 }
read: proc(i: u64) -> i32 = {
    E_n: u64 = 100000;
    a: [E.n]i32 = {};
    return a[i];
}
main: proc() -> i32 = {
    printfmt("{}\n", read(99999));
    return 0;
}
