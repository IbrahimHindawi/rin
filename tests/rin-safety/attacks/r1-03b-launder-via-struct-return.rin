import "std/print.rin"
import "std/vec.rin"
level: region;
pair: struct = { a: ?*i32; }
first: proc(v: *const vec<i32>) -> pair = { return { .a = vec<i32>at(v, 0) }; }
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        pr: pair = first(v);
        for (i: i32 = 0; i < 100; i += 1) { _ = vec<i32>push(v, i); }
        if (pr.a) { printfmt("{}\n", pr.a*); }
    }
    return 0;
}
