// the copy is an inner loop's init, also a declaration: the outer back-edge reaches it unseen; stack-use-after-return at q*
import "std/print.rin"
f: proc(a: *i32, n: i32) -> *i32 = {
    x: i32 = 7;
    h: *i32 = a;
    for (i: i32 = 0; i < n; i += 1) {
        for (c: *i32 = h; i == 1; i += 1) { return c; }
        h = x&;
    }
    return a;
}
main: proc() -> i32 = { y: i32 = 1; q: *i32 = f(y&, 3); printfmt("{}\n", q*); return 0; }
