import "std/print.rin"
import "std/reflect.rin"
import "std/vec.rin"
import "std/cstr.rin"
pt: struct = { x: i32; y: i32; }
color: enum = { a, b }
wrap: struct = { r: reflect; }
level: region global;
main: proc() -> i32 = { p: *reflect in level = new<reflect>(level); p* = pt<>; p*.variant = color<>.variant; printfmt("{}\n", reflect_field_at(p, 1) != null); return 0; }
