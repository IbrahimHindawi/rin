// new<T>(r, value) with a literal sets a carrier's fields.
import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = new<vec<i32>>(level, { .length = 1000000 });
        printfmt("{}\n", vec<i32>at(v, 999999)*);
    }
    return 0;
}
