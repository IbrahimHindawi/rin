// A ternary of literals has LitKind Int, so `(c ? 2147483647 : 0) + (c ? 1 : 0)` gets no arith_note although it is decided at run time. UBSan: signed-integer-overflow.
big: proc() -> b32 = { return 1; }
main: proc() -> i32 = { c: b32 = big(); y: i32 = (c ? 2147483647 : 0) + (c ? 1 : 0); return y; }
