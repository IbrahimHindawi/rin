import "std/print.rin"
// The same through a call's arg_directives: a '#' line between arguments.
f: proc(a: i32, b: i32) -> i32 = { return a + b; }
main: proc() -> i32 = {
    xs: [4]i32 = { 1, 2, 3, 4 };
    r: i32 = f(1,
#undef RIN_INDEX
#define RIN_INDEX(i, n) (i)
        2);
    i: u64 = 100000000;
    xs[i] = r;
    printfmt("{}\n", xs[i]);
    return 0;
}
