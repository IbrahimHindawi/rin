// An array parameter returned as a slice (the caller's memory) while the caller passes a temporary's array. Dangles after the statement. UB per C11 6.2.4p8: expect 7 at -O0 and something else at -O2 (run_rin_vm --compare); ASan stack-use-after-scope where clang marks the temporary.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
mk: proc(n: i32) -> S = { s: S = {}; s.x = n; s.y[0] = n; s.y[1] = n; return s; }
A4: alias = [4]i32;
f: proc(a: A4) -> []i32 = { return a; }
main: proc() -> i32 = {
  keep: []i32 = f(mk(7).y);
  other: S = mk(9);
  printfmt("{} {}\n", keep[0], other.x);
  return 0;
}
