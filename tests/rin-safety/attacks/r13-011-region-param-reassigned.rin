// a region parameter is assignable and no region rule sees it: r = s keeps type R and takes S's arena, so a *i32 in permanent is in scratch and reads poison after the block
import "std/print.rin"
level: region global;
frame: region in level;
perm: i32 = 7;
f: proc(r: region R, s: region S) -> *i32 in R = { r = s; return new<i32>(r, 1); }
main: proc() -> i32 = {
    x: *i32 in permanent = perm&;
    scratch { x = f(permanent, scratch); }
    printfmt("{}\n", x*);
    return 0;
}
