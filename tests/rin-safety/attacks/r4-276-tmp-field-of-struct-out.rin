import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
S: struct = { a: i32; }
Hold: struct = { p: option<*S in frame>; }
main: proc() -> i32 = {
    level: region = {
        o: S = {};
        q: *S = o&;
        frame: region = {
            h: *Hold in frame = new<Hold>(frame);
            h*.p = new<S>(frame, { .a = 42 });
            if (h*.p) { q = h*.p; }
        }
        frame: region = { x: []i32 in frame = new_slice<i32>(frame, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } }
        printfmt("{}\n", q*.a);
    }
    return 0;
}
