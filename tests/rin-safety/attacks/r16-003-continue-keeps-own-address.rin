// as 001 with `continue`: the state in ctx->conts has no scope_killed, so the back edge reports nothing: stack-use-after-scope at r** on the second pass
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    yp: *i32 = y&;
    r: **i32 = yp&;
    for (i: i32 = 0; i < 2; i += 1) {
        printfmt("{}\n", r**);
        if (i == 0) {
            q: *i32 = y&;
            r = q&;
            continue;
        }
    }
    return 0;
}
