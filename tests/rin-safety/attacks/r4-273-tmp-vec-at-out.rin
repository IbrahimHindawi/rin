import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc() -> i32 = {
    level: region = {
        o: i32 = 1;
        q: *i32 = o&;
        tmp: region of level = {
            v: *vec<i32> in tmp = vec<i32>make(tmp, 2);
            _ = vec<i32>push(v, 42);
            q = vec<i32>at(v, 0);
        }
        clobber(level);
        printfmt("{}\n", q*);
    }
    return 0;
}
