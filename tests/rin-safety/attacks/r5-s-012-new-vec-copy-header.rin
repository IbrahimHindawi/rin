// new<vec<i32>>(level, short*) clones a frame vec's header into level.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        k: option<*vec<i32> in level> = null;
        frame: region = {
            tmp: *vec<i32> in frame = vec<i32>make(frame, 1);
            _ = vec<i32>push(tmp, 42);
            k = new<vec<i32>>(level, tmp*);
        }
        printfmt("{}\n", vec<i32>at(unwrap(k), 0)*);
    }
    return 0;
}
