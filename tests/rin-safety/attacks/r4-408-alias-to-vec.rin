import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
vi: alias = vec<i32>;
main: proc() -> i32 = {
    level: region = {
        v: *vi in level = vec<i32>make(level, 1);
        v*.length = 100000;
        printfmt("{}\n", vec<i32>at(v, 50000)*);
    }
    return 0;
}
