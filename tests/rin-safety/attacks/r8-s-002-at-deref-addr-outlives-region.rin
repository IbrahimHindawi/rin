// keep = at(v,0)*&: the whole element's address, same missing source; read after frame ends. ASan: use-after-poison.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
main: proc() -> i32 = {
  level: region = {
    z: *S in level = new<S>(level);
    keep: *S = z;
    frame: region = {
      v: *vec<S> in frame = vec<S>make(frame, 4);
      s0: S = {};
      s0.x = 7; s0.y[0] = 7; s0.y[1] = 7;
      _ = vec<S>push(v, s0);
      keep = vec<S>at(v, 0)*&;
    }
    printfmt("{}\n", keep*.x); // frame has ended: its arena is cleared and poisoned
  }
  return 0;
}
