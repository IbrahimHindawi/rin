// A ternary over two region handles bound to one R: forbidden, but through a proc that picks?
import "std/print.rin"
level: region;
frame: region in level;
two: proc(r1: region R, r2: region R) -> *i32 in R = { return new<i32>(r1, 42); }
main: proc() -> i32 = {
    q: *i32 = unwrap(null);
    level: region = {
        frame: region = {
            q = two(level, frame);
        }
        printfmt("{}\n", q*);
    }
    return 0;
}
