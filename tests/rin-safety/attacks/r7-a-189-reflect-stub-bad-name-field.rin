// A union-type variant read as both arms without a known Type<>.
import "std/print.rin"
import "std/reflect.rin"
E: enum = { a, b }
P: struct = { x: i32; }
pick: proc(c: i32) -> *const reflect = { return c == 0 ? E<>& : P<>&; }
main: proc() -> i32 = {
    t: *const reflect = pick(0);
    if (reflect_field_count(t) == 0) {
        f: ^const reflect_field = t*.variant.fields;
        r: *const reflect_field = unwrap(reflect_find_field(P<>&, "x"));
        printfmt("{}\n", r*.size);
    }
    return 0;
}
