import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
f: proc(r: region R) -> i32 = {
    tmp: region of r = {
        v: *vec<?*i32 in tmp> in R = vec<?*i32 in tmp>make(r, 2);
        _ = vec<?*i32 in tmp>push(v, new<i32>(tmp, 42));
        return 0;
    }
    return 0;
}
main: proc() -> i32 = { return 0; }
