// raw_has_checked_source looks at the arguments of the call. A wrapper with none hides the source.
import "std/print.rin"
import "std/fmt.rin"
level: region;
frame: region in level;
gf: ?*fmt in level = null;
get: proc() -> ^const c8 = {
    if (gf) { return fmt_text(gf); }
    return "";
}
main: proc() -> i32 = {
    k: ^const c8 = "x";
    level: region = {
        gf = fmt_make(level, 4096);
        fmt_cstr(must(gf), "hello");
        k = get();
        gf = null;
    }
    print_cstr(k);
    return 0;
}
