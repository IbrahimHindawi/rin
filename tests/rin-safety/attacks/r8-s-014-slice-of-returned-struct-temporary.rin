// keep = mk(7).y is a slice of a C temporary whose lifetime ends with the full expression; mk(9) reuses the slot. UB per C11 6.2.4p8: expect 7 at -O0 and something else at -O2 (run_rin_vm --compare); ASan stack-use-after-scope where clang marks the temporary.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
mk: proc(n: i32) -> S = { s: S = {}; s.x = n; s.y[0] = n; s.y[1] = n; return s; }
main: proc() -> i32 = {
  keep: []i32 = mk(7).y;
  other: S = mk(9);
  printfmt("{} {}\n", keep[0], other.x);
  return 0;
}
