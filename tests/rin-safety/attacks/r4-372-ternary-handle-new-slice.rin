import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc(argc: i32, argv: ^^char) -> i32 = {
    level: region = {
        k: []i32 in level = new_slice<i32>(level, 1);
        tmp: region of level = { k = new_slice<i32>(argc == 99 ? level : tmp, 2); k[0] = 42; }
        clobber(level);
        printfmt("{}\n", k[0]);
    }
    return 0;
}
