import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
f: proc(r: region R, d: i32) -> i32 = {
    tmp: region of r = {
        unsafe { goto out; }
    }
    out: label = { }
    return d;
}
main: proc() -> i32 = {
    level: region = {
        for (i: i32 = 0; i < 300; i += 1) { _ = f(level, i); }
        printfmt("ok\n");
    }
    return 0;
}
