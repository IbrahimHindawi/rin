import "std/print.rin"
import "std/hashmap.rin"
import "std/cstr.rin"
import "std/fmt.rin"
thing: struct = { x: i64; }
level: region global;
main: proc() -> i32 = { m: *hashmap<i64, *thing in level> in level = hashmap<i64, *thing in level>make(level); printfmt("{}\n", hashmap<i64, *thing in level>first(m) + hashmap<i64, *thing in level>states_(m).length); return 0; }
