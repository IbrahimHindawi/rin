import "std/print.rin"
level: region global;
S: struct = { x: i32; }
print_S: proc(s: S) -> void = { reset level; }
noop: proc(f: ^const c8, s: S) -> void = {}
main: proc() -> i32 = {
    p: *i32 in level = new<i32>(level, 7);
    printfmt: *proc(f: ^const c8, s: S) -> void = noop;
    a: S = { .x = 1 };
    printfmt("{}", a);
    p* = 3;
    return 0;
}
