// The unchecked print<box<T>> instance calls oob<box<T>>, itself first discovered through that printfmt-induced body and so also never checked: a[100000] into [4]i32 emits with no RIN_INDEX. ASan: stack-buffer-overflow. The gap reaches every generic transitively reachable only from a printfmt-induced instance.
import "std/print.rin"
box: struct<T> = { x: T; }
oob: proc<box<T>>(b: box<T>) -> i32 = {
    a: [4]i32 = {};
    i: u64 = cast(b.x, u64);
    a[i] = 1234;
    return a[i];
}
print: proc<box<T>>(b: box<T>) -> void = {
    print<i32>(oob<box<T>>(b));
}
main: proc() -> i32 = {
    b: box<i32> = { .x = 100000 };
    printfmt("{}\n", b);
    return 0;
}
