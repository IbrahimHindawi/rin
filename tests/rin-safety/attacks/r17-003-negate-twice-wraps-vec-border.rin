// -(-v*.border) emits `--v[0].border`. Twice takes a capacity of 1 through 0 to 2^64-1, so push never grows and writes past the one element it has: use-after-poison on the arena's redzone.
import "std/print.rin"
import "std/vec.rin"
main: proc() -> i32 = {
    v: *vec<i32> in permanent = vec<i32>make(permanent, 1);
    n: u64 = -(-v*.border);
    m: u64 = -(-v*.border);
    i: i32 = 0;
    for (i = 0; i < 100000; i += 1) { vec<i32>push(v, i); }
    printfmt("{} {}\n", n, m);
    return 0;
}
