import "std/print.rin"
import "std/vec.rin"
level: region;
holder: struct = { p: ?*i32; }
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        h: holder = { .p = vec<i32>at(v, 0) };
        for (i: i32 = 0; i < 100; i += 1) { _ = vec<i32>push(v, i); }
        if (h.p) { printfmt("{}\n", h.p*); }
    }
    return 0;
}
