// visit_cstr_sibling only looks for calls: a sibling slice argument of the same buffer is no call,
// and the callee writes through it, over the terminator.
import "std/print.rin"
import "std/cstr.rin"
show: proc(s: ^const c8, xs: []c8) -> void = {
    for (i: u64 = 0; i < xs.length; i += 1) { xs[i] = cast(65, c8); }
    printfmt("{}\n", cstr_length(s));
}
main: proc() -> i32 = {
    b: [4]c8 = {};
    show(cstr_of(b), b);
    return 0;
}
