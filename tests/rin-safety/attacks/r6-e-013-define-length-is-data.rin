import "std/print.rin"
// preprocessor_line_defines_a_number requires a digit after the name. `#define length data` has no digit, so it's rejected. Try a number-named redefinition of a helper's guts is impossible object-like. Instead: shadow a bound via arithmetic in a value that is "a number".
#define FOUR 0x4000
main: proc() -> i32 = {
    xs: [4]i32 = {};
    i: u64 = 5000;
    xs[i] = 7;
    printfmt("{}\n", xs[i]);
    return 0;
}
