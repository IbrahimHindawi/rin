// A byte histogram over text with a high byte, indexed by the signed char.
import "std/print.rin"
main: proc() -> i32 = {
    counts: [256]i32 = {};
    text: [4]c8 = {};
    text[0] = 'a';
    text[1] = cast(200, c8);
    for (i: u64 = 0; i < 2; i += 1) {
        printfmt("{}\n", cast(text[i], i32));
        counts[cast(text[i], u8)] += 1;
    }
    printfmt("{} {}\n", counts[97], counts[200]);
    for (i: u64 = 0; i < 2; i += 1) { counts[text[i]] += 1; }
    printfmt("unreached\n");
    return 0;
}
