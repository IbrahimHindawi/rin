// Static local holds a region pointer across the block's re-clear.
import "std/print.rin"
level: region;
step: proc() -> i32 = {
    r: i32 = 0;
    level: region = {
        q: static ?*i32 in level = null;
        if (q) { r = q*; }
        q = new<i32>(level, 42);
    }
    return r;
}
main: proc() -> i32 = { _ = step(); printfmt("{}\n", step()); return 0; }
