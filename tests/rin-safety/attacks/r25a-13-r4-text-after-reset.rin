import "std/print.rin"
import "std/reflect.rin"
import "std/vec.rin"
import "std/cstr.rin"
pt: struct = { x: i32; y: i32; }
color: enum = { a, b }
wrap: struct = { r: reflect; }
level: region global;
main: proc() -> i32 = { line: []char in level = new_slice<char>(level, 8); v: []const char = reflect_text(cstr_of(line)); reset level; printfmt("{}\n", v[0]); return 0; }
