import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        _ = vec<i32>push(v, vec<i32>at(v, 0)*);
        printfmt("{}\n", vec<i32>at(v, 1)*);
    }
    return 0; }
