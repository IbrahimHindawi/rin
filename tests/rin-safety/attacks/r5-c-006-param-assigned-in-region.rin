// H12: a parameter has no borrow record, so assigning it registers nothing.
import "std/print.rin"
level: region;
f: proc(q: option<*i32>) -> i32 = {
    level: region = { q = new<i32>(level, 42); }
    if (q) { return q*; }
    return 0;
}
main: proc() -> i32 = { printfmt("{}\n", f(null)); return 0; }
