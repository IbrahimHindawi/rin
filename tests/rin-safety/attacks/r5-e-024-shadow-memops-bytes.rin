import "std/print.rin"
lv: region;
// A local proc pointer named memops_bytes shadows std's in new_slice's size: tiny block, huge length.
tiny: proc(size: u64, count: u64) -> u64 = { return 16; }
fill: proc<R>(r: region R, n: u64) -> i32 = {
    memops_bytes: *proc(size: u64, count: u64) -> u64 = tiny;
    s: []i32 = new_slice<i32>(r, n);
    s[n - 1] = 7;
    return s[n - 1];
}
main: proc() -> i32 = {
    lv: region = {
        printfmt("{}\n", fill<i32>(lv, 1000000));
    }
    return 0;
}
