import "std/print.rin"
import "std/cstr.rin"
import "std/slice.rin"
smash: proc() -> void = { y: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { y[i] = 0x4141414141414141; } printfmt("{}\n", y[3] == 0); }
main: proc() -> i32 = {
    d: [1]i32 = {};
    ds: []i32 = d;
    big: [64]i32 = {};
    slice<i32>copy_to(ds.data, big);
    printfmt("{}\n", d[0]);
    return 0;
}
