import "std/print.rin"
import "std/cstr.rin"
g: [8]c8 = {};
h: struct = { buf: []c8 in permanent; }
use: proc(s: ^const c8, w: []const h) -> i32 = {
    for (i: u64 = 0; i < w[0].buf.length; i += 1) { w[0].buf[i] = 65; }
    printfmt("{}\n", s);
    return 0;
}
level: region global;
main: proc() -> i32 = { w: []h in level = new_slice<h>(level, 1); w[0].buf = g[0..8]; return use(cstr_of(g[0..8]), w); }
