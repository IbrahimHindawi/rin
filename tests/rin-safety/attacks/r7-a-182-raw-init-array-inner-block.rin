import "std/print.rin"
import "std/fmt.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        f: *fmt in level = fmt_make(level, 4);
        k: [1]^const c8 = { fmt_text(f) };
        for (i: i32 = 0; i < 100; i += 1) { fmt_char(f, 'x'); }
        print_cstr(k[0]);
    }
    return 0;
}
