// A subrange of an array field of a call's result has no borrow source; the slice outlives frame. ASan: use-after-poison.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
main: proc() -> i32 = {
  level: region = {
    z: *S in level = new<S>(level);
    keep: []i32 = z*.y;
    frame: region = {
      v: *vec<S> in frame = vec<S>make(frame, 4);
      s0: S = {};
      s0.x = 7; s0.y[0] = 7; s0.y[1] = 7;
      _ = vec<S>push(v, s0);
      keep = vec<S>at(v, 0)*.y[0..2];
    }
    printfmt("{}\n", keep[0]); // frame has ended: its arena is cleared and poisoned
  }
  return 0;
}
