// A safe proc taking '^const c8' holds it across its own writes: the terminator cstr_of checked
// is gone before cstr_length reads.
import "std/print.rin"
import "std/cstr.rin"
buf: [4]c8 = {};
show: proc(s: ^const c8) -> void = {
    for (i: i32 = 0; i < 4; i += 1) { buf[i] = cast(65, c8); }
    printfmt("{}\n", cstr_length(s));
}
main: proc() -> i32 = {
    show(cstr_of(buf));
    return 0;
}
