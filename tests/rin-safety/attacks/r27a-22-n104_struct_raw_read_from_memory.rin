// Without an array inside the value read: d[0] = s[1], raw in a nested array in a nested struct.
import "std/print.rin"
import "std/fmt.rin"
level: region global;
i1: struct = { names: [2]^const c8; }
i2: struct = { a: i1; }
main: proc() -> i32 = {
    d: *i2 in level = new<i2>(level, { .a = { .names = { "x", "y" } } });
    scratch {
        f: *fmt in scratch = fmt_make(scratch, 8);
        s: *i2 in scratch = new<i2>(scratch, { .a = { .names = { "x", "y" } } });
        s*.a.names[1] = fmt_text(f);
        d*.a = s*.a;
    }
    printfmt("{}\n", cstr_length(d*.a.names[1]));
    return 0;
}
