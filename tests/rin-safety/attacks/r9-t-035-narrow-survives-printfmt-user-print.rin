// printfmt does not end a field path's narrowing, yet runs a user's print<K>, which nulls that field: a null load in a branch the checker thinks is tested.
import "std/print.rin"
K: struct = { x: i32; }
H: struct = { p: option<*i32 in permanent>; }
G: struct = { h: option<*H in permanent>; }
g: G = {};
print: proc<K>(k: K) -> void = {
    if (g.h) { unwrap(g.h)*.p = null; }
}
main: proc() -> i32 = {
    h: *H in permanent = new<H>(permanent);
    h*.p = new<i32>(permanent, 5);
    g.h = h;
    k: K = { .x = 1 };
    if (h*.p) {
        printfmt("{}\n", k);
        printfmt("{}\n", h*.p*);
    }
    return 0;
}
