// An array too big to copy keeps to the slice rule: a static local holding a slice of it.
import "std/print.rin"
import "std/cstr.rin"
big: [5000]c8 = {};
box: proc(put: b32, x: []c8 in permanent) -> void = {
    k: static []c8 in permanent = {};
    if (put) { k = x; return; }
    for (i: u64 = 0; i < k.length; i += 1) { k[i] = 65; }
}
use: proc(s: ^const c8) -> i32 = { e: []c8 in permanent = {}; box(0, e); printfmt("{}\n", s); return 0; }
main: proc() -> i32 = { box(1, big[0..5000]); return use(cstr_of(big)); }
