import "std/print.rin"
import "std/cstr.rin"
import "std/slice.rin"
smash: proc() -> void = { y: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { y[i] = 0x4141414141414141; } printfmt("{}\n", y[3] == 0); }
id_raw: proc(p: ^const c8) -> ^const c8 = { return p; }
gs: [2]str = { "a", "b" };
go: proc() -> void = { buf: [8]c8 = {}; _ = cstr_copy(buf, "abc"); ys: [2]^const c8 = { "a", "b" }; ys[1] = cstr_of(buf); gs = ys; }
main: proc() -> i32 = { go(); smash(); printfmt("{}\n", gs[1]); return 0; }
