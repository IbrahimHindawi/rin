// rin: g[a..b] in the step is a range of the global [2]i32, which is checked. Expect a checked stop.
import "std/print.rin"
g: [2]i32 = {};
a: u64 = 0;
b: u64 = 400000;
use: proc(v: []i32) -> void = { v[399999] = 1; printfmt("HOLE {}\n", v.length); }
main: proc() -> i32 = {
    s: [4]i32 = {};
    for (i: i32 = 0; i < 1; use(g[a..b])) {
        g: []i32 = s;
        g[0] = 1;
        i += 1;
    }
    return 0;
}
