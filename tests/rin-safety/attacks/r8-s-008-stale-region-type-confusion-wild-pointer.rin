// Type confusion, no sanitizer needed: a *T into frame survives its end through at(v,0)*&; frame reopens and fills the same bytes with integers; reading the non-null pointer field dereferences 0x4141414141414141. Faults in any build.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
H: struct = { p: *i32 in level; }
main: proc() -> i32 = {
  level: region = {
    z: H = { .p = new<i32>(level) };
    keep: *H = z&;
    frame: region = {
      v: *vec<H> in frame = vec<H>make(frame, 1);
      h: H = { .p = new<i32>(level) };
      _ = vec<H>push(v, h);
      keep = vec<H>at(v, 0)*&;
    }
    frame: region = {
      w: []u64 in frame = new_slice<u64>(frame, 1024);
      for (i: u64 = 0; i < 1024; i += 1) { w[i] = 0x4141414141414141; }
      printfmt("{}\n", keep*.p*);
    }
  }
  return 0;
}
