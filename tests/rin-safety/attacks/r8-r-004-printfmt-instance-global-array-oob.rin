// Same unchecked printfmt-only instance writing a global array: g[1000] into a [4]i32 global, no RIN_INDEX. ASan: global-buffer-overflow (write).
import "std/print.rin"
box: struct<T> = { x: T; }
g: [4]i32 = {10,20,30,40};
print: proc<box<T>>(b: box<T>) -> void = {
    i: u64 = cast(b.x, u64);
    g[i] = 999;
    print<i32>(g[0]);
}
main: proc() -> i32 = {
    b: box<i32> = { .x = 1000 };
    printfmt("{}\n", b);
    return 0;
}
