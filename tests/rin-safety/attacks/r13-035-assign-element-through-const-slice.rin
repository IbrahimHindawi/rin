// a []const view of a const global's array: s = c[0].a[0]& drops the const on assignment, and s* = 9 faults
import "std/print.rin"
level: region global;
frame: region in level;
perm: i32 = 7;
wa: struct = { a: [4]i32; }
cg: [1]const wa = { { .a = { 1, 2, 3, 4 } } };
main: proc() -> i32 = {
    c: []const wa = cg;
    s: *i32 = perm&;
    s = c[0].a[0]&;
    s* = 9;
    return 0;
}
