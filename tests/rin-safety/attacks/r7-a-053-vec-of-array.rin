import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<[2]i32> in level = vec<[2]i32>make(level, 4);
        a: [2]i32 = { 1, 2 };
        vec<[2]i32>push(v, a);
        printfmt("{}\n", vec<[2]i32>at(v, 0)*[1]);
    }
    return 0;
}
