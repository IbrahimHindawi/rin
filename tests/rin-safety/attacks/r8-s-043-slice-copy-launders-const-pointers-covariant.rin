// No user proc storing: slice<T>copy with T = option<*const i32> takes []option<*i32> as its dst, so const pointers land in a slice typed writable. q* = 9 writes rodata. Segfault in any build.
import "std/print.rin"
import "std/slice.rin"
import "std/vec.rin"
A4: alias = [4]i32;
gi: const i32 = 5;
g: const A4 = {1,2,3,4};
main: proc() -> i32 = {
  a: []option<*i32 in permanent> = new_slice<option<*i32 in permanent>>(permanent, 1);
  b: []option<*const i32 in permanent> = new_slice<option<*const i32 in permanent>>(permanent, 1);
  b[0] = gi&;
  slice<option<*const i32 in permanent>>copy(a, b);
  q: option<*i32 in permanent> = a[0];
  if (q) { q* = 9; }
  printfmt("{}\n", gi);
  return 0;
}
