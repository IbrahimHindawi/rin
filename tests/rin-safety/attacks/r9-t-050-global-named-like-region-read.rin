// A global may share a declared region's name, and emit_region_name then writes it as the arena: level[1] is (&rin_region_level)[1], past the arena: global-buffer-overflow.
import "std/print.rin"
level: region;
level: [4]i32 = {};
main: proc() -> i32 = {
    printfmt("{}\n", level[1]);
    return 0;
}
