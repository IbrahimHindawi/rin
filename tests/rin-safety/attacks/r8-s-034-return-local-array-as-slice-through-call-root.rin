// k = same(y&)*.y: a slice of a local's array, no source, returned. ASan: stack-use-after-return, or a clobbered read.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
same: proc(p: *S) -> *S = { return p; }
f: proc(q: *S) -> []i32 = { y: S = {}; y.y[0] = 7; k: []i32 = same(y&)*.y; return k; }
clobber: proc() -> i32 = { w: [64]i32 = {}; for (i: u64 = 0; i < 64; i += 1) { w[i] = 99; } return w[3]; }
main: proc() -> i32 = {
  z: S = {};
  t: []i32 = f(z&);
  n: i32 = clobber();
  printfmt("{} {}\n", t[0], n);
  return 0;
}
