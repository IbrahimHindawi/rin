// No vec needed: k = new<S>(frame)*.y converts an array field to a slice with no region; k outlives frame (new<S>(frame)*.x& is caught, this is not). ASan: use-after-poison.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
main: proc() -> i32 = {
  level: region = {
    z: *S in level = new<S>(level);
    k: []i32 = z*.y;
    frame: region = {
      k = new<S>(frame)*.y;
    }
    printfmt("{}\n", k[0]);
  }
  return 0;
}
