// Consuming a slice as a parser does, and ranges built from i32.
import "std/print.rin"
import "std/slice.rin"
level: region global;
total_of: proc(xs: []const i32) -> i32 = {
    t: i32 = 0;
    while (xs.length > 0) {
        t += xs[0];
        xs = xs[1..xs.length];
    }
    return t;
}
main: proc() -> i32 = {
    a: [5]i32 = { 1, 2, 3, 4, 5 };
    printfmt("{}\n", total_of(a));
    printfmt("{}\n", total_of(a[1..3]));
    printfmt("{}\n", total_of(a[2..2]));
    s: []i32 = a;
    printfmt("{}\n", slice<i32>sub(s, 3, 99).length);
    printfmt("{}\n", slice<i32>take(s, 2).length);
    printfmt("{}\n", slice<i32>skip(s, 99).length);
    b: i32 = 3;
    e: i32 = 1;
    printfmt("{}\n", total_of(a[b..e]));
    return 0;
}
