// type_collect_regions gives up past depth 6: a local outside the block holds a level pointer.
import "std/print.rin"
level: region;
A0: struct = { p: option<*i32 in level>; }
A1: struct = { a: A0; }
A2: struct = { a: A1; }
A3: struct = { a: A2; }
A4: struct = { a: A3; }
A5: struct = { a: A4; }
A6: struct = { a: A5; }
A7: struct = { a: A6; }
A8: struct = { a: A7; }
main: proc() -> i32 = {
    z: A8 = {};
    level: region = {
        z.a.a.a.a.a.a.a.a.p = new<i32>(level, 42);
    }
    if (z.a.a.a.a.a.a.a.a.p) { printfmt("{}\n", z.a.a.a.a.a.a.a.a.p*); }
    return 0;
}
