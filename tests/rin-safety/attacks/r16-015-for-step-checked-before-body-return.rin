// as 014 with a return after the loop: q's record says a, q holds x: stack-use-after-return at q*
import "std/print.rin"
f: proc(a: *i32) -> *i32 = {
    x: i32 = 7;
    q: *i32 = a;
    for (i: i32 = 0; i < 1; q = x&) { q = a; i += 1; }
    return q;
}
main: proc() -> i32 = { y: i32 = 1; q: *i32 = f(y&); printfmt("{}\n", q*); return 0; }
