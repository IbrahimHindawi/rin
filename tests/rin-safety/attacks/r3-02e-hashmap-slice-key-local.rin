import "std/print.rin"
import "std/hashmap.rin"
level: region;

main: proc() -> i32 = {
    level: region = {
        m: *hashmap<[]c8, i32> in level = hashmap<[]c8, i32>make(level);
        if (1) { k: [3]c8 = { 97, 98, 99 }; _ = hashmap<[]c8, i32>set(m, k[0..3], 7); }
        if (1) { z: [3]c8 = { 120, 121, 122 }; printfmt("{}\n", z[0]); }
        k2: [3]c8 = { 97, 98, 99 };
        printfmt("{}\n", hashmap<[]c8, i32>get_or(m, k2[0..3], -1));
    }
    return 0; }
