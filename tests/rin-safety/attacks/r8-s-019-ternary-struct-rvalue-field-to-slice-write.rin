// (c ? a : b).y is an rvalue struct in C, a temporary copy: the slice dangles, and the write goes to dead stack, not to a. UB per C11 6.2.4p8: expect 7 at -O0 and something else at -O2 (run_rin_vm --compare); ASan stack-use-after-scope where clang marks the temporary. A wrong answer at any level: a.y[0] stays 0.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
mk: proc(n: i32) -> S = { s: S = {}; s.x = n; s.y[0] = n; s.y[1] = n; return s; }
main: proc() -> i32 = {
  a: S = {};
  b: S = {};
  keep: []i32 = (a.x == 0 ? a : b).y;
  other: S = mk(9);
  keep[0] = 1;
  printfmt("{} {} {}\n", keep[0], a.y[0], other.x);
  return 0;
}
