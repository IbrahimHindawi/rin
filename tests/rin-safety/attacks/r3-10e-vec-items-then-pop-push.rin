import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        xs: []i32 = vec<i32>items(v);
        _ = vec<i32>pop(v);
        printfmt("{} {}\n", xs.length, xs[0]);
    }
    return 0; }
