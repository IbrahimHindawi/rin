// A C "proc" with no pointers is callable from safe code; this one is UB by definition.
import "std/print.rin"
__builtin_unreachable: proc[external]() -> void = {}
main: proc() -> i32 = {
    a: [4]i32 = {};
    if (a[0] == 0) { __builtin_unreachable(); }
    printfmt("{}\n", a[0]);
    return 0;
}
