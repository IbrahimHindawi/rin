import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc() -> i32 = {
    level: region = {
        v: *vec<option<*i32 in level>> in level = vec<option<*i32 in level>>make(level, 2);
        frame: region = {
            _ = vec<option<*i32 in frame>>push(v, new<i32>(frame, 42));
        }
        frame: region = { x: []i32 in frame = new_slice<i32>(frame, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } }
        printfmt("{}\n", unwrap(vec<option<*i32 in level>>at(v, 0)*)*);
    }
    return 0;
}
