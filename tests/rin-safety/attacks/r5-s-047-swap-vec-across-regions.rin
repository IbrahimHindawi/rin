// std swap<T> body is wrapped unsafe, so T=vec exchanges two region vecs' headers.
import "std/print.rin"
import "std/vec.rin"
import "std/order.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        keep: *vec<i32> in level = vec<i32>make(level, 1);
        frame: region = {
            tmp: *vec<i32> in frame = vec<i32>make(frame, 4);
            _ = vec<i32>push(tmp, 7);
            swap<vec<i32>>(keep, tmp);
        }
        printfmt("{}\n", vec<i32>at(keep, 0)*); // keep now points into ended frame
    }
    return 0;
}
