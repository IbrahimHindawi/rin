import "std/print.rin"
import "std/reflect.rin"
import "std/vec.rin"
import "std/cstr.rin"
pt: struct = { x: i32; y: i32; }
color: enum = { a, b }
wrap: struct = { r: reflect; }
level: region global;
main: proc() -> i32 = { f: []const reflect_field in permanent = reflect_field_slice(pt<>&); g: []const reflect_field in permanent = f[0..999]; printfmt("{}\n", g[998].offset); return 0; }
