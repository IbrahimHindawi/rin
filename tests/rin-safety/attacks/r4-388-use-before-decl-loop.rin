import "std/print.rin"
H: struct = { x: i32; }
a: H = { .x = 1 };
W: struct = { h: *H in permanent; }
Box: struct<T> = { v: T; }
main: proc() -> i32 = {
    for (i: i32 = 0; i < 2; i += 1) {
        if (i == 1) { goto use; }
        q: *H in permanent = a&;
        use: label = { printfmt("{}\n", q*.x); }
    }
    return 0;
}
