// the second arm says frame outright, but the ternary takes the first arm's region_from_args (level) and frame memory is stored into q; q* after the block is use-after-poison
import "std/print.rin"
level: region global;
frame: region in level;
pick: proc(a: *i32 in R) -> *i32 = { return a; }
main: proc() -> i32 = {
    a: *i32 in level = new<i32>(level, 1);
    q: *i32 in level = a;
    c: i32 = 0;
    frame: region = {
        f: *i32 in frame = new<i32>(frame, 2);
        q = c != 0 ? pick(a) : f;
    }
    printfmt("{}\n", q*);
    return 0;
}
