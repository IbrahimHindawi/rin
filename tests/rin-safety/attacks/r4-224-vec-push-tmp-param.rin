import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc() -> i32 = {
    level: region = {
        v: *vec<?*i32 in level> in level = vec<?*i32 in level>make(level, 2);
        tmp: region of level = {
            q: ?*i32 in tmp = new<i32>(tmp, 42);
            _ = vec<?*i32 in level>push(v, q);
        }
        clobber(level);
        printfmt("{}\n", must(vec<?*i32 in level>at(v, 0)*)*);
    }
    return 0;
}
