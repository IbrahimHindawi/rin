// goto back over a declaration, the old pointer into a scope gone.
import "std/print.rin"
main: proc() -> i32 = {
    k: i32 = 0;
    q: ?*i32 = null;
    top: label = {
        if (q) { printfmt("{}\n", q*); }
        x: i32 = 5;
        q = x&;
        k += 1;
        if (k < 2) { goto top; }
    }
    return 0;
}
