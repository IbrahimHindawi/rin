// i64 * f64 is emitted (i64)((u64)(n) * (u64)(bad)). (u64)(-1e300) is undefined in C.
// At -O2 the poison reaches rin_index_check and the check is deleted: no abort, the store
// goes where the optimiser pleases.
import "std/print.rin"
main: proc() -> i32 = {
    n: i64 = 3;
    bad: f64 = -1e300;
    idx: u64 = cast(n * bad, u64);
    xs: [4]i32 = {};
    xs[idx] = 7;
    printfmt("{}\n", xs[0]);
    return 0;
}
