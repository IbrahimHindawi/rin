// The checker reads the initializer as the global, since the local is not declared yet. In C a declarator is in scope in its own initializer: `i32 * gp = gp;` copies the uninitialized local to itself, and it is then dereferenced. spray leaves a wild value in the same stack slot at -O0. SEGV or UBSan misaligned.
import "std/print.rin"
gv: i32 = 5;
gp: *i32 in permanent = gv&;
spray: proc(k: u64) -> u64 = {
    a: u64 = k; b: u64 = k; c: u64 = k; d: u64 = k; e: u64 = k; f: u64 = k; g: u64 = k; h: u64 = k;
    return a + b + c + d + e + f + g + h;
}
victim: proc() -> i32 = {
    gp: *i32 in permanent = gp;
    return gp*;
}
main: proc() -> i32 = {
    n: u64 = spray(0x4141414141414141);
    printfmt("{} {}\n", n, victim());
    return 0;
}
