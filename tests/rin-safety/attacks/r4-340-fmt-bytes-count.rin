import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
import "std/fmt.rin"
main: proc() -> i32 = {
    level: region = {
        f: *fmt in level = fmt_make(level, 16);
        fmt_bytes(f, "abc", 100000000);
        printfmt("{}\n", fmt_text(f));
    }
    return 0;
}
