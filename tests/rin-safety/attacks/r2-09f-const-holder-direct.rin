import "std/print.rin"
import "std/vec.rin"
level: region;
w: struct = { hp: *vec<i32> in level; }
main: proc() -> i32 = {
    level: region = {
        ww: *w in level = new<w>(level, { .hp = vec<i32>make(level, 1) });
        _ = vec<i32>push(ww*.hp, 1);
        p: *i32 = vec<i32>at(ww*.hp, 0);
        cw: *const w in level = ww;
        for (i: i32 = 0; i < 64; i += 1) { _ = vec<i32>push(cw*.hp, 42); }
        vec<i32>at(ww*.hp, 0)* = 42;
        printfmt("{} (42 if fresh)\n", p*);
    }
    return 0; }
