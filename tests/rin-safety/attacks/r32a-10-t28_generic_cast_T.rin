import "std/print.rin"
S: struct = { a: [4]i32; n: i32; }
mk: proc(v: i32) -> S = { s: S = { .a = { v, v + 1, v + 2, v + 3 }, .n = v }; return s; }
view: proc<T>(t: T) -> []i32 in permanent = { return cast(t, T).a; }
main: proc() -> i32 = { s: []i32 = view<S>(mk(3)); printfmt("{}\n", s[0]); return 0; }
