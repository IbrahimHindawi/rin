// A slice parameter returned back: the callee promises the caller's memory, but the source was a temporary in the argument. Dangles after the statement. UB per C11 6.2.4p8: expect 7 at -O0 and something else at -O2 (run_rin_vm --compare); ASan stack-use-after-scope where clang marks the temporary.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
mk: proc(n: i32) -> S = { s: S = {}; s.x = n; s.y[0] = n; s.y[1] = n; return s; }
pass: proc(s: []i32) -> []i32 = { return s; }
main: proc() -> i32 = {
  keep: []i32 = pass(mk(7).y);
  other: S = mk(9);
  printfmt("{} {}\n", keep[0], other.x);
  return 0;
}
