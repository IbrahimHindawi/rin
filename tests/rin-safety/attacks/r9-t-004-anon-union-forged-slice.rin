// An anonymous union overlays a slice with two u64s: writing r[1] forges its length, so the bounds check passes and the write is far out of bounds.
import "std/print.rin"
Y: struct = { q: []i32 in permanent; }
S: struct = { union = { xs: []i32 in permanent; r: [2]u64; } }
main: proc() -> i32 = {
    s: S = {};
    s.xs = new_slice<i32>(permanent, 1);
    s.r[1] = 100000;
    s.xs[5000] = 1;
    return 0;
}
