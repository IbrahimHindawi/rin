// vec<T>at and vec<T>items take *const and return something writable. No memory error, a const
// promise that is not kept.
import "std/vec.rin"
level: region;
touch: proc(v: *const vec<i32>) -> void = {
    vec<i32>at(v, 0)* = 9;
    s: []i32 = vec<i32>items(v);
    s[0] = 8;
}
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        touch(v);
    }
    return 0;
}
