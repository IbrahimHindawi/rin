import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
f: proc(d: i32) -> i32 = {
    frame: region = {
        x: *i32 in frame = new<i32>(frame, d);
        _ = g2(d);
        return x*;
    }
    return 0;
}
g2: proc(d: i32) -> i32 = { if (d > 0) { return f(d - 1); } return 0; }
main: proc() -> i32 = { printfmt("{}\n", f(2)); return 0; }
