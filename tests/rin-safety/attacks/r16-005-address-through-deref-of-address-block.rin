// `(q&)*&` is Expr_Addr of a Unary, so the '&q' rule (place must be Expr_Name after Field steps) misses it, and expr_path gives `q`, expanded to y: r holds q's own address past its scope: stack-use-after-scope at r**
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    yp: *i32 = y&;
    r: **i32 = yp&;
    if (y > 0) {
        q: *i32 = y&;
        r = (q&)*&;
    }
    printfmt("{}\n", r**);
    return 0;
}
