// i8 + i32: the code says "8 bits", so there is no route through unsigned; C adds in int, and
// INT_MAX + 1 is undefined, where soundness.md says signed + wraps. With n first it wraps and the
// guard fires; with a first the sum is nsw, and clang deletes the guard: over_left returns 0.
import "std/print.rin"
over_left: proc(a: i8, n: i32) -> i32 = {
    if (a > 0) {
        if (a + n < n) { return 1; }
    }
    return 0;
}
over_right: proc(a: i8, n: i32) -> i32 = {
    if (a > 0) {
        if (n + a < n) { return 1; }
    }
    return 0;
}
main: proc() -> i32 = {
    printfmt("{} {}\n", over_left(1, 2147483647), over_right(1, 2147483647));
    return 0;
}
