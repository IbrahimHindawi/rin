import "std/print.rin"
import "std/hashmap.rin"
import "std/cstr.rin"
import "std/fmt.rin"
thing: struct = { x: i64; }
level: region global;
peek: proc<T>(m: *hashmap<i64, T>) -> u64 = { s: []u8 = hashmap<i64, T>states_(m); return s.length; }
main: proc() -> i32 = { m: *hashmap<i64, *thing in level> in level = hashmap<i64, *thing in level>make(level); _ = peek<*thing in level>(m); return 0; }
