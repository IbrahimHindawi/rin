// A declared region opened in main, and opened again from hash_ky: the rule that no region is open twice.
import "std/print.rin"
import "std/hashmap.rin"
ky: struct = { k: i64; }
frame: region;
n: i32 = 0;
hash_ky: proc(k: ky) -> u64 = {
    if (n == 1) {
        n = 2;
        frame: region = { x: *i32 in frame = new<i32>(frame, 1); printfmt("{}\n", x*); }
    }
    return 1;
}
equal_ky: proc(a: ky, b: ky) -> b32 = { return a.k == b.k; }
main: proc() -> i32 = {
    frame: region = {
        m: *hashmap<ky, i32> in frame = hashmap<ky, i32>make(frame);
        hashmap<ky, i32>set(m, { .k = 3 }, 1);
        n = 1;
        printfmt("{}\n", hashmap<ky, i32>get_or(m, { .k = 3 }, 0));
    }
    return 0;
}
