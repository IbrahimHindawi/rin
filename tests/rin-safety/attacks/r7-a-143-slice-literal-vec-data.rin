// vec's raw data field read in safe code, into a forged slice.
import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 4);
        s: []i32 in level = { .data = v*.data, .length = 100000000 };
        s[99999999] = 1;
    }
    return 0;
}
