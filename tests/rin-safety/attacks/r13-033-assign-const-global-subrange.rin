// as 032 with a subrange: s = cg.a[0..1]; s[0] = 5 faults
import "std/print.rin"
level: region global;
frame: region in level;
perm: i32 = 7;
wa: struct = { a: [4]i32; }
cg: const wa = { .a = { 1, 2, 3, 4 } };
main: proc() -> i32 = {
    z: [1]i32 = {};
    s: []i32 = z;
    s = cg.a[0..1];
    s[0] = 5;
    return 0;
}
