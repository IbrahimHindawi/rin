// as 011 with the proc's own scratch block open round the loop: the second pass returns scratch memory, which the return itself ends; q* is use-after-poison
import "std/print.rin"
level: region global;
frame: region in level;
boss: option<*i32 in frame> = null;
f: proc(a: *i32 in R, n: i32) -> *i32 = {
    p: *i32 = a;
    scratch {
      z: *i32 in scratch = new<i32>(scratch, 1);
      for (i: i32 = 0; i < n; i += 1) {
        if (i == 1) { return p; }
        p = z;
      }
    }
    return a;
}
main: proc() -> i32 = {
    a: *i32 in level = new<i32>(level, 1);
    q: *i32 = f(a, 3);
    printfmt("{}\n", q*);
    return 0;
}
