import "std/print.rin"
import "std/hashmap.rin"
level: region;
main: proc() -> i32 = { level: region = { m: *hashmap<i64, i32> in level = hashmap<i64, i32>make(level); p: *i32 = hashmap<i64, i32>set(m, 7, 3); for (k: i64 = 0; k < 5000; k += 1) { _ = hashmap<i64, i32>set(m, k, 1); } hashmap<i64, i32>set(m, 7, 42); printfmt("{}\n", p*); } return 0; }
