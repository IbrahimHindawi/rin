import "std/print.rin"
a: region;
f: proc<R>(r: region R) -> []i32 in R = {
    rin_ret: []i32 in R = new_slice<i32>(r, 4);
    tmp: region of r = {
        return rin_ret;
    }
}
scribble: proc() -> i64 = { a: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { a[i] = 0x7fffffff41414141; } return a[3]; }
main: proc() -> i32 = {
    a: region = {
        _ = scribble();
        s: []i32 in a = f(a);
        printfmt("{}\n", s.length);
        s[1000000] = 1;
    }
    return 0;
}
