// H4: borrow_retake mutates one record, branches save only 'dead'. The last arm's regions win.
import "std/print.rin"
level: region;
main: proc() -> i32 = {
    q: option<*i32> = null;
    c: i32 = 1;
    level: region = {
        if (c == 1) { q = new<i32>(level, 42); } else { q = null; }
    }
    if (q) { printfmt("{}\n", q*); }
    return 0;
}
