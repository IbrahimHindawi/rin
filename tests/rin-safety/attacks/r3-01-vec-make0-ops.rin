import "std/print.rin"
import "std/vec.rin"
level: region;

main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 0);
        printfmt("empty {} len {}\n", vec<i32>is_empty(v), v*.length);
        xs: []i32 = vec<i32>items(v);
        printfmt("items len {}\n", xs.length);
        _ = vec<i32>push(v, 5);
        printfmt("{}\n", vec<i32>at(v, 0)*);
    }
    return 0; }
