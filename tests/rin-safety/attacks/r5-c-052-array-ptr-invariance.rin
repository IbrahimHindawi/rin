// A pointer to an array of region pointers: writing a frame pointer into a *[1]?*i32 aliased as level.
import "std/print.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        o: [1]?*i32 in level = {};
        frame: region = {
            w: *[1]?*i32 in frame = o&;
            w[0] = new<i32>(frame, 42);
        }
        if (o[0]) { printfmt("{}\n", o[0]*); }
    }
    return 0;
}
