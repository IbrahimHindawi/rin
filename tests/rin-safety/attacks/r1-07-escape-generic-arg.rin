import "std/print.rin"
level: region;
frame: region in level;
box: struct<T> = { x: T; }
main: proc() -> i32 = {
    level: region = {
        b: *box<?*i32 in frame> in level = new<box<?*i32 in frame>>(level);
        frame: region = { b*.x = new<i32>(frame); }
        if (b*.x) { printfmt("{}\n", b*.x*); }
    }
    return 0;
}
