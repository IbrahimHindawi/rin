// vec<vec<i32>> in level takes a frame vec's header by push.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        o: *vec<vec<i32>> in level = vec<vec<i32>>make(level, 1);
        frame: region = {
            tmp: *vec<i32> in frame = vec<i32>make(frame, 1);
            _ = vec<i32>push(tmp, 42);
            _ = vec<vec<i32>>push(o, tmp*);
        }
        printfmt("{}\n", vec<i32>at(vec<vec<i32>>at(o, 0), 0)*);
    }
    return 0;
}
