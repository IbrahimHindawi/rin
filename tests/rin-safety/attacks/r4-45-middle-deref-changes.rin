import "std/print.rin"
H: struct = { x: i32; next: option<*H in permanent>; }
S: struct = { h: option<*H in permanent>; n: i32; }
g: S = {};
clr: proc() -> i32 = { g.h = null; return 1; }
clr0: proc() -> i32 = { g.h = null; return 0; }
take: proc(a: i32) -> i32 = { return a; }
take2: proc(a: i32, b: i32) -> i32 = { return a + b; }
fill: proc() -> void = { g.h = new<H>(permanent, { .x = 7, .next = null }); }
W: struct = { s: *S in permanent; }
other: S = {};
gw: W = { .s = g& };
use: proc(w: *W) -> i32 = {
    if (w*.s*.h) {
        pp: **S in permanent = w*.s&;
        pp* = other&;
        return w*.s*.h*.x;
    }
    return 0;
}
main: proc() -> i32 = {
    fill();
    printfmt("{}\n", use(gw&));
    return 0;
}
