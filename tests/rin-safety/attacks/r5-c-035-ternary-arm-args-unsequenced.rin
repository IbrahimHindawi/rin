// A field narrowed by a ternary, read in an argument beside a call that clears it (right-to-left C order).
import "std/print.rin"
H: struct = { x: i32; }
S: struct = { h: option<*H in permanent>; }
g: S = {};
clr: proc() -> i32 = { g.h = null; return 1; }
add: proc(a: i32, b: i32) -> i32 = { return a + b; }
main: proc() -> i32 = {
    g.h = new<H>(permanent, { .x = 7 });
    v: i32 = g.h ? add(g.h*.x, clr()) : 0;
    printfmt("{}\n", v);
    return 0;
}
