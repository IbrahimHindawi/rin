import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
swap: proc<T>(a: *T, b: *T) -> void = { t: T = a*; a* = b*; b* = t; }
main: proc() -> i32 = {
    level: region = {
        keep: *vec<i32> in level = vec<i32>make(level, 1);
        frame: region = { tmp: *vec<i32> in frame = vec<i32>make(frame, 4); _ = vec<i32>push(tmp, 7); swap<vec<i32>>(keep, tmp); }
        frame: region = { z: *vec<i32> in frame = vec<i32>make(frame, 4); _ = vec<i32>push(z, 99); }
        printfmt("{}\n", vec<i32>at(keep, 0)*);
    }
    return 0; }
