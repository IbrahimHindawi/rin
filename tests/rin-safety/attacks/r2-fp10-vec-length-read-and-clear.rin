import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 7);
        n: u64 = v*.length;
        vec<i32>clear(v);
        printfmt("{} {}\n", n, v*.length);
    }
    return 0; }
