// A reader that prints, then writes, then prints: no global, no static.
import "std/print.rin"
import "std/cstr.rin"
level: region global;
h: struct = { buf: []c8 in level; }
use: proc(s: ^const c8, w: h) -> i32 = {
    printfmt("{}\n", s);
    for (i: u64 = 0; i < w.buf.length; i += 1) { w.buf[i] = 65; }
    printfmt("{}\n", s);
    return 0;
}
main: proc() -> i32 = {
    b: []c8 in level = new_slice<c8>(level, 8);
    w: h = {.buf = b};
    return use(cstr_of(b), w);
}
