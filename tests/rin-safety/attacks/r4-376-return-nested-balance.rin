import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
f: proc(r: region R, i: i32) -> i32 = {
    a: region of r = {
        b: region of a = {
            c: region of b = {
                x: *i32 in c = new<i32>(c, i);
                return x*;
            }
        }
    }
    return 0;
}
main: proc() -> i32 = {
    level: region = {
        s: i32 = 0;
        for (i: i32 = 0; i < 400; i += 1) { s += f(level, 1); }
        printfmt("{}\n", s);
    }
    return 0;
}
