import "std/print.rin"
level: region;
node: struct = { v: i32; next: option<*node in level>; }
main: proc() -> i32 = {
    level: region = {
        n: *node in level = new<node>(level, { .v = 1, .next = null });
        p: option<*node in level> = n;
        while (p) { p = p*.next; printfmt("{}\n", p*.v); }
    }
    return 0;
}
