import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    t: i32 = 0;
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 1);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>at(v, 0);
        for (i: i32 = 0; i < 50; i += 1) {
            if (i < 10) { t += 1; } else { if (i == 10) { for (j: i32 = 0; j < 100; j += 1) { _ = vec<i32>push(v, j); } } else { continue; } }
        }
        printfmt("{} {}\n", p*, t);
    }
    return 0;
}
