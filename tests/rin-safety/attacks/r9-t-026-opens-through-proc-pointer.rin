// "A proc that opens a region cannot be a proc pointer" reads the same incomplete set, so wrap goes through a pointer: use-after-poison.
import "std/print.rin"
level: region;
K: struct = { x: i32; }
foo: proc<K>(k: K) -> void = {
    level: region = { }
}
wrap: proc(k: K) -> void = { foo<K>(k); }
main: proc() -> i32 = {
    f: *proc(k: K) -> void = wrap;
    level: region = {
        p: *i32 in level = new<i32>(level, 7);
        k: K = { .x = 1 };
        f(k);
        printfmt("{}\n", p*);
    }
    return 0;
}
