import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc() -> i32 = {
    level: region = {
        frame: region = {
            x: *i32 in frame = new<i32>(frame, 42);
            for (j: i32 = 0; j < 3; j += 1) { if (j == 1) { break; } }
            do { continue; } while (0);
            switch (1) { default: { break; } }
            y: *i32 in frame = new<i32>(frame, 7);
            printfmt("{} {}\n", x*, y*);
        }
    }
    return 0;
}
