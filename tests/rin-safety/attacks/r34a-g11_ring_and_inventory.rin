// A ring buffer with signed and unsigned arithmetic, and a full inventory: the off-by-ones.
import "std/print.rin"
ring: struct = { data: [8]i32; head: u32; tail: u32; }
player: struct = { items: [4]i32; count: u8; }
push: proc(r: *ring, v: i32) -> void = {
    r*.data[r*.head % 8] = v;
    r*.head += 1;
}
back: proc(r: *ring) -> i32 = { return r*.data[(r*.head - 1) % 8]; }
sback: proc(r: *ring) -> i32 = {
    h: i32 = cast(r*.head, i32);
    return r*.data[(h - 1) % 8];
}
give: proc(p: *player, id: i32) -> void = {
    p*.items[p*.count] = id;
    p*.count += 1;
}
main: proc() -> i32 = {
    r: ring = {};
    push(r&, 5);
    printfmt("{} {}\n", back(r&), sback(r&));
    r.head = 0;
    printfmt("{}\n", back(r&));
    p: player = {};
    for (i: i32 = 0; i < 4; i += 1) { give(p&, i); }
    printfmt("{}\n", p.count);
    printfmt("{}\n", sback(r&));
    return 0;
}
