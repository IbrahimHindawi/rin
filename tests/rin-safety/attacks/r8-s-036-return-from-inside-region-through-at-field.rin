// Inside the region block: k = at(v,0)*.x&; return k. The return rule for a region pointer never sees frame, and the caller reads the cleared arena. ASan: use-after-poison.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
same: proc(p: *S) -> *S = { return p; }
f: proc(q: *S) -> *i32 = {
  frame: region = {
    v: *vec<S> in frame = vec<S>make(frame, 1);
    s0: S = {};
    _ = vec<S>push(v, s0);
    k: *i32 = vec<S>at(v, 0)*.x&;
    return k;
  }
  return q*.x&;
}
main: proc() -> i32 = { z: S = {}; printfmt("{}\n", f(z&)*); return 0; }
