import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
pass: proc(p: *i32) -> *i32 = { return p; }
main: proc() -> i32 = {
    level: region = {
        o: i32 = 1;
        q: *i32 = o&;
        tmp: region of level = {
            x: *i32 in tmp = new<i32>(tmp, 42);
            q = pass(x);
        }
        clobber(level);
        printfmt("{}\n", q*);
    }
    return 0;
}
