// the const test reads g->type->is_const, false for an alias of a const type: memset at the region end writes a const object in read-only memory, and faults
import "std/print.rin"
level: region;
frame: region in level;
enemy: struct = { hp: i32; pad: [8]i64; }
game: struct = { enemies: []enemy in level; boss: option<*enemy in level>; }
g: game = {};
load: proc(r: region level, n: u64) -> void = { reset r; g.enemies = new_slice<enemy>(r, n); g.boss = g.enemies[0]&; }
wipe: proc(r: region level) -> i32 = { reset r; return 0; }
mk: proc(r: region level) -> enemy = { reset r; e: enemy = {}; return e; }
ca: alias = const game;
x: ca = {};
main: proc() -> i32 = { level: region = { load(level, 1); } printfmt("{}\n", x.enemies.length); return 0; }
