// A slice of slices: outer in level, inner naming frame, laundered through assignment.
import "std/print.rin"
level: region;
frame: region in level;
main: proc() -> i32 = {
    level: region = {
        outer: [][]option<*i32 in level> = new_slice<[]option<*i32 in level>>(level, 1);
        frame: region = {
            inner: []option<*i32 in frame> = new_slice<option<*i32 in frame>>(frame, 1);
            inner[0] = new<i32>(frame, 42);
            outer[0] = inner;
        }
        if (outer[0][0]) { printfmt("{}\n", outer[0][0]*); }
    }
    return 0;
}
