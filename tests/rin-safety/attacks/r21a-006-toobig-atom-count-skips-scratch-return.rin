// Same fail-open limit reached through the atom count instead: each block creates an atom, and 550
// "scratch { }" blocks push sh->atoms past ShBits (512), so sh->too_big is set and the proc is
// accepted unchecked. The leading scratch block returns h, a pointer into scratch memory that is
// freed when the block ends (rejected in any normal proc); the caller dereferences it after bad()
// returns: use-after-poison under ASan.
import "std/print.rin"
bad: proc() -> *i32 = {
    scratch { h: *i32 in scratch = new<i32>(scratch, 9); return h; }
