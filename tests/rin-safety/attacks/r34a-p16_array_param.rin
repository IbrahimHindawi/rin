// An array passed by value and changed in the callee; what does the caller see? A struct holding one, for comparison.
import "std/print.rin"
pal: struct = { colors: [4]i32; }
tint: proc(c: [4]i32) -> i32 = {
    c[0] = 99;
    local: [4]i32 = {};
    local = c;
    local[1] = 77;
    return local[0] + c[1];
}
tint_struct: proc(p: pal) -> i32 = {
    p.colors[0] = 99;
    return p.colors[0];
}
get_row: proc() -> pal = {
    p: pal = { .colors = { 1, 2, 3, 4 } };
    return p;
}
main: proc() -> i32 = {
    a: [4]i32 = { 1, 2, 3, 4 };
    printfmt("{}\n", tint(a));
    printfmt("{} {}\n", a[0], a[1]);
    p: pal = { .colors = { 1, 2, 3, 4 } };
    printfmt("{}\n", tint_struct(p));
    printfmt("{}\n", p.colors[0]);
    printfmt("{}\n", get_row().colors[2]);
    q: pal = p;
    q.colors[3] = 50;
    printfmt("{} {}\n", p.colors[3], q.colors[3]);
    return 0;
}
