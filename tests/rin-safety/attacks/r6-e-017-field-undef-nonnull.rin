import "std/print.rin"
// Field pre-directive redefines rin_nonnull so unwrap() on a null passes through.
S: struct = {
#define rin_nonnull(p) (p)
    x: i32;
}
g: i32 = 5;
find: proc(b: b32) -> option<*i32> = { if (b) { return null; } return g&; }
main: proc() -> i32 = {
    p: *i32 = unwrap(find(true));
    printfmt("{}\n", p*);
    return 0;
}
