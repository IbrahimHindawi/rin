import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
assign: proc(r: region R, slot: *option<*i32 in R>, v: *i32 in R) -> void = { slot* = v; }
main: proc() -> i32 = {
    level: region = {
        o: option<*i32 in level> = null;
        tmp: region of level = { assign(tmp, o&, new<i32>(tmp, 42)); }
        clobber(level);
        printfmt("{}\n", unwrap(o)*);
    }
    return 0;
}
