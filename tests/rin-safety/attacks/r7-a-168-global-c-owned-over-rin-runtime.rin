// The runtime's own arena stack, named as a global: not a definition so exempt.
import "std/print.rin"
level: region;
rin_region_stack_top: i32;
down: proc() -> void = { rin_region_stack_top = -5; }
main: proc() -> i32 = {
    down();
    tmp: region of permanent = {
        x: *i32 in tmp = new<i32>(tmp, 1);
        printfmt("{}\n", x*);
    }
    return 0;
}
