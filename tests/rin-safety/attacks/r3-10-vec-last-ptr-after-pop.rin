import "std/print.rin"
import "std/vec.rin"
level: region;
main: proc() -> i32 = {
    level: region = {
        v: *vec<i32> in level = vec<i32>make(level, 2);
        _ = vec<i32>push(v, 1);
        p: *i32 = vec<i32>last(v);
        _ = vec<i32>pop(v);
        printfmt("{}\n", p*);
    }
    return 0; }
