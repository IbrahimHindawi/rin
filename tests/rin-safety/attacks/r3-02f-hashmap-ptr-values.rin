import "std/print.rin"
import "std/hashmap.rin"
level: region;

main: proc() -> i32 = {
    level: region = {
        m: *hashmap<i64, *i32 in level> in level = hashmap<i64, *i32 in level>make(level);
        for (i: i64 = 0; i < 50; i += 1) { p: *i32 in level = new<i32>(level); p* = cast(i, i32); _ = hashmap<i64, *i32 in level>set(m, i, p); }
        q: ?**i32 in level = hashmap<i64, *i32 in level>get(m, 49);
        printfmt("{}\n", q ? q**  : -1);
    }
    return 0; }
