// type_is_carrier gives up past depth 8: a by-value struct with a no-region pointer returns a local's address.
import "std/print.rin"
A0: struct = { p: option<*i32>; }
A1: struct = { a: A0; }
A2: struct = { a: A1; }
A3: struct = { a: A2; }
A4: struct = { a: A3; }
A5: struct = { a: A4; }
A6: struct = { a: A5; }
A7: struct = { a: A6; }
A8: struct = { a: A7; }
A9: struct = { a: A8; }
A10: struct = { a: A9; }
smash: proc() -> void = { y: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { y[i] = 0x4141414141414141; } printfmt("{}\n", y[3] == 0); }
leak: proc() -> A10 = {
    x: i32 = 42;
    z: A10 = { .a = { .a = { .a = { .a = { .a = { .a = { .a = { .a = { .a = { .a = { .p = x& } } } } } } } } } } };
    return z;
}
main: proc() -> i32 = {
    z: A10 = leak();
    smash();
    if (z.a.a.a.a.a.a.a.a.a.a.p) { printfmt("{}\n", z.a.a.a.a.a.a.a.a.a.a.p*); }
    return 0;
}
