// A *void round-trips a pointer to a small struct as a pointer to a larger one.
import "std/print.rin"
small: struct = { a: u8; }
big: struct = { a: u64; b: u64; c: u64; d: u64; }
main: proc() -> i32 = {
    s: *small in permanent = new<small>(permanent, { .a = 1 });
    guard: *u64 in permanent = new<u64>(permanent, 7);
    v: *void = s;
    b: *big = v;
    b*.a = 0x4141414141414141;
    b*.b = 0x4141414141414141;
    b*.c = 0x4141414141414141;
    b*.d = 0x4141414141414141;
    printfmt("{}\n", guard*);
    return 0;
}
