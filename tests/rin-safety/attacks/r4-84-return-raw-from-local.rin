import "std/print.rin"
import "std/cstr.rin"
import "std/slice.rin"
smash: proc() -> void = { y: [64]i64 = {}; for (i: i32 = 0; i < 64; i += 1) { y[i] = 0x4141414141414141; } printfmt("{}\n", y[3] == 0); }
id_raw: proc(p: ^const c8) -> ^const c8 = { return p; }
f: proc() -> ^const c8 = { buf: [8]c8 = {}; _ = cstr_copy(buf, "abc"); return cstr_of(buf); }
main: proc() -> i32 = { p: ^const c8 = f(); smash(); print_cstr(p); return 0; }
