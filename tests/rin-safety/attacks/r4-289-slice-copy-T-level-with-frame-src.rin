import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
main: proc() -> i32 = {
    level: region = {
        d: []option<*i32 in level> in level = new_slice<option<*i32 in level>>(level, 1);
        frame: region = {
            s: []option<*i32 in frame> in frame = new_slice<option<*i32 in frame>>(frame, 1);
            s[0] = new<i32>(frame, 42);
            slice<option<*i32 in level>>copy(d, s);
        }
        frame: region = { x: []i32 in frame = new_slice<i32>(frame, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } }
        printfmt("{}\n", unwrap(d[0])*);
    }
    return 0;
}
