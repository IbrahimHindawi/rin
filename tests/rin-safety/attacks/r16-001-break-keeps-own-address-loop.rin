// the state a `break` carries kills non-pointer locals only (Stmt_Break skips Type_Ptr/slice before any own_address_path kill): r holds &q past q's scope, stack-use-after-scope at r**
import "std/print.rin"
main: proc() -> i32 = {
    y: i32 = 1;
    yp: *i32 = y&;
    r: **i32 = yp&;
    for (i: i32 = 0; i < 2; i += 1) {
        if (i == 0) {
            q: *i32 = y&;
            r = q&;
            break;
        }
    }
    printfmt("{}\n", r**);
    return 0;
}
