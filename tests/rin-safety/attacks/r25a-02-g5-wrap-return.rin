import "std/print.rin"
import "std/reflect.rin"
import "std/vec.rin"
import "std/cstr.rin"
pt: struct = { x: i32; y: i32; }
color: enum = { a, b }
wrap: struct = { r: reflect; }
level: region global;
make: proc() -> wrap = { return { .r = { .count = 1000 } }; }
main: proc() -> i32 = { w: *wrap in level = new<wrap>(level); w* = make(); printfmt("{}\n", reflect_field_at(w*.r&, 999) != null); return 0; }
