import "std/print.rin"
import "std/vec.rin"
import "std/slice.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
g2: proc(x: region S, y: region R) -> *i32 in R = { return new<i32>(y, 42); }
h: proc(a: region R, b: region S) -> *i32 in R = { return g2(a, b); }
main: proc() -> i32 = {
    level: region = {
        k: *i32 in level = new<i32>(level, 1);
        tmp: region of level = { k = h(level, tmp); }
        clobber(level);
        printfmt("{}\n", k*);
    }
    return 0;
}
