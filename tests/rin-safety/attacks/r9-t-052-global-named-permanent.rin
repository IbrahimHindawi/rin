// As 050, with the name 'permanent', which is always a region: permanent[1] is rin_region_open(&rin_region_permanent)[1], past the arena: global-buffer-overflow.
import "std/print.rin"
level: region;
permanent: [4]i32 = {};
main: proc() -> i32 = {
    printfmt("{}\n", permanent[1]);
    return 0;
}
