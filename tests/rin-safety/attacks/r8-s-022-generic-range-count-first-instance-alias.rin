// Same stale count in rin_array_range: a[0..i] on the A4 instance checks 400 and hands back a 300-long slice of a 4-long array; the index on the slice then passes. ASan: stack-buffer-overflow.
import "std/print.rin"
#define CNT 4
A4: alias = [4]i32;
A400: alias = [400]i32;
AC: alias = [CNT]i32;
get: proc<A>(a: *A, i: u64) -> i32 = { s: []i32 = a*[0..i]; return s[i - 1]; }
main: proc() -> i32 = {
  big: A400 = {};
  small: A4 = {};
  printfmt("{}\n", get<A400>(big&, 300));
  printfmt("{}\n", get<A4>(small&, 300));
  return 0;
}
