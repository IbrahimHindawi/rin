// expr_place_is_const does not look into a ternary: c ? g : a with g a const global becomes a writable []i32, and s[0] = 9 writes rodata. Segfault in any build.
import "std/print.rin"
import "std/slice.rin"
import "std/vec.rin"
A4: alias = [4]i32;
gi: const i32 = 5;
g: const A4 = {1,2,3,4};
main: proc() -> i32 = { a: A4 = {}; s: []i32 = a[0] == 0 ? g : a; s[0] = 9; printfmt("{}\n", g[0]); return 0; }
