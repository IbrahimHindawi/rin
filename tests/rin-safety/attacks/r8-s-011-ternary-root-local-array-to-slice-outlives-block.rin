// Stack: an array field of a ternary's pointer converts to a slice with no source; it outlives the block. ASan: stack-use-after-scope.
import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
S: struct = { x: i32; y: [4]i32; }
main: proc() -> i32 = {
  z: S = {};
  keep: []i32 = z.y;
  if (z.x == 0) {
    y: S = {};
    y.y[0] = 7;
    keep = (z.x == 0 ? y& : y&)*.y;
  }
  printfmt("{}\n", keep[0]);
  return 0;
}
