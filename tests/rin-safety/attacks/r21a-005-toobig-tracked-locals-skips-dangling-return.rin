// shadow_check_proc fails OPEN on its resource limits, contradicting the "fail closed" claim. When
// sh->tracked exceeds ShBits (512) the pass prints a stderr "too big" line and returns WITHOUT any
// type_error (line ~20898): the whole proc is accepted unchecked. The 600 slice locals blow the limit,
// so "return x&" -- a dangling stack address, rejected in any normal proc -- is emitted; the caller
// dereferences it after bad() returns: stack-use-after-return under ASan.
import "std/print.rin"
level: region global;
bad: proc() -> *i32 = {
    s0: []i32 in level = {};
    s1: []i32 in level = {};
    s2: []i32 in level = {};
