import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
put: proc(r: region R, s: []?*i32 in R, v: *i32 in R) -> void = { s[0] = v; }
main: proc() -> i32 = {
    level: region = {
        xs: []?*i32 in level in level = new_slice<?*i32 in level>(level, 1);
        tmp: region of level = { put(tmp, xs, new<i32>(tmp, 42)); }
        clobber(level);
        printfmt("{}\n", must(xs[0])*);
    }
    return 0;
}
