import "std/print.rin"
import "std/vec.rin"
level: region;
frame: region in level;
H: struct = { x: i32; }
clobber: proc(r: region R) -> void = { t: region of r = { x: []i32 in t = new_slice<i32>(t, 64); for (i: u64 = 0; i < 64; i += 1) { x[i] = 99; } } }
Box: struct<T> = { v: T; }
mk: proc(r: region R) -> Box<option<*i32 in R>> = { b: Box<option<*i32 in R>> = { .v = new<i32>(r, 42) }; return b; }
main: proc() -> i32 = {
    level: region = {
        b: Box<option<*i32 in level>> = { .v = null };
        tmp: region of level = { b = mk(tmp); }
        clobber(level);
        printfmt("{}\n", unwrap(b.v)*);
    }
    return 0;
}
