    "macro-call": {
      "comment": "A statement that starts with name( is a macro invocation.",
      "match": "^\\s*(?:(invoke|vcall)|([A-Za-z_]\\w*))\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "support.function.macro.rasm"
        },
        "2": {
          "name": "entity.name.function.macro.rasm"
        }
      }
    },
    "attribute": {
      "comment": "proc[external], enum[must_use], enum[u32], u32[align(16)]",
      "patterns": [
        {
          "match": "(?:(?<=\\bproc)|(?<=\\bstruct)|(?<=\\bunion)|(?<=\\benum)|(?<=\\balias))(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.begin.rasm"
            },
            "2": {
              "name": "entity.other.attribute-name.rasm"
            },
            "3": {
              "name": "punctuation.definition.attribute.end.rasm"
            }
          }
        },
        {
          "match": "(?<=\\w)(\\[)(\\s*(?:external|external_emit|static|packed|align|callconv|must_use|no_layout_check)\\b[^\\]]*)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.begin.rasm"
            },
            "2": {
              "name": "entity.other.attribute-name.rasm"
            },
            "3": {
              "name": "punctuation.definition.attribute.end.rasm"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.import.rasm",
          "match": "\\b(?:import|cinclude)\\b"
        },
        {
          "name": "storage.type.rasm",
          "match": "\\b(?:struct|union|enum|alias|proc|macro)\\b"
        },
        {
          "name": "storage.modifier.rasm",
          "match": "\\bconst\\b"
        },
        {
          "name": "constant.language.rasm",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "support.function.macro.rasm",
          "match": "\\b(?:invoke|vcall)\\b"
        }
      ]
    },
    "builtin": {
      "name": "support.function.builtin.rasm",
      "match": "\\b(?:sizeof|alignof|offsetof|cast)\\b"
    },
    "primitive-type": {
      "name": "storage.type.primitive.rasm",
      "match": "\\b(?:u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|b8|b16|b32|b64|c8|usize|isize|void|char|bool|short|int|long|ulong|float|double|intptr|uintptr|ptrdiff|intmax|uintmax)\\b"
    },
    "type-reference": {
      "comment": "A struct, enum or alias name in a type position: after ':', '->', '*', '[N]', 'const' or 'alias ='. Oniguruma lookbehind must be fixed-width per branch, so the common spacings are spelled out.",
      "match": "(?:(?<=:)|(?<=:\\s)|(?<=->)|(?<=->\\s)|(?<=\\])|(?<=\\bconst\\s)|(?<=[:(,]\\*)|(?<=[:(,]\\s\\*)|(?<=->\\s\\*)|(?<=\\*\\*)|(?<=\\]\\*)|(?<=\\balias\\s=\\s)|(?<=\\balias\\s=\\s\\*)|(?<=\\]\\s=\\s)|(?<=\\]\\s=\\s\\*))(?!(?:const|proc|struct|union|enum|alias|macro)\\b)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "entity.name.type.rasm"
        }
      }
    },
    "parameter": {
      "match": "(?<=[(,])\\s*([A-Za-z_]\\w*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.parameter.rasm"
        }
      }
    },
    "register": {
      "comment": "Registers are keywords in rasm, lowercase only, as in the lexer.",
      "name": "variable.language.register.rasm",
      "match": "\\b(?:r(?:[abcd]x|[sd]i|[bs]p|ip|(?:8|9|1[0-5])[dwb]?)|e(?:[abcd]x|[sd]i|[bs]p)|[abcd]x|[sd]i|[bs]p|[abcd][lh]|sil|dil|bpl|spl|[xyz]mm\\d+|k\\d)\\b"
    },
    "size": {
      "name": "storage.type.size.rasm",
      "match": "\\b(?:byte|word|dword|qword|tbyte|oword|xmmword|ymmword|zmmword|ptr)\\b"
    },
    "memory": {
      "comment": "[reg + ...], and the type of a typed path: [rbx].body.id, [r10].ID3D11DeviceVtbl.CreateBuffer. Not after a name, so bodies[1] is an index. Ends at the end of the line too, so an unbalanced [ cannot run on.",
      "name": "meta.memory.rasm",
      "begin": "(?<![\\w\\]])\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.memory.begin.rasm"
        }
      },
      "end": "(\\])(?:(\\.)([A-Za-z_]\\w*))?(?:(?<=Vtbl)(\\.)([A-Za-z_]\\w*))?|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.memory.end.rasm"
        },
        "2": {
          "name": "punctuation.accessor.rasm"
        },
        "3": {
          "name": "entity.name.type.rasm"
        },
        "4": {
          "name": "punctuation.accessor.rasm"
        },
        "5": {
          "name": "entity.name.function.member.rasm"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#register"
        },
        {
          "include": "#size"
        },
        {
          "include": "#builtin"
        },
        {
          "include": "#primitive-type"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#memory"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constant"
        }
      ]
    },
    "vtbl": {
      "comment": "COM vtables are structs of proc pointers: ID3D11DeviceVtbl.CreateBuffer.",
      "match": "\\b([A-Za-z_]\\w*Vtbl)(\\.)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "entity.name.type.rasm"
        },
        "2": {
          "name": "punctuation.accessor.rasm"
        },
        "3": {
          "name": "entity.name.function.member.rasm"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.rasm",
          "match": "->"
        },
        {
          "comment": "The address-of suffix, a link-time constant: window_proc&, c.transform&",
          "name": "keyword.operator.address.rasm",
          "match": "(?<=[\\w\\]])&(?=\\s*(?:[,)};\\]]|$))"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rasm",
          "match": "(?<![\\w.])0[xX][0-9A-Fa-f_]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.binary.rasm",
          "match": "(?<![\\w.])0[bB][01_]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.float.rasm",
          "match": "(?<![\\w.])(?:(?<![\\w)\\]])-)?\\d[\\d_]*(?:\\.\\d+(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)[fF]?\\b"
        },
        {
          "name": "constant.numeric.integer.rasm",
          "match": "(?<![\\w.])(?:(?<![\\w)\\]])-)?\\d[\\d_]*[uUlL]*\\b"
        }
      ]
    },
    "constant": {
      "comment": "ALL_CAPS names: #define constants, enum members, Win32 constants. A naming convention, not something rasm knows.",
      "name": "variable.other.constant.rasm",
      "match": "\\b[A-Z][A-Z0-9_]+\\b"
    }
  }
}
