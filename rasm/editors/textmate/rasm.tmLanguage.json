?|uds?))|w(?:s(?:sds?|uds?)|u(?:sds?|uds?)))|e(?:rm(?:2(?:f128|i128)|b|d|i(?:2(?:b|d|p(?:d|s)|q|w)|lp(?:d|s))|p(?:d|s)|q|t2(?:b|d|p(?:d|s)|q|w)|w)|x(?:pand(?:b|d|q|w)|tr(?:b|d|q|w)))|gather(?:d(?:d|q)|q(?:d|q))|h(?:add(?:d|sw|w)|minposuw|sub(?:d|sw|w))|insr(?:b|d|q|w)|lzcnt(?:d|q)|m(?:a(?:dd(?:52(?:huq|luq)|ubsw|wd)|skmov(?:d|q)|x(?:s(?:b|d|q|w)|u(?:b|d|q|w)))|in(?:s(?:b|d|q|w)|u(?:b|d|q|w))|ov(?:b2m|d(?:2m|b|w)|m(?:2(?:b|d|q|w)|skb)|q(?:2m|b|d|w)|s(?:d(?:b|w)|q(?:b|d|w)|wb|x(?:b(?:d|q|w)|dq|w(?:d|q)))|us(?:d(?:b|w)|q(?:b|d|w)|wb)|w(?:2m|b)|zx(?:b(?:d|q|w)|dq|w(?:d|q)))|ul(?:dq|h(?:rsw|uw|w)|l(?:d|q|w)|tishiftqb|udq))|o(?:pcnt(?:b|d|q|w)|r(?:d|q)?)|ro(?:l(?:d|q|v(?:d|q))|r(?:d|q|v(?:d|q)))|s(?:adbw|catter(?:d(?:d|q)|q(?:d|q))|h(?:ld(?:d|q|v(?:d|q|w)|w)|rd(?:d|q|v(?:d|q|w)|w)|uf(?:b(?:itqmb)?|d|hw|lw))|ign(?:b|d|w)|ll(?:dq?|q|v(?:d|q|w)|w)|r(?:a(?:d|q|v(?:d|q|w)|w)|l(?:dq?|q|v(?:d|q|w)|w))|ub(?:b|d|q|s(?:b|w)|us(?:b|w)|w))|te(?:rnlog(?:d|q)|st(?:m(?:b|d|q|w)|nm(?:b|d|q|w))?)|unpck(?:h(?:bw|dq|qdq|wd)|l(?:bw|dq|qdq|wd))|xor(?:d|q)?)|r(?:ange(?:p(?:d|s)|s(?:d|s))|cp(?:14(?:p(?:d|s)|s(?:d|s))|p(?:h|s)|s(?:h|s))|educe(?:p(?:d|h|s)|s(?:d|h|s))|ndscale(?:p(?:d|h|s)|s(?:d|h|s))|ound(?:p(?:d|s)|s(?:d|s))|sqrt(?:14(?:p(?:d|s)|s(?:d|s))|p(?:h|s)|s(?:h|s)))|s(?:ca(?:lef(?:p(?:d|h|s)|s(?:d|h|s))|tter(?:dp(?:d|s)|qp(?:d|s)))|h(?:a512(?:msg(?:1|2)|rnds2)|uf(?:f(?:32x4|64x2)|i(?:32x4|64x2)|p(?:d|s)))|m(?:3(?:msg(?:1|2)|rnds2)|4(?:key4|rnds4))|qrt(?:p(?:d|h|s)|s(?:d|h|s))|tmxcsr|ub(?:p(?:d|h|s)|s(?:d|h|s)))|testp(?:d|s)|u(?:comis(?:d|h|s)|npck(?:hp(?:d|s)|lp(?:d|s)))|xorp(?:d|s)|zero(?:all|upper))|w(?:ait|binvd|r(?:fsbase|gsbase|msr))|x(?:add|chg|getbv|latb?|or(?:p(?:d|s))?|rstor(?:64|s)?|s(?:ave(?:64|c|opt|s)?|etbv))))\\b(?!\\s*[:(])",
