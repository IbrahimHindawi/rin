{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rasm",
  "scopeName": "source.rasm",
  "fileTypes": [
    "rasm"
  ],
  "comment": "rasm: x64 assembler with rin's declarations. See rasm/docs/spec.md. repository.instruction is generated by editors/tools/gen_mnemonics.py; edit the script, not the regex.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#label"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#macro-call"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#primitive-type"
    },
    {
      "include": "#type-reference"
    },
    {
      "include": "#parameter"
    },
    {
      "include": "#register"
    },
    {
      "include": "#size"
    },
    {
      "include": "#memory"
    },
    {
      "include": "#vtbl"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#number"
    },
    {
      "include": "#constant"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.rasm",
      "begin": ";",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.rasm"
        }
      },
      "end": "$",
      "patterns": [
        {
          "name": "keyword.other.todo.rasm",
          "match": "\\b(?:TODO|FIXME|XXX|NOTE|HACK|INTERESTING)\\b"
        }
      ]
    },
    "preprocessor": {
      "comment": "C's preprocessor. An object-like #define is the only # line rasm accepts; a ';' in it is an error, not a comment, because C would read it as part of the value.",
      "patterns": [
        {
          "name": "meta.preprocessor.define.rasm",
          "begin": "^\\s*(#)\\s*(define)\\b(?:\\s+([A-Za-z_]\\w*))?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.directive.rasm"
            },
            "2": {
              "name": "keyword.control.directive.define.rasm"
            },
            "3": {
              "name": "entity.name.function.preprocessor.rasm"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "invalid.illegal.semicolon-in-define.rasm",
              "match": ";.*$"
            },
            {
              "include": "#string"
            },
            {
              "include": "#char"
            },
            {
              "include": "#builtin"
            },
            {
              "include": "#primitive-type"
            },
            {
              "include": "#number"
            },
            {
              "include": "#constant"
            }
          ]
        },
        {
          "name": "invalid.illegal.directive.rasm",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.rasm",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.rasm"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.rasm"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "constant.other.placeholder.rasm",
          "match": "%[-+ #0]*(?:\\d+|\\*)?(?:\\.(?:\\d+|\\*))?(?:hh|h|ll|l|I64|I32|I|z|j|t|L)?[diouxXcsSpfFeEgGaA%]"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.rasm",
      "match": "'(?:\\\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|.)|[^'\\\\])'",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      }
    },
    "escape": {
      "name": "constant.character.escape.rasm",
      "match": "\\\\(?:[abfnrtv\\\\'\"?]|x[0-9A-Fa-f]+|[0-7]{1,3})"
    },
    "label": {
      "comment": "name: alone on its line. Labels are proc-scoped.",
      "match": "^\\s*([A-Za-z_]\\w*)(:)\\s*(?=;|$)",
      "captures": {
        "1": {
          "name": "entity.name.label.rasm"
        },
        "2": {
          "name": "punctuation.separator.label.rasm"
        }
      }
    },
    "declaration": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(:)\\s*(?=proc\\b)",
          "captures": {
            "1": {
              "name": "entity.name.function.rasm"
            },
            "2": {
              "name": "punctuation.separator.declaration.rasm"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(:)\\s*(?=macro\\b)",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.rasm"
            },
            "2": {
              "name": "punctuation.separator.declaration.rasm"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(:)\\s*(?=(?:struct|union|enum|alias)\\b)",
          "captures": {
            "1": {
              "name": "entity.name.type.rasm"
            },
            "2": {
              "name": "punctuation.separator.declaration.rasm"
            }
          }
        },
        {
          "comment": "A global, or a field in a struct body.",
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(:)(?=\\s*[^\\s;])",
          "captures": {
            "1": {
              "name": "variable.other.definition.rasm"
            },
            "2": {
              "name": "punctuation.separator.declaration.rasm"
            }
          }
        }
      ]
    },
    "instruction": {
